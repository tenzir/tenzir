include "data.fbs";
include "type.fbs";

namespace tenzir.fbs.aggregation;

table MinMaxSum {
  result: Data (required);
  type: [ubyte] (required, nested_flatbuffer: "tenzir.fbs.Type");
}

enum AnyAllState : short {
  None,
  Failed,
  Nulled,
}

table AnyAll {
  result: bool;
  state: AnyAllState;
}

enum MeanState : short {
  None,
  Failed,
  Duration,
  Numeric,
}

table Mean {
  result: double;
  count: ulong;
  state: MeanState;
}

enum StddevVarianceState : short {
  None,
  Failed,
  Duration,
  Numeric,
}

table StddevVariance {
  result: double;
  result_squared: double;
  count: ulong;
  state: StddevVarianceState;
}

enum MadState : short {
  None,
  Failed,
  Duration,
  Numeric,
}

table Mad {
  values: [Data] (required);
  state: MadState;
}

enum SkewnessState : short {
  None,
  Failed,
  Duration,
  Numeric,
}

table Skewness {
  count: ulong;
  mean: double;
  m2: double;
  m3: double;
  values: [double] (required);
  state: SkewnessState;
}

table FirstLast {
  result: Data (required);
}

table Once {
  done: bool;
  result: Data (required);
}

table CollectDistinct {
  result: [Data] (required);
}

table ValueCount {
  value: Data (required);
  count: long;
}

table ModeValueCountsEntropy {
  result: [ValueCount] (required);
}

table Count {
  result: long;
}

enum QuantileState : short {
  None,
  Failed,
  Duration,
  Numeric,
}

table Histogram {
  /// Per-bin counters for the configured regular bins.
  counts: [ulong] (required);
  /// Lower edge of the first regular bin.
  start: double;
  /// Width of every regular bin.
  width: double;
  underflow: ulong;
  overflow: ulong;
  null_count: ulong;
  non_finite_count: ulong;
  /// Number of accepted finite values, including underflow and overflow.
  count: ulong;
  /// Whether min and max carry values (count > 0).
  has_extrema: bool;
  min: double;
  max: double;
  input_count: ulong;
}

/// Persisted aggregation state for the first-class t-digest model.
table TDigest {
  means: [double] (required);
  weights: [double] (required);
  compression: uint;
  count: ulong;
  null_count: ulong;
  non_finite_count: ulong;
  has_extrema: bool;
  min: double;
  max: double;
  input_count: ulong;
}

/// Persisted aggregation state for the first-class HyperLogLog model.
table Hll {
  registers: [ubyte] (required);
  precision: ubyte;
  hash: string (required);
  count: ulong;
  null_count: ulong;
  input_count: ulong;
}

/// One exact categorical value count in a frequency-table model.
table FrequencyTableEntry {
  value: Data (required);
  count: ulong;
}

/// Persisted aggregation state for an exact frequency-table model.
table FrequencyTable {
  values: [FrequencyTableEntry] (required);
  input_count: ulong;
  count: ulong;
  null_count: ulong;
  failed: bool;
  key_type: [ubyte] (required, nested_flatbuffer: "tenzir.fbs.Type");
}

/// Persisted state for the generic model merge aggregation. The result is
/// absent before the first non-null model record.
table ModelMerge {
  failed: bool;
  result: Data;
}

table Quantile {
  state: QuantileState;
  means: [double] (required);
  weights: [double] (required);
  min: double;
  max: double;
}
