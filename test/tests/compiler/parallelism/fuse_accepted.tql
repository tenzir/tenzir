// parallelism: 1, fuse=all
// The `fuse=all` option runs the whole pipeline single-instance with
// run-to-completion channels: every operator fully processes an item before
// the upstream produces the next one. Results must be identical to normal
// execution, including for stateful operators like `summarize`.
from {x: 1, g: "a"}, {x: 2, g: "b"}, {x: 3, g: "a"}, {x: 4, g: "b"}
where x > 1
x = x * 10
summarize g, total=sum(x), n=count()
sort g
