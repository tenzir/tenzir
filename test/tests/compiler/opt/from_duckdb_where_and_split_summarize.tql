// The optimizer moves `src_ip == 203.0.113.7` before the assignment with the
// nondeterministic fallback, where the query takes it. The `summarize` stays
// in the pipeline, behind the remaining filter.
from_duckdb "events.duckdb", table="events"
ts = ts else now()
where src_ip == 203.0.113.7 and ts > 2024-01-01
summarize n=count()
