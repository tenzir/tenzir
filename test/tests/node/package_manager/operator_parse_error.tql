// A malformed sibling operator must fail startup with its original diagnostic.
shell r#"
set -eu
export TENZIR_RETENTION__METRICS=0s
export TENZIR_RETENTION__DIAGNOSTICS=0s
if eval "$TENZIR_NODE_BINARY" \
  '--bare-mode --endpoint=false --console-verbosity=error --console-format=%v' \
  '--state-directory="$TENZIR_TMP_DIR/state"' \
  '--cache-directory="$TENZIR_TMP_DIR/cache"' \
  '--package-dirs="$TENZIR_INPUTS/package-operator-parse-error"' \
  > /dev/null 2> "$TENZIR_TMP_DIR/node.log"; then
  cat "$TENZIR_TMP_DIR/node.log"
  echo "node started despite a malformed package operator" >&2
  exit 1
fi
# Skip the startup banner and preserve every line starting with the first error.
sed -n '/^error:/,$p' "$TENZIR_TMP_DIR/node.log"
"#
