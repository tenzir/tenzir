---
timeout: 60
---
// An upgraded runtime package can fail to build while healthy packages recover.
shell r#"
# Terminate the entire test process group before the runner's outer timeout.
exec timeout --kill-after=2s 45s sh -eu <<'RECOVERY_TEST'
export TENZIR_RETENTION__METRICS=0s
export TENZIR_RETENTION__DIAGNOSTICS=0s
node_pid=
cleanup() {
  cleanup_status=$?
  if [ "$cleanup_status" -ne 0 ] && [ -f "$TENZIR_TMP_DIR/node.log" ]; then
    cat "$TENZIR_TMP_DIR/node.log" >&2
  fi
  if [ -n "$node_pid" ]; then
    kill -TERM "$node_pid" 2>/dev/null || true
    wait "$node_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
mkfifo "$TENZIR_TMP_DIR/endpoint"
start_node() {
  eval "exec $TENZIR_NODE_BINARY" \
    '--bare-mode --endpoint=localhost:0 --print-endpoint --console-verbosity=error' \
    '--state-directory="$TENZIR_TMP_DIR/state"' \
    '--cache-directory="$TENZIR_TMP_DIR/cache"' \
    > "$TENZIR_TMP_DIR/endpoint" 2> "$TENZIR_TMP_DIR/node.log" &
  node_pid=$!
  if ! IFS= read -r endpoint < "$TENZIR_TMP_DIR/endpoint"; then
    return 1
  fi
}
stop_node() {
  kill -TERM "$node_pid"
  wait "$node_pid" || true
  node_pid=
}
run() {
  pipeline=$1
  eval "$TENZIR_BINARY" \
    '--bare-mode --console-verbosity=error --endpoint="$endpoint" --connection-timeout=10s --connection-retry-delay=10ms' \
    '"$pipeline"'
}
start_node
run 'from_file f"{env("TENZIR_INPUTS")}/package-operator-recovery/recover.yaml" { read_yaml } | package_add'
run 'from_file f"{env("TENZIR_INPUTS")}/package-operator-recovery/healthy.yaml" { read_yaml } | package_add'
run 'package_list format="legacy" | sort id | select id, install_status | to_stdout { write_ndjson }'
run 'pipeline_list | where package == "recover_test" | select id, unstoppable | to_stdout { write_ndjson }'
stop_node
# Simulate a language upgrade invalidating a previously installed operator.
cp "$TENZIR_INPUTS/package-operator-recovery/broken.yaml" \
  "$TENZIR_TMP_DIR/state/plugins/packages/runtime/recover_test/package.yaml"
start_node
run 'package_list format="legacy" | sort id | select id, install_status | to_stdout { write_ndjson }'
run 'pipeline_list | where package == "recover_test" | summarize pipelines=count() | to_stdout { write_ndjson }'
grep -F 'failed to parse operator `good` in package `recover_test`' "$TENZIR_TMP_DIR/node.log" > /dev/null
if grep -F 'module `recover_test` not found' "$TENZIR_TMP_DIR/node.log"; then
  exit 1
fi
run 'package_remove "recover_test"'
# Validate the healthy module on the node, including after removing the zombie.
run 'from {id: "probe_test", name: "Probe", pipelines: {run: {definition: "from {x: 1} | healthy_test::good | discard"}}} | package_add'
run 'package_remove "probe_test"'
run 'package_list format="legacy" | select id, install_status | to_stdout { write_ndjson }'
RECOVERY_TEST
"#
