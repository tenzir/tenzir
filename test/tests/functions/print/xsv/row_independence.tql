// A `null` nested record prints as a single `null` value, so the result for a
// row does not depend on the other rows in its batch.
// The optimizer moves the filter before the functions. The `_barrier` and
// `_batch_1` variants of this test must produce the same output.
from {id: 1, x: {a: 1, b: {c: 2, d: 3}}},
  {id: 2, x: {a: 4, b: null}},
  {id: 3, x: {a: 5}}
batch 100
optimize_barrier
select id,
  csv = x.print_csv(),
  tsv = x.print_tsv(),
  ssv = x.print_ssv(),
  xsv = x.print_xsv(field_separator=";", list_separator=",", null_value="null")
where id != 1
