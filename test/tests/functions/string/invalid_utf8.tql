// Blob conversion rejects invalid UTF-8 before character-oriented functions
// see it. The other rows remain unaffected.
from {b: b"x\x80y"}, {b: b"ok"}
x = string(b)
select bytes = x.length_bytes(),
  chars = x.length_chars(),
  alnum = x.is_alnum(),
  alpha = x.is_alpha(),
  lower = x.is_lower(),
  numeric = x.is_numeric(),
  printable = x.is_printable(),
  title = x.is_title(),
  upper = x.is_upper(),
  trim = x.trim().length_bytes(),
  trim_start = x.trim_start().length_bytes(),
  trim_end = x.trim_end().length_bytes(),
  trim_chars = x.trim("b").length_bytes(),
  reverse = x.reverse().length_bytes(),
  pad_start = x.pad_start(8).length_bytes(),
  pad_end = x.pad_end(8).length_bytes()
