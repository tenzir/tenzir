// Keys also accept plain values, which behave like a secret with the same bytes.
let $key = decode_hex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
from {x: "alice@example.com"}
roundtrip = decrypt_aes_gcm(encrypt_aes_gcm(x, key=$key), key=$key).string()
same_as_secret = encrypt_aes_siv(x, key=$key) == encrypt_aes_siv(x, key=secret("key-256").decode_hex())
