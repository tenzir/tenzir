// Ciphertexts from pyhpke for the X448, P-384, and P-521 suites.
let $x448_key = secret("x448-private-key")
let $p384_key = secret("p384-private-key")
let $p521_key = secret("p521-private-key")
from {}
x448 = decrypt_hpke(
  decode_hex("09b1373df39a4e2be262c9f8cfbd6b5fd1acd36149cb3fa2571d91a111edf35b9028566dda73925d08486a0cfc9d46baa0b8c89f16a80e88a6c007b230c99e6e4657eec11da03a675a01c74a7cc7"),
  private_key=$x448_key,
  aad="ctx",
).string()
p384 = decrypt_hpke(
  decode_hex("04d60a14072a1e79a03ada2433efbc9d46ed901d1110db7c64a452b2faf1cfb4ca7685edf3cc15fd030346c22b64335ed8444de1de3ee089c10b5263ee50ba0bf154b4e940e3faef96f8f0154535e2f8a17505040c9cd2028a123f4aef264b17f5190e5d8449302634bc69026893e9a86c46d33d1e808b"),
  private_key=$p384_key,
  aad="ctx",
).string()
p521 = decrypt_hpke(
  decode_hex(""),
  private_key=$p521_key,
  aad="ctx",
).string()
