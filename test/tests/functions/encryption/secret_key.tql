---
fixtures: [node]
---
// Keys come from the secret store, encoded as hex. Secrets themselves cannot be
// encrypted, because that would reveal them.
let $key = secret("key-256").decode_hex()
from {x: "alice@example.com"}
roundtrip = decrypt_aes_gcm(encrypt_aes_gcm(x, key=$key), key=$key).string()
same_as_constant = encrypt_aes_siv(x, key=$key) == encrypt_aes_siv(x, key=secret("key-256").decode_hex())
hpke = decrypt_hpke(decode_hex("8e17ed32defd75eeaf0482e1a9531e6b684b5352717552662703bf00e47d163fe658d8d3d2cf439403d669fbcc344175e3dbfa793267"), private_key=secret("x25519-private-key").decode_hex(), aad="tenant-a").string()
leak = encrypt_aes_gcm(secret("key-256"), key=$key)
