// The public key of HPKE needs no protection, so it may be a plain value or a
// secret.
let $private_key = secret("x25519-private-key").decode_hex()
from {}
plain = encrypt_hpke("a", public_key=decode_hex("2031818f562622db6a4ead4d2b801da571436439f568d7399f5d000de8b5920e")).decrypt_hpke(private_key=$private_key).string()
secret = encrypt_hpke("a", public_key=secret("x25519-public-key").decode_hex()).decrypt_hpke(private_key=$private_key).string()
