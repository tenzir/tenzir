from {kind: "int", xs: [9007199254740992, 9007199254740993,
                        9007199254740992, 9007199254740993]},
     {kind: "uint", xs: [18446744073709551614, 18446744073709551615,
                         18446744073709551614, 18446744073709551615]},
     {kind: "duration", xs: [nanoseconds(9007199254740992),
                             nanoseconds(9007199254740993),
                             nanoseconds(9007199254740992),
                             nanoseconds(9007199254740993)]}
select kind, ys = xs.periodogram()
