// Constraints can name nested fields, such as `device.os.version` for
// Operating System Patch State. Each of them satisfies the constraint alone.
let $event = {
  class_uid: 5004,
  category_uid: 5,
  activity_id: 1,
  type_uid: 500401,
  severity_id: 1,
  time: 2024-01-01T00:00:00Z,
  metadata: {version: "1.9.0", product: {name: "Inventory", vendor_name: "Example"}},
}
from {...$event, device: {type_id: 2, hostname: "ws-1", os: {name: "Windows", type_id: 100, sp_name: "SP1"}}},
     {...$event, device: {type_id: 2, hostname: "ws-1", os: {name: "Windows", type_id: 100, sp_ver: 1}}},
     {...$event, device: {type_id: 2, hostname: "ws-1", os: {name: "Windows", type_id: 100, version: "10.0"}}}
this = ocsf_cast(this)
