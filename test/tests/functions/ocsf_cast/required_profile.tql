// Fields that a profile or extension adds are only required when the event
// enables it. The first event enables no profile, so neither `cloud` nor
// `osint` is required. The second enables only `osint`. The third requires
// `reg_key`, which the `win` extension adds.
let $network = {
  class_uid: 4001,
  category_uid: 4,
  activity_id: 1,
  type_uid: 400101,
  severity_id: 1,
  time: 2024-01-01T00:00:00Z,
  src_endpoint: {ip: 192.0.2.1},
}
from {...$network, metadata: {version: "1.9.0", product: {name: "Zeek"}}},
{
  ...$network,
  metadata: {version: "1.9.0", product: {name: "Zeek"}, profiles: ["osint"]},
},
{
  class_uid: 201001,
  category_uid: 1,
  activity_id: 1,
  type_uid: 20100101,
  severity_id: 1,
  time: 2024-01-01T00:00:00Z,
  metadata: {
    version: "1.9.0",
    product: {name: "Sysmon"},
    extensions: [{name: "win", uid: "2", version: "1.9.0"}],
  },
  actor: {user: {name: "root"}},
  device: {type_id: 2, hostname: "ws-1"},
}
this = ocsf_cast(this)
