let $event = {
  class_uid: 4001,
  category_uid: 4,
  activity_id: 1,
  type_uid: 400101,
  severity_id: 1,
  time: 2026-01-01,
  metadata: {version: "1.5.0", product: {name: "Tenzir"}},
  dst_endpoint: {ip: 192.0.2.2},
}
from {events: [
  {...$event, unmapped: {}, activity_id: null},
  {...$event, unmapped: {nested: [1, "two"]}},
  {...$event, src_endpoint: {ip: 192.0.2.1}},
]}
cast = events.map(x => ocsf_cast(x))
encoded = events.map(x => ocsf_cast(x, encode_variants=true))
