// A cast drops fields whose profile the event does not enable, and ignores malformed profiles.
// `expected` evaluates the predicate as a value, which the optimizer never
// rewrites, so it must be `true` for every event that the filter keeps. The
// events carry their ID in `metadata.uid`, so that the cast drops at most one
// field, whose warning is then deterministic.
from {class_uid: 3002, metadata: {version: "1.5.0", uid: "1"}, api: {request: {data: 42}}},
     {class_uid: 3002, metadata: {version: "1.5.0", uid: "2", profiles: ["cloud"]}, api: {request: {data: 42}}},
     {class_uid: 3002, metadata: {version: "1.5.0", uid: "3", profiles: "cloud"}, api: {request: {data: 42}}},
     {class_uid: 3002, metadata: {version: "1.5.0", uid: "4", profiles: ["cloud", 1]}, api: {request: {data: 42}}}
this = {id: metadata.uid, r: ocsf_cast(this)}
expected = r.api.request.data == 42
where r.api.request.data == 42
select id, expected
