let $oversized_schema = {
  type: "array",
  items: {
    type: "record",
    name: "r",
    fields: [{name: "x".repeat(32768), type: "null"}],
  },
}
from {
  duplicate_raw: "0402610002610200",
  invalid_key_raw: "0202ff0000",
  invalid_value_raw: "0402610278026202ff00",
  invalid_boolean_raw: "02",
  invalid_int_overflow_raw: "8080808010",
  invalid_int_underflow_raw: "8180808010",
  overdeclared_block_raw: "01040000",
  oversized_record_array_raw: "b00900",
}
