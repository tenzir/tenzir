// Keys are strings, and each value keeps the type it had in the record.
from {
  x: {
    int: -1,
    uint: uint(2),
    float: 3.5,
    string: "four",
    bool: true,
    nothing: null,
    ip: 192.0.2.1,
    subnet: 10.0.0.0/8,
    time: 2026-01-01,
    duration: 1s,
    blob: b"abc",
    list: [1],
    record: {a: 1},
  },
}
select key_kinds=x.entries().map(e => type_of(e.key).kind),
  value_kinds=x.entries().map(e => type_of(e.value).kind)
