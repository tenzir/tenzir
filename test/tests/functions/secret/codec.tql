fixtures: [node]
---

// Encoding or decoding a secret produces a secret, not a printable value.
from {value: "The quick brown fox jumps over the lazy dog"}
encoded = encode_base64(secret("format-key"))
direct = hmac(value, "key")
decoded = hmac(value, secret("encoded-key").decode_base64())
roundtrip = hmac(value, secret("format-key").encode_hex().decode_hex())
