---
fixtures: [node]
---

// Concatenating with a secret on either side produces a secret. The digests
// show that the plaintext bytes are assembled correctly without printing them.
from {value: "The quick brown fox jumps over the lazy dog"}
direct = hmac(value, "key")
secrets = hmac(value, secret("concat-k") + secret("format-rest"))
string_secret = hmac(value, "k" + secret("format-rest"))
secret_string = hmac(value, secret("concat-ke") + "y")
blob_secret = hmac(value, b"k" + secret("format-rest"))
concatenated = secret("concat-k") + secret("format-rest")
strings = "a" + "b"
blobs = b"a" + b"b"
mixed = "a" + b"b"
