---
fixtures: [node]
---

// Constant field access and indexing pass the secrets of a `let` binding
// through unresolved, and format strings redact nested secrets.
let $cfg = {key: secret("format-key"), keys: [secret("concat-k"), secret("encoded-key").decode_base64()]}
let $key = $cfg.key
let $nested = f"{ {a: $cfg.key} }"
from {}
assert_secret secret=$key, expected="key"
assert_secret secret=$cfg["key"], expected="key"
assert_secret secret=$cfg.keys[0], expected="k"
assert_secret secret=$cfg.keys[-1], expected="key"
assert_secret secret=$nested, expected="{a:\"***\"}"
