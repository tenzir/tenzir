---
fixtures: [node]
---

// A `let` binding of a record or list resolves the secrets nested in it, so
// functions can read a key from it. Assigning the binding itself censors the
// secrets with a warning.
let $cfg = {key: secret("format-key"), nested: {keys: [secret("encoded-key").decode_base64()]}, plain: "x"}
from {value: "The quick brown fox jumps over the lazy dog"}
direct = hmac(value, secret("format-key"))
record = hmac(value, $cfg.key)
list = hmac(value, $cfg.nested.keys[0])
whole = $cfg
