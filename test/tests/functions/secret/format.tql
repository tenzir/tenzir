---
fixtures: [node]
---

// Format strings with a top-level secret replacement produce a secret. Nested
// secrets are stringified and therefore redacted. The digests show that the
// plaintext bytes are assembled correctly without ever printing them.
from {value: "The quick brown fox jumps over the lazy dog"}
formatted = f"pre-{secret("format-key")}-post"
nested = f"{ {a: secret("format-key")} }"
direct = hmac(value, "key")
whole = hmac(value, f"{secret("format-key")}")
prefixed = hmac(value, f"k{secret("format-rest")}")
