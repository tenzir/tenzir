---
fixtures: [node]
---

// A `let` binding that uses a secret still evaluates its other parts once, so
// every reference sees the same value.
let $t = {key: secret("format-key"), roll: random(), at: now()}
from {}, {}
first = $t.roll
second = $t.roll
at = $t.at
mac = hmac("The quick brown fox jumps over the lazy dog", $t.key)
summarize rolls=count_distinct(first), same=all(first == second), ats=count_distinct(at), macs=distinct(mac)
