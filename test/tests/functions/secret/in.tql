---
fixtures: [node]
---

// As with `==`, a comparison with a secret is `null`, since its value is
// unknown until the pipeline resolves it. So `in` is `null` for a secret on
// the left, and for a list with a secret unless another element matches.
from {}
left = secret("format-key") in [b"key"]
not_left = not (secret("format-key") in [b"key"])
equal = secret("format-key") == b"key"
right = b"key" in [secret("format-key")]
not_right = not (b"key" in [secret("format-key")])
other = 1 in [secret("format-key"), 1]
