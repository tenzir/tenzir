// A beacon checking in every 60 seconds with up to 2 seconds of jitter.
from {times: [2023-12-31T23:59:59, 2024-01-01T00:00:58, 2024-01-01T00:02:02, 2024-01-01T00:03:01, 2024-01-01T00:04:01, 2024-01-01T00:05:02, 2024-01-01T00:06:00, 2024-01-01T00:07:01, 2024-01-01T00:07:58, 2024-01-01T00:09:00, 2024-01-01T00:10:02, 2024-01-01T00:11:00, 2024-01-01T00:12:00, 2024-01-01T00:12:59, 2024-01-01T00:14:01, 2024-01-01T00:14:58, 2024-01-01T00:15:59, 2024-01-01T00:17:00, 2024-01-01T00:17:58, 2024-01-01T00:18:59]}
beat = times.dominant_period(resolution=5s)
select period = beat.period, strength = round(beat.strength * 100) / 100
