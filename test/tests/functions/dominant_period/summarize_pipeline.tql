// The beacon-detection idiom from TNZ-888: collect timestamps per tuple,
// recover the period, and filter on its strength.
from {t: 2024-01-01T00:00:00}, {t: 2024-01-01T00:00:30}, {t: 2024-01-01T00:01:00},
     {t: 2024-01-01T00:01:30}, {t: 2024-01-01T00:02:00}, {t: 2024-01-01T00:02:30},
     {t: 2024-01-01T00:03:00}, {t: 2024-01-01T00:03:30}, {t: 2024-01-01T00:04:00},
     {t: 2024-01-01T00:04:30}, {t: 2024-01-01T00:05:00}, {t: 2024-01-01T00:05:30}
summarize times=collect(t), samples=count()
beat = times.dominant_period(resolution=5s)
where samples >= 8 and beat.strength >= 0.8 and beat.period >= 10s
select beat = {period: beat.period, strength: round(beat.strength * 100) / 100}, samples
