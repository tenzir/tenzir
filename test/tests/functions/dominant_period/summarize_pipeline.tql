// The beacon-detection idiom from TNZ-888: recover the period from
// timestamps and filter on its strength.
from {times: [2024-01-01T00:00:00, 2024-01-01T00:00:30,
              2024-01-01T00:01:00, 2024-01-01T00:01:30,
              2024-01-01T00:02:00, 2024-01-01T00:02:30,
              2024-01-01T00:03:00, 2024-01-01T00:03:30,
              2024-01-01T00:04:00, 2024-01-01T00:04:30,
              2024-01-01T00:05:00, 2024-01-01T00:05:30],
      samples: 12}
beat = times.dominant_period(resolution=5s)
where samples >= 8 and beat.strength >= 0.8 and beat.period >= 10s
select beat = {period: beat.period, strength: round(beat.strength * 100) / 100}, samples
