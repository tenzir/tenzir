from {times: [1900-01-01T00:00:00,
              1916-06-06T00:00:00,
              1932-11-09T00:00:00,
              1949-04-14T00:00:00,
              1965-09-17T00:00:00,
              1982-02-20T00:00:00,
              1998-07-26T00:00:00,
              2014-12-29T00:00:00,
              2031-06-03T00:00:00,
              2047-11-06T00:00:00,
              2064-04-10T00:00:00,
              2080-09-13T00:00:00,
              2097-02-16T00:00:00,
              2113-07-23T00:00:00,
              2129-12-26T00:00:00,
              2146-05-31T00:00:00,
              2162-11-03T00:00:00,
              2179-04-08T00:00:00,
              2195-09-11T00:00:00]}
beat = times.dominant_period(resolution=60d)
select period = beat.period, strength = round(beat.strength * 100) / 100
