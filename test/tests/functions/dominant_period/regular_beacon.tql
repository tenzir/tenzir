// A beacon checking in every 30 seconds for 20 minutes.
from {times: [2024-01-01T00:00:00, 2024-01-01T00:00:30, 2024-01-01T00:01:00, 2024-01-01T00:01:30, 2024-01-01T00:02:00, 2024-01-01T00:02:30, 2024-01-01T00:03:00, 2024-01-01T00:03:30, 2024-01-01T00:04:00, 2024-01-01T00:04:30, 2024-01-01T00:05:00, 2024-01-01T00:05:30, 2024-01-01T00:06:00, 2024-01-01T00:06:30, 2024-01-01T00:07:00, 2024-01-01T00:07:30, 2024-01-01T00:08:00, 2024-01-01T00:08:30, 2024-01-01T00:09:00, 2024-01-01T00:09:30, 2024-01-01T00:10:00, 2024-01-01T00:10:30, 2024-01-01T00:11:00, 2024-01-01T00:11:30, 2024-01-01T00:12:00, 2024-01-01T00:12:30, 2024-01-01T00:13:00, 2024-01-01T00:13:30, 2024-01-01T00:14:00, 2024-01-01T00:14:30, 2024-01-01T00:15:00, 2024-01-01T00:15:30, 2024-01-01T00:16:00, 2024-01-01T00:16:30, 2024-01-01T00:17:00, 2024-01-01T00:17:30, 2024-01-01T00:18:00, 2024-01-01T00:18:30, 2024-01-01T00:19:00, 2024-01-01T00:19:30]}
beat = times.dominant_period(resolution=5s)
select period = beat.period, strength = round(beat.strength * 100) / 100
