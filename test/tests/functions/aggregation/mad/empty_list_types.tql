---
skip: "Nova has no typed nulls, so `type_kind` reports `null` for both results"
---

from {
  ints: [1].where(x => false),
  durations: [1s].where(x => false),
}
int_result = ints.mad()
duration_result = durations.mad()
int_result_type = type_kind(int_result)
duration_result_type = type_kind(duration_result)
drop ints, durations
