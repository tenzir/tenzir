// Model divergence aligns categorical counts by value before forwarding them
// to the shared Jensen-Shannon implementation.
from {}
p = frequency_table(["a", "a", "b"])
q = frequency_table(["b", "c", "c"])
select divergence = model_divergence(p, q, method="jensen_shannon"),
  empty = model_divergence(p, frequency_table([]), method="jensen_shannon")
