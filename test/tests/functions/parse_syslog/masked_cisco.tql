from {keep: true, x: "<34>1 - host app - - - first"},
     {keep: false, x: 42},
     {keep: true, x: "<166>Sep 01 2026 16:46:57: %ASA-6-302014: message"},
     {keep: false, x: "invalid"},
     {keep: true, x: "<45>message"},
     {keep: true, x: null},
     {keep: true, x: "<45>: HOSTNAME-123: Jan 14 05:25:06.737: %FW-6-SESS_AUDIT_TRAIL: message"},
     {keep: false, x: "<999>invalid"},
     {keep: true, x: "<34>1 - host app - - - last"}
where keep
select parsed = x.parse_syslog(accept_pri_only=true)
