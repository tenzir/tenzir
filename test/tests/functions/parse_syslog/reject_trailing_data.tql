// `parse_syslog` must consume the entire input. Previously a partial parse was
// accepted and any trailing bytes the parser did not reach were silently
// dropped. Reject it by default; accept it as PRI-only text only when enabled.
from {
  // Valid RFC 5424 message: the parser consumes the whole input.
  x: r#"<34>1 2003-10-11T22:14:15.003Z host app - - [sd@1 a="1"] valid message"#,
}, {
  // A quoted parameter followed by trailing bytes is rejected while parsing
  // the structured data, because the closing quote lacks a valid delimiter.
  x: r#"<34>1 2003-10-11T22:14:15.003Z host app - - [sd@1 a="1"]trailing"#,
}, {
  // An unquoted parameter reaches the partial-success path: the RFC parser
  // consumes the SD element but leaves "trailing" unconsumed.
  x: "<34>1 2003-10-11T22:14:15.003Z host app - - [sd@1 a=1]trailing",
}, {
  // A terminal line ending in an octet-framed message is accepted.
  x: "<34>1 2003-10-11T22:14:15.003Z host app - - [sd@1 a=\"1\"]\n",
}, {
  x: "<34>1 2003-10-11T22:14:15.003Z host app - - [sd@1 a=\"1\"]\r\n",
}, {
  // A line ending followed by content must not hide trailing bytes.
  x: "<34>1 2003-10-11T22:14:15.003Z host app - - [sd@1 a=\"1\"]\ntrailing",
}
strict = x.parse_syslog()
x = x.parse_syslog(accept_pri_only=true)
