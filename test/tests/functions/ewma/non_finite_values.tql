// NaN elements are missing observations, and a mean that collapses into NaN
// through opposing infinities restarts from the next observation. Non-finite
// doubles only enter through parsed data, and the JSON printer renders them
// as null: the leading `inf` outputs are ±inf and NaN, where pandas reports
// NaN throughout.
//
// Expected values were generated with pandas 3.0.5:
//   import numpy as np
//   import pandas as pd
//   nan = pd.Series([1.0, np.nan, 3.0])
//   nan.ewm(alpha=0.5).mean()  # [1.0, 1.0, 2.6]
//   nan.ewm(alpha=0.5).var()   # [nan, nan, 2.0]
//   inf = pd.Series([np.inf, -np.inf, 5.0, 6.0])
//   inf.ewm(alpha=0.5).mean()  # [nan, nan, 5.0, 5.6666...]
//   inf.ewm(alpha=0.5).var()   # [nan, nan, nan, 0.5]
from {raw: "{nan: [1.0, .nan, 3.0], inf: [.inf, -.inf, 5.0, 6.0]}"}
this = raw.parse_yaml()
select nan_mean = nan.ewma(alpha=0.5),
       nan_variance = nan.ewm_variance(alpha=0.5),
       inf_mean = inf.ewma(alpha=0.5),
       inf_variance = inf.ewm_variance(alpha=0.5)
