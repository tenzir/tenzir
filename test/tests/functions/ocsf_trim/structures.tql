let $event = {class_uid: 4001, metadata: {version: "1.5.0"}}
from {events: [
  {...$event, activity_id: null, src_endpoint: {ip: null, unknown: 1}},
  {...$event, src_endpoint: {ip: 192.0.2.1}},
  {...$event, src_endpoint: null, unmapped: {unknown: [null, {}]}},
]}
trimmed = events.map(x => ocsf_trim(x, drop_optional=false))
