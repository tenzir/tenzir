from {
  class_uid: 4001,
  metadata: {version: "1.5.0"},
  activity_id: null,
  message: "",
  enrichments: [],
  src_endpoint: {},
  unmapped: {custom: null, empty: []},
}
original = this
trimmed = ocsf_trim(original)
retained = ocsf_trim(original, drop_optional=false)
required = ocsf_trim(original, drop_optional=false, drop_recommended=true)
select original, trimmed, retained, required
