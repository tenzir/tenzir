from {
  number: -1,
  text: "hi",
  numbers: [2, 3],
  nested: {flag: true},
}
encoded = print_avro(this, schema={
  type: "record",
  name: "event",
  fields: [
    {name: "number", type: "long"},
    {name: "text", type: "string"},
    {name: "numbers", type: {type: "array", items: "long"}},
    {
      name: "nested",
      type: {
        type: "record",
        name: "nested",
        fields: [{name: "flag", type: "boolean"}],
      },
    },
  ],
})
decoded = encoded.parse_avro(schema={
  type: "record",
  name: "event",
  fields: [
    {name: "number", type: "long"},
    {name: "text", type: "string"},
    {name: "numbers", type: {type: "array", items: "long"}},
    {
      name: "nested",
      type: {
        type: "record",
        name: "nested",
        fields: [{name: "flag", type: "boolean"}],
      },
    },
  ],
})
encoded = encoded.encode_hex()
