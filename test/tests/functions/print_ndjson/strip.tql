from {
  x: {
    a: null,
    b: {},
    c: [],
    d: [null, 1, null],
    e: {f: null},
    g: [[], {}],
  },
}
y = {
  none: x.print_ndjson(),
  all: x.print_ndjson(strip=true),
  null_fields: x.print_ndjson(strip_null_fields=true),
  nulls_in_lists: x.print_ndjson(strip_nulls_in_lists=true),
  empty_records: x.print_ndjson(strip_empty_records=true),
  empty_lists: x.print_ndjson(strip_empty_lists=true),
}
drop x
