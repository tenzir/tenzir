// Without `else`, events whose condition is not `true` keep their fields.
from {id: 1, c: true, a: 42, y: 0},
     {id: 2, c: true, a: 0, y: 42},
     {id: 3, c: false, a: 0, y: 42},
     {id: 4, c: null, a: 42, y: 42},
     {id: 5, a: 42, y: 0},
     {id: 6, c: "true", a: 42, y: 42}
if c {
  y = a
}
where y == 42
this = {event: this, optimized: true}
// The same pipeline with the filter behind the operator, with its warnings
// suppressed to keep the output deterministic.
merge {
  quiet {
    from {id: 1, c: true, a: 42, y: 0},
         {id: 2, c: true, a: 0, y: 42},
         {id: 3, c: false, a: 0, y: 42},
         {id: 4, c: null, a: 42, y: 42},
         {id: 5, a: 42, y: 0},
         {id: 6, c: "true", a: 42, y: 42}
    if c {
      y = a
    }
    optimize_barrier
    where y == 42
    this = {event: this, optimized: false}
  }
}
summarize event, optimized=collect(optimized)
optimized = optimized.sort()
sort event.id
write_ndjson
