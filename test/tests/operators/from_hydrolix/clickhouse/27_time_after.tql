---
error: true
---

// The comparison runs in Hydrolix with ClickHouse's semantics: it reads the
// `DateTime64(3)` column at the nanosecond precision of the literal, which
// overflows for the rows beyond the instants that nanoseconds can represent.
// The read fails rather than falling back to Tenzir.
from_hydrolix f"http://{env("CLICKHOUSE_HOST")}",
              token="test-token",
              port=int(env("CLICKHOUSE_PORT")),
              table="default.fh_times"
where t > 2024-01-01
sort id
select id
