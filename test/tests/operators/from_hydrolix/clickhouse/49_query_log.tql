// The queries of the token user, with the settings that change what they
// compute, as far as they differ from ClickHouse's defaults: a read of a
// field below a `JSON` column keeps dotted keys apart, and a sort by one
// orders values of different types. `54_settings_query_log.tql` checks the
// settings that the session changes. The binding failure ran no query, and
// the rejected query did not run again. The time range of `12_time_range.tql`
// holds the current time, so the output shows it as `<since>`.
from_clickhouse sql="SELECT toString(type) AS type, replaceRegexpAll(query, 'fromUnixTimestamp64Nano[(]-[0-9]+, [^)]+[)]', '<since>') AS query, arraySort(arrayFilter(k -> k LIKE '%overflow_mode%' OR k IN ('aggregate_functions_null_for_empty', 'json_type_escape_dots_in_keys', 'allow_suspicious_types_in_order_by'), mapKeys(Settings))) AS settings FROM system.query_log WHERE type IN ('QueryFinish', 'ExceptionBeforeStart', 'ExceptionWhileProcessing') AND query_kind = 'Select' AND user = '__api_token__' AND (query LIKE '%fh_catch_all%' OR query LIKE '%fh_events%' OR query LIKE '%fh_tuples%') ORDER BY event_time_microseconds",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
