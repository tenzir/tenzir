// The token user ran the `where`, `select`, and `summarize` of the earlier
// tests in ClickHouse. The time range holds the current time, so the output
// shows it as `<since>`.
from_clickhouse sql="SELECT replaceRegexpAll(query, '> fromUnixTimestamp64Milli[(]-?[0-9]+[)]', '> <since>') AS query FROM system.query_log WHERE type = 'QueryFinish' AND query_kind = 'Select' AND user = '__api_token__' AND has(tables, 'default.fh_events') AND query LIKE '%WHERE%' ORDER BY event_time_microseconds",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
