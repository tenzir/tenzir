// With `pushdown=false`, the filter runs in Tenzir with TQL's semantics, where
// the rows beyond the range of nanoseconds have a `null` time.
from_hydrolix f"http://{env("CLICKHOUSE_HOST")}",
              token="test-token",
              port=int(env("CLICKHOUSE_PORT")),
              table="default.fh_times",
              pushdown=false
where t < 2000-01-01
sort id
select id
