// The `where` and the `summarize` go into the query, guards included.
from_hydrolix f"http://{env("CLICKHOUSE_HOST")}",
              token="test-token",
              port=int(env("CLICKHOUSE_PORT")),
              table="default.fh_times"
where t > 2000-01-01
summarize events=count(), lo=min(c), hi=max(t)
