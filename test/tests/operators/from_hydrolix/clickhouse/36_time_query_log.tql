// The guards of the pushed queries compare tick counts, which Hydrolix's time
// range analysis ignores, while the user's comparisons stay on the column.
from_clickhouse sql="SELECT query FROM system.query_log WHERE type = 'QueryFinish' AND query_kind = 'Select' AND user = '__api_token__' AND has(tables, 'default.fh_times') AND query LIKE '%WHERE%' ORDER BY event_time_microseconds",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
