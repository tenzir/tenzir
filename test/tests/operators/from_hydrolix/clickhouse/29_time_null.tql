// Hydrolix holds a value for every row, also for those that Tenzir decodes as
// `null`, so no row has a `null` time.
from_hydrolix f"http://{env("CLICKHOUSE_HOST")}",
              token="test-token",
              port=int(env("CLICKHOUSE_PORT")),
              table="default.fh_times"
where t == null
sort id
select id
