// A view that takes the server about ten seconds to sort.
from_clickhouse sql="CREATE OR REPLACE VIEW fh_slow DEFINER = default SQL SECURITY DEFINER AS SELECT number AS id, number + sleepEachRow(0.00001) AS stamp FROM numbers(1000000)",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
