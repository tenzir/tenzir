---
error: true
---
// Raises the error of a Hydrolix cluster that requires a time range.
from_hydrolix f"http://{env("CLICKHOUSE_HOST")}",
              token="test-token",
              port=int(env("CLICKHOUSE_PORT")),
              sql="SELECT throwIf(1, 'hdx_query_timerange_required is set to true. Your query needs a time range filter in a WHERE clause')"
