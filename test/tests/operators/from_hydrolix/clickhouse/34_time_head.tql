// A filter after a `head` keeps its semantics: it reads the events that the
// `head` keeps, so it cannot constrain the table.
from_hydrolix f"http://{env("CLICKHOUSE_HOST")}",
              token="test-token",
              port=int(env("CLICKHOUSE_PORT")),
              table="default.fh_events"
sort time
head 2
where time > 2026-01-01T00:00:01
