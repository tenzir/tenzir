---
assertions:
  fixtures:
    sentinelone:
      queries_cancelled: true
      expected_requests:
        - type: PQ
          query: "| group __tenzir_column_1 = count() by __tenzir_column_0 = dataSource.name | limit 1600000"
---
// Counts decode as integers also without type inference.
from_sentinelone_data_lake env("S1_FIXTURE_URL"),
  token=env("S1_FIXTURE_TOKEN"),
  start=2024-01-01, end=2024-01-02,
  account_ids=["aggregate"],
  raw=true
summarize source=dataSource.name, n=count()
