---
assertions:
  fixtures:
    sentinelone:
      queries_cancelled: true
      expected_requests:
        - type: PQ
          query: pushdown_capped
---
// A user's query without stages keeps SentinelOne's default cap of 1,000
// rows, which SentinelOne reports as a warning.
from_sentinelone_data_lake env("S1_FIXTURE_URL"),
  token=env("S1_FIXTURE_TOKEN"),
  start=2024-01-01, end=2024-01-02,
  query="pushdown_capped",
  pushdown=false
summarize n=count()
