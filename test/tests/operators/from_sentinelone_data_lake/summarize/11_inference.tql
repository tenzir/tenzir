// PowerQuery groups the text "true" apart from the boolean `true`, which
// type inference turns the text into. The operator aggregates locally.
from_sentinelone_data_lake env("S1_FIXTURE_URL"),
  token=env("S1_FIXTURE_TOKEN"),
  start=2024-01-01, end=2024-01-02,
  account_ids=["aggregate"]
summarize flag, n=count()
