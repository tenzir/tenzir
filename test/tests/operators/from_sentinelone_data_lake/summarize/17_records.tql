// SentinelOne has no flat `endpoint` field, so it groups every event as
// `null`, while in TQL, `endpoint.name` would make `endpoint` a record. This is
// SentinelOne's semantics, not TQL's.
from_sentinelone_data_lake env("S1_FIXTURE_URL"),
  token=env("S1_FIXTURE_TOKEN"),
  start=2024-01-01, end=2024-01-02,
  account_ids=["aggregate"]
summarize endpoint, n=count()
sort n
