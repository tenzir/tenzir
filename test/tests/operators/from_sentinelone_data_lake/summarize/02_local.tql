// A predicate that stays local keeps all events, but makes the operator
// aggregate locally, with the result of `01_pushed.tql`.
from_sentinelone_data_lake env("S1_FIXTURE_URL"),
  token=env("S1_FIXTURE_TOKEN"),
  start=2024-01-01, end=2024-01-02,
  account_ids=["aggregate"]
where event.type.length_bytes() > 0
summarize event.type, n=count()
sort event.type
