// SentinelOne computes the summary behind a rename and a `drop`: the query
// groups by `event.type`, and the output keeps the new name. The result equals
// that of `27_transforms_local.tql`, which runs the same operators locally.
from_sentinelone_data_lake env("S1_FIXTURE_URL"),
  token=env("S1_FIXTURE_TOKEN"),
  start=2024-01-01, end=2024-01-02,
  account_ids=["aggregate"]
select kind=event.type, source=dataSource.name
drop source
summarize kind, n=count()
sort kind
