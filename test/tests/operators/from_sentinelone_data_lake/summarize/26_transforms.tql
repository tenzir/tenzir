// SentinelOne computes the summary behind a rename: the query groups by the
// alias of `event.type`, and the output keeps the new name. The result equals
// that of `27_transforms_local.tql`, which runs the same operators in Tenzir.
from_sentinelone_data_lake env("S1_FIXTURE_URL"),
  token=env("S1_FIXTURE_TOKEN"),
  start=2024-01-01, end=2024-01-02,
  account_ids=["aggregate"]
select kind=event.type, source=dataSource.name
summarize kind, n=count()
sort kind
