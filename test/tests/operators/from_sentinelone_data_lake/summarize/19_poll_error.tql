// Every poll of the aggregate query fails. Once its retries are exhausted,
// the operator cancels the query and aggregates locally, with the result of
// `01_pushed.tql`.
from_sentinelone_data_lake env("S1_FIXTURE_URL"),
  token=env("S1_FIXTURE_TOKEN"),
  start=2024-01-01, end=2024-01-02,
  account_ids=["aggregate_poll_error"]
summarize event.type, n=count()
sort event.type
