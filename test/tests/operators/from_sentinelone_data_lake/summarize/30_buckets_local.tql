// With `pushdown=false`, Tenzir buckets the events of `29_buckets.tql`.
from_sentinelone_data_lake env("S1_FIXTURE_URL"),
  token=env("S1_FIXTURE_TOKEN"),
  start=2024-01-01, end=2024-01-02,
  account_ids=["aggregate"],
  pushdown=false
bucket = floor(timestamp, 2s)
summarize bucket, n=count()
sort bucket
