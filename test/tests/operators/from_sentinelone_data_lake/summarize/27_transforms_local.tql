// A predicate that stays in Tenzir keeps the operators after it in Tenzir,
// with the result of `26_transforms.tql`.
from_sentinelone_data_lake env("S1_FIXTURE_URL"),
  token=env("S1_FIXTURE_TOKEN"),
  start=2024-01-01, end=2024-01-02,
  account_ids=["aggregate"]
where event.type.length_bytes() > 0
select kind=event.type, source=dataSource.name
summarize kind, n=count()
sort kind
