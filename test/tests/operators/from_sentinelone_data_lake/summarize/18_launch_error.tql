---
error: true
---
// The launch of the aggregate query creates a query but reports a 5xx, so
// the operator cannot cancel it. It fails like a read instead of launching
// another query.
from_sentinelone_data_lake env("S1_FIXTURE_URL"),
  token=env("S1_FIXTURE_TOKEN"),
  start=2024-01-01, end=2024-01-02,
  account_ids=["aggregate_launch_error"]
summarize event.type, n=count()
