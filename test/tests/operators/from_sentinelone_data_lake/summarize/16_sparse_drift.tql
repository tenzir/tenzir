// The events without `event.type` do not add up to the `null` group, as if
// the data changed between the queries. The operator aggregates locally.
from_sentinelone_data_lake env("S1_FIXTURE_URL"),
  token=env("S1_FIXTURE_TOKEN"),
  start=2024-01-01, end=2024-01-02,
  account_ids=["aggregate_sparse_drift"]
summarize event.type, n=count()
sort event.type
