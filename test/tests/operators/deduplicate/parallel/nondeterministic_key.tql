// parallelism: 6
// Regression test: routing evaluates the partition key upstream, independently
// from the operator's own evaluation. A non-deterministic key must therefore
// keep the keyed operator single-instance, or rows with equal actual keys would
// be routed to different instances and survive deduplication.
from {x: 1}
repeat 5000
deduplicate int(random() * 10)
summarize n = count()
