// parallelism: 6
// Non-deterministic partition keys are not supported. Routing evaluates the key
// expression upstream, independently from the operator's own evaluation, so the
// two disagree and each of the four instances deduplicates its own key space:
// the result is one group per key per instance rather than one per key.
from {x: 1}
repeat 5000
deduplicate int(random() * 10)
summarize n = count()
