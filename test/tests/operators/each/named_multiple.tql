from {case_id: "C-1", ip: "10.0.0.5"},
     {case_id: "C-2", ip: "10.0.0.7"}
each $id=case_id, $ip=ip, parallel=1 {
  from {ts: 2024-01-01T10:00:00Z, src_ip: "10.0.0.5", action: "login"},
       {ts: 2024-01-01T10:02:00Z, src_ip: "10.0.0.8", action: "scan"},
       {ts: 2024-01-01T10:05:00Z, src_ip: "10.0.0.7", action: "download"}
  where src_ip == $ip
  case_id = $id
}
