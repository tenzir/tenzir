---
fixtures:
  - microsoft_graph:
      directory_audits: 7
      token_lifetime: 3600
assertions:
  fixtures:
    microsoft_graph:
      requests:
        - /v1.0/auditLogs/directoryAudits?$filter=startswith(initiatedBy/user/userPrincipalName,+'ADMIN')
        - /v1.0/auditLogs/directoryAudits?$filter=startswith%28initiatedBy%2Fuser%2FuserPrincipalName,%20%27ADMIN%27%29&$skiptoken=offset-3
timeout: 60
skip:
  on: fixture-unavailable
---

// The reference documents no maximum page size for directory audits, so the
// limit sends no `$top`: the operator counts the entries across pages,
// follows the opaque `$skiptoken`, and stops paging after the fourth.
from_microsoft_graph "auditLogs/directoryAudits",
  auth={
    tenant_id: env("MS_GRAPH_FIXTURE_TENANT_ID"),
    client_id: env("MS_GRAPH_FIXTURE_CLIENT_ID"),
    client_secret: env("MS_GRAPH_FIXTURE_CLIENT_SECRET"),
    authority: env("MS_GRAPH_FIXTURE_AUTHORITY"),
  },
  _base_url=env("MS_GRAPH_FIXTURE_BASE_URL_V1"),
  tls=false
where initiatedBy.user.userPrincipalName.starts_with("ADMIN")
head 4
select id
