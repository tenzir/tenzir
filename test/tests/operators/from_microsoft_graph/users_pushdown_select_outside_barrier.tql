---
fixtures:
  - microsoft_graph:
      users: 12
      token_lifetime: 3600
assertions:
  fixtures:
    microsoft_graph:
      request_prefix:
        - /v1.0/users
      max_requests: 4
      min_served_values: 33
timeout: 60
skip:
  on: fixture-unavailable
---

// `department` is not a default property: `$select` would return it, but
// the default response omits it. The projection stays local.
// With the optimization barrier; both share one baseline.
from_microsoft_graph "users",
  auth={
    tenant_id: env("MS_GRAPH_FIXTURE_TENANT_ID"),
    client_id: env("MS_GRAPH_FIXTURE_CLIENT_ID"),
    client_secret: env("MS_GRAPH_FIXTURE_CLIENT_SECRET"),
    authority: env("MS_GRAPH_FIXTURE_AUTHORITY"),
  },
  _base_url=env("MS_GRAPH_FIXTURE_BASE_URL_V1"),
  tls=false
optimize_barrier
head 2
select id, department?
