---
fixtures:
  - microsoft_graph:
      users: 12
      token_lifetime: 3600
assertions:
  fixtures:
    microsoft_graph:
      requests:
        - /v1.0/users
        - /v1.0/users?$skiptoken=offset-3
        - /v1.0/users?$skiptoken=offset-6
        - /v1.0/users?$skiptoken=offset-9
      served_values: 132
timeout: 60
skip:
  on: fixture-unavailable
---

// `$select` covers the projection and the filtered default properties;
// every `@odata.nextLink` keeps it.
// With the optimization barrier; both share one baseline.
from_microsoft_graph "users",
  auth={
    tenant_id: env("MS_GRAPH_FIXTURE_TENANT_ID"),
    client_id: env("MS_GRAPH_FIXTURE_CLIENT_ID"),
    client_secret: env("MS_GRAPH_FIXTURE_CLIENT_SECRET"),
    authority: env("MS_GRAPH_FIXTURE_AUTHORITY"),
  },
  _base_url=env("MS_GRAPH_FIXTURE_BASE_URL_V1"),
  tls=false
optimize_barrier
where jobTitle == "Engineer"
select displayName
