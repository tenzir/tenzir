---
fixtures:
  - microsoft_graph:
      users: 12
      token_lifetime: 3600
assertions:
  fixtures:
    microsoft_graph:
      requests:
        - /v1.0/users?$filter=(jobTitle+eq+'Engineer')&$select=displayName
        - /v1.0/users?$filter=%28jobTitle%20eq%20%27Engineer%27%29&$select=displayName&$skiptoken=offset-3
      served_values: 4
timeout: 60
skip:
  on: fixture-unavailable
---

// The filter becomes `$filter` and the selection `$select`; every
// `@odata.nextLink` keeps both.
// Without `pushdown=false`; both share one baseline.
from_microsoft_graph "users",
  auth={
    tenant_id: env("MS_GRAPH_FIXTURE_TENANT_ID"),
    client_id: env("MS_GRAPH_FIXTURE_CLIENT_ID"),
    client_secret: env("MS_GRAPH_FIXTURE_CLIENT_SECRET"),
    authority: env("MS_GRAPH_FIXTURE_AUTHORITY"),
  },
  _base_url=env("MS_GRAPH_FIXTURE_BASE_URL_V1"),
  tls=false
where jobTitle == "Engineer"
select displayName
