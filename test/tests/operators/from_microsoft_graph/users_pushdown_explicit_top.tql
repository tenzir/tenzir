---
fixtures:
  - microsoft_graph:
      users: 12
      token_lifetime: 3600
assertions:
  fixtures:
    microsoft_graph:
      requests:
        - /v1.0/users?$top=2&$select=id
        - /v1.0/users?$top=2&$select=id&$skiptoken=offset-2
        - /v1.0/users?$top=2&$select=id&$skiptoken=offset-4
      served_values: 6
timeout: 60
skip:
  on: fixture-unavailable
---

// Explicit $top=2 is a page size, not a global result cap. Preserve it
// and follow next links until the fifth matching row, then stop.
from_microsoft_graph "users",
  auth={
    tenant_id: env("MS_GRAPH_FIXTURE_TENANT_ID"),
    client_id: env("MS_GRAPH_FIXTURE_CLIENT_ID"),
    client_secret: env("MS_GRAPH_FIXTURE_CLIENT_SECRET"),
    authority: env("MS_GRAPH_FIXTURE_AUTHORITY"),
  },
  _base_url=env("MS_GRAPH_FIXTURE_BASE_URL_V1"),
  odata={top: 2},
  tls=false
head 5
select id
