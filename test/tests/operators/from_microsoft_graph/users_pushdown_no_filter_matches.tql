---
fixtures:
  - microsoft_graph:
      users: 12
      token_lifetime: 3600
assertions:
  fixtures:
    microsoft_graph:
      requests:
        - /v1.0/users?$filter=(displayName+eq+'missing')&$select=id
      served_values: 0
timeout: 60
skip:
  on: fixture-unavailable
---

// A filter that matches no user returns an empty collection, also with a
// selection.
from_microsoft_graph "users",
  auth={
    tenant_id: env("MS_GRAPH_FIXTURE_TENANT_ID"),
    client_id: env("MS_GRAPH_FIXTURE_CLIENT_ID"),
    client_secret: env("MS_GRAPH_FIXTURE_CLIENT_SECRET"),
    authority: env("MS_GRAPH_FIXTURE_AUTHORITY"),
  },
  _base_url=env("MS_GRAPH_FIXTURE_BASE_URL_V1"),
  tls=false
where displayName == "missing"
select id
