---
fixtures: [microsoft_graph]
assertions:
  fixtures:
    microsoft_graph:
      request_prefix:
        - /v1.0/users/empty-delta/delta
        - /v1.0/users/empty-delta/delta?step=empty
        - /v1.0/users/empty-delta/delta?step=changed
timeout: 60
skip:
  on: fixture-unavailable
---

from_microsoft_graph "users/empty-delta",
  auth={
    tenant_id: env("MS_GRAPH_FIXTURE_TENANT_ID"),
    client_id: env("MS_GRAPH_FIXTURE_CLIENT_ID"),
    client_secret: env("MS_GRAPH_FIXTURE_CLIENT_SECRET"),
    authority: env("MS_GRAPH_FIXTURE_AUTHORITY"),
  },
  _base_url=env("MS_GRAPH_FIXTURE_BASE_URL_V1"),
  delta=true,
  poll_interval=10ms,
  tls=false
head 1
