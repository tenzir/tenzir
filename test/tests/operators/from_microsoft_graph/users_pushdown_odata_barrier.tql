---
fixtures:
  - microsoft_graph:
      users: 12
      token_lifetime: 3600
assertions:
  fixtures:
    microsoft_graph:
      request_prefix:
        - /v1.0/users?$filter=accountEnabled+eq+true&$select=id,department,displayName&$top=5
      max_requests: 2
timeout: 60
skip:
  on: fixture-unavailable
---

// The user's `odata` options stay verbatim and suppress `$select` and
// `$top`, even where the projection needs fewer properties; the `where` adds
// no `$filter`.
// With the optimization barrier; both share one baseline.
from_microsoft_graph "users",
  auth={
    tenant_id: env("MS_GRAPH_FIXTURE_TENANT_ID"),
    client_id: env("MS_GRAPH_FIXTURE_CLIENT_ID"),
    client_secret: env("MS_GRAPH_FIXTURE_CLIENT_SECRET"),
    authority: env("MS_GRAPH_FIXTURE_AUTHORITY"),
  },
  _base_url=env("MS_GRAPH_FIXTURE_BASE_URL_V1"),
  odata={
    filter: "accountEnabled eq true",
    select: ["id", "department", "displayName"],
    top: 5,
  },
  tls=false
optimize_barrier
where department == "Security"
head 2
select id
