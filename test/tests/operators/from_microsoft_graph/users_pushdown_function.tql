---
fixtures:
  - microsoft_graph:
      users: 12
      token_lifetime: 3600
assertions:
  fixtures:
    microsoft_graph:
      requests:
        - /v1.0/users?$filter=startswith(displayName,+'User+')+and+(jobTitle+eq+'Engineer')&$top=2
      served_values: 22
timeout: 60
skip:
  on: fixture-unavailable
---

// `starts_with` and `==` on documented properties become `$filter`, and
// the limit `$top`; the selection after the limit stays in Tenzir.
from_microsoft_graph "users",
  auth={
    tenant_id: env("MS_GRAPH_FIXTURE_TENANT_ID"),
    client_id: env("MS_GRAPH_FIXTURE_CLIENT_ID"),
    client_secret: env("MS_GRAPH_FIXTURE_CLIENT_SECRET"),
    authority: env("MS_GRAPH_FIXTURE_AUTHORITY"),
  },
  _base_url=env("MS_GRAPH_FIXTURE_BASE_URL_V1"),
  tls=false
where displayName.starts_with("User ")
where jobTitle == "Engineer"
head 2
select label=displayName
