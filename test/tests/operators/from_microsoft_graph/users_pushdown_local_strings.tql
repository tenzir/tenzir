---
fixtures:
  - microsoft_graph:
      users: 12
      token_lifetime: 3600
      display_names:
        - "O'Brien & Co+/?#"
        - alice
        - null
        - Å
        - Å
        - 東京
        - Straße
        - STRASSE
assertions:
  fixtures:
    microsoft_graph:
      requests:
        - /v1.0/users?$filter=displayName+in+('O''Brien+%26+Co%2B/?%23',+'ALICE',+'%C3%85',+'%E6%9D%B1%E4%BA%AC',+'Stra%C3%9Fe')&$top=3
timeout: 60
skip:
  on: fixture-unavailable
---

// Quotes, punctuation, and Unicode reach `$filter` intact, and Graph
// compares the strings without regard to case, so `ALICE` matches `alice`.
// The limit counts the users that Graph returns.
from_microsoft_graph "users",
  auth={
    tenant_id: env("MS_GRAPH_FIXTURE_TENANT_ID"),
    client_id: env("MS_GRAPH_FIXTURE_CLIENT_ID"),
    client_secret: env("MS_GRAPH_FIXTURE_CLIENT_SECRET"),
    authority: env("MS_GRAPH_FIXTURE_AUTHORITY"),
  },
  _base_url=env("MS_GRAPH_FIXTURE_BASE_URL_V1"),
  tls=false
where displayName in ["O'Brien & Co+/?#", "ALICE", "Å", "東京", "Straße"]
head 3
select id
