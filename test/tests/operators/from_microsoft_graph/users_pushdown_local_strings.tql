---
fixtures:
  - microsoft_graph:
      users: 12
      token_lifetime: 3600
      display_names:
        - "O'Brien & Co+/?#"
        - alice
        - null
        - Å
        - Å
        - 東京
        - Straße
        - STRASSE
assertions:
  fixtures:
    microsoft_graph:
      requests:
        - /v1.0/users?$select=id,displayName
        - /v1.0/users?$select=id,displayName&$skiptoken=offset-3
      served_values: 12
timeout: 60
skip:
  on: fixture-unavailable
---

// String, Unicode, case, punctuation, and null predicates stay local.
// Both predicates run before counting matches and dropping displayName.
from_microsoft_graph "users",
  auth={
    tenant_id: env("MS_GRAPH_FIXTURE_TENANT_ID"),
    client_id: env("MS_GRAPH_FIXTURE_CLIENT_ID"),
    client_secret: env("MS_GRAPH_FIXTURE_CLIENT_SECRET"),
    authority: env("MS_GRAPH_FIXTURE_AUTHORITY"),
  },
  _base_url=env("MS_GRAPH_FIXTURE_BASE_URL_V1"),
  tls=false
where displayName != null
where displayName in ["O'Brien & Co+/?#", "alice", "Å", "東京", "Straße"]
head 3
select id
