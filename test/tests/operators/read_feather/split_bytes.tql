// Feed a Zstandard-compressed Feather stream to the reader one byte at a time.
// The writer runs in the same pipeline, so the reader never sees a record batch
// boundary that lines up with a chunk boundary.
from_file f"{env("TENZIR_INPUTS")}/zeek/conn.log.gz" {
  decompress_gzip
  read_zeek_tsv
}
batch 256
write_feather compression_level=10, compression_type="zstd"
split_bytes 1
read_feather
summarize total=count(), service
sort service
