from {id: 1, ts: 2026-01-01T10:00:10Z},
     {id: 2, ts: 2026-01-01T10:00:10Z}
join id, within=10s, on=ts, pick="earliest", into=r {
  from {id: 1, tag: "first",  ts: 2026-01-01T10:00:05Z},
       {id: 1, tag: "second", ts: 2026-01-01T10:00:05Z},
       {id: 1, tag: "later",  ts: 2026-01-01T10:00:12Z},
       {id: 2, tag: "only",   ts: 2026-01-01T10:00:15Z}
}
sort id
