// Backward as-of join with same-timestamp later-arrival tie-breaking.
from {ip: "10.0.0.1", ts: 2026-01-01T10:30:00Z},
     {ip: "10.0.0.2", ts: 2026-01-01T10:35:00Z},
     {ip: "10.0.0.1", ts: 2026-01-01T12:00:00Z}
join ip, kind="left", before=1h, on=ts, pick="latest", into=lease {
  from {ip: "10.0.0.1", host: "alice",  ts: 2026-01-01T09:45:00Z},
       {ip: "10.0.0.1", host: "bob1",   ts: 2026-01-01T10:15:00Z},
       {ip: "10.0.0.1", host: "bob2",   ts: 2026-01-01T10:15:00Z},
       {ip: "10.0.0.1", host: "future", ts: 2026-01-01T10:45:00Z}
}
sort ts, ip
