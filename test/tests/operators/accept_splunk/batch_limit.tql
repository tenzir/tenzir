---
fixtures:
  - http_request_chunked:
      requests:
        - path: /services/collector/event
          body_chunks_base64:
            - H4sIAAAAAAAC/+3IsQ3AIAw=
            - 
          headers:
            Authorization: Splunk test-token
            Content-Encoding: gzip
          expected_status: 200
          stop_on_connection_drop: true
timeout: 30
---

// The chunked gzip body contains 8193 identical HEC envelopes.
accept_splunk env("HTTP_REQUEST_ENDPOINT"),
  hec_token="test-token"
head 8193
measure
summarize events=sum(events), batches=count(), max_batch=max(events)
this = {events: events, batches: batches, bounded: max_batch <= 8192}
