---
fixtures:
  - zmq:
      role: subscriber
      mode: bind
assertions:
  fixtures:
    zmq:
      received_contains: |-
        {
          "line": "hello-from-to_zmq-plain"
        }
timeout: 60
---

// Retry until delivery: monitor=true alone does not ensure SUB registration.
every 10ms {
  from {
    line: "hello-from-to_zmq-plain",
  }
  fork {
    to_zmq env("ZMQ_ENDPOINT"), encoding="json", monitor=true
  }
  where false
}
merge {
  every 10ms {
    from_file env("ZMQ_FILE") { read_all }
  }
  where data.search("{\n  \"line\": \"hello-from-to_zmq-plain\"\n}")
}
head 1
discard
