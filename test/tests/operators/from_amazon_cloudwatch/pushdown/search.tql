---
fixtures: [cloudwatch_fake]
assertions:
  fixtures:
    cloudwatch_fake:
      requests:
        - operation: FilterLogEvents
          logGroupName: /tenzir/app
          filterPattern: '"ERROR" -"timeout"'
          startTime: 1700000001000
          endTime: 1700000005999
          logStreamNames: [app-1, app-2]
          limit: 2
---

// A filter pattern, a time window, the log streams, and the limit spell the
// stages. CloudWatch matches words and phrases case-sensitively.
from_amazon_cloudwatch "/tenzir/app",
  mode="search",
  aws_iam={
    access_key_id: "test",
    secret_access_key: "test",
    region: "us-east-1",
  }
where "ERROR" in message and not ("timeout" in message)
where timestamp >= 2023-11-14T22:13:21Z and timestamp < 2023-11-14T22:13:26Z
where log_stream in ["app-1", "app-2"]
head 2
select log_stream, message
