// A `null` for the non-nullable `n` column means its default, just like an
// event without the field. This holds for typed and untyped nulls.
from {id: 5, n: string(null)}, {id: 6, n: null}, {id: 7, n: "y"}
to_clickhouse table="test_supported_default",
              host=env("CLICKHOUSE_HOST"),
              port=int(env("CLICKHOUSE_PORT")),
              password=env("CLICKHOUSE_PASSWORD"),
              tls=false,
              mode="append"
