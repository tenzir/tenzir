// `json` has no effect when appending, which is the default mode.
from {id: 20001, name: "dave", score: 60.0, active: false}
to_clickhouse table="test_basic",
              host=env("CLICKHOUSE_HOST"),
              port=int(env("CLICKHOUSE_PORT")),
              password=env("CLICKHOUSE_PASSWORD"),
              tls=false,
              json=name
