// Sends the inserted blocks uncompressed.
from {id: 1, message: "the quick brown fox jumps over the lazy dog"}
repeat 1000
to_clickhouse table="tc_uncompressed",
              host=env("CLICKHOUSE_HOST"),
              port=int(env("CLICKHOUSE_PORT")),
              password=env("CLICKHOUSE_PASSWORD"),
              tls=false,
              compress=false
