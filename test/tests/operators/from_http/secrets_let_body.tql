---
fixtures:
- node
- http_server:
    expected:
    - header_name: Content-Type
      header_value: application/x-www-form-urlencoded
timeout: 60
---

// A `let` binding of a body resolves its nested secrets before encoding.
let $body = {client_id: "hello", nested: {client_secret: secret("http-body-secret")}}

from_http env("HTTP_FIXTURE_BODY_URL"),
          method="post",
          body=$body,
          encode="form",
          tls=false {
  read_json
}
