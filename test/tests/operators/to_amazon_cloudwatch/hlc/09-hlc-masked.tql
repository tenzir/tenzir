---
assertions:
  fixtures:
    cloudwatch:
      hlc:
        ok_request_count: 5
        messages:
          - pre-epoch
          - hlc-split-1
          - hlc-split-2
          - hlc-split-3
          - hlc-masked-1
          - hlc-masked-2
---

// Rows removed by `where` must neither be sent nor produce diagnostics.
from {keep: true, message: "hlc-masked-1", timestamp: from_epoch(1s)},
     {keep: false, message: 42, timestamp: "invalid"},
     {keep: true, message: b"hlc-masked-2", timestamp: from_epoch(2s)}
where keep
to_amazon_cloudwatch "ignored",
  stream="ignored",
  method="hlc",
  payload=message,
  timestamp=timestamp,
  token=secret("tenzir-test-token", _literal=true),
  endpoint=env("CLOUDWATCH_HLC_ENDPOINT")
