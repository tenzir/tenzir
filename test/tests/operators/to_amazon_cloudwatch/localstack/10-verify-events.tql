from_amazon_cloudwatch env("LOCALSTACK_CLOUDWATCH_LOG_GROUP"),
  mode="search",
  stream=[env("LOCALSTACK_CLOUDWATCH_LOG_STREAM_WRITE")],
  aws_iam={
    access_key_id: "test",
    secret_access_key: "test",
    region: "us-east-1",
  }
select log_stream_ok = log_stream == env("LOCALSTACK_CLOUDWATCH_LOG_STREAM_WRITE"),
  message
sort message
