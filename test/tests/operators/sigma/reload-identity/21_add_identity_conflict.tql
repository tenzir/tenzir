// A valid new duplicate must lose to the retained artifact in the other source.
from {yaml: r#"title: Conflicting new rule
id: 11111111-1111-4111-8111-1111111117b3
detection:
  selection: {foo: alpha}
  condition: selection
"#}
to_file env("FILE_ROOT") + "/sigma-identity-conflict.yaml.next" {
  write_all yaml
}
