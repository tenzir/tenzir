// Reserve a third source for a later cross-source identity conflict.
from {yaml: r#"title: Nonmatching placeholder
id: 11111111-1111-4111-8111-1111111117b6
detection:
  selection: {foo: omega}
  condition: selection
"#}
to_file env("FILE_ROOT") + "/sigma-identity-conflict.yaml" {
  write_all yaml
}
