// Reintroduce the former ID in another source; no stale copy may remain.
from {yaml: r#"title: Barrier 2
id: 11111111-1111-4111-8111-1111111117b5
detection:
  selection: {marker: true}
  condition: selection
---
title: Recovered
id: 11111111-1111-4111-8111-1111111117b3
detection:
  selection: {foo: alpha}
  condition: selection
"#}
to_file env("FILE_ROOT") + "/sigma-identity-other.yaml.next" {
  write_all yaml
}
