// A filter over a field the event lacks must not suppress the match:
// Sigma is two-valued, so `not filter` holds when the filter's field is
// absent. Both direct and OCSF matching exercise the same lowering.
from {
  id: "direct",
  Image: r"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe",
  ParentImage: r"C:\Windows\System32\wscript.exe",
}
sigma rules=r#"
title: Missing filter field
logsource:
  category: process_creation
  product: windows
detection:
  selection:
    ParentImage|endswith: '\wscript.exe'
    Image|endswith: '\powershell.exe'
  filter_health_service:
    CurrentDirectory|contains: '\Health Service State\'
  filter_neq:
    User|neq: 'CORP\jdoe'
  condition: selection and not 1 of filter_*
"#, format="plain"
select id=event.id

merge {
from {
  id: "ocsf",
  class_uid: 1007,
  activity_id: 1,
  metadata: {version: "1.9.0"},
  process: {
    path: r"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe",
    parent_process: {path: r"C:\Windows\System32\wscript.exe"},
  },
}
sigma rules=r#"
title: Missing filter field
logsource:
  category: process_creation
  product: windows
detection:
  selection:
    ParentImage|endswith: '\wscript.exe'
    Image|endswith: '\powershell.exe'
  filter_health_service:
    CurrentDirectory|contains: '\Health Service State\'
  condition: selection and not filter_health_service
"#, format="plain"
select id=event.id
}
sort id
