// Make the id-less target invalid and update the sibling filter from adm_ to
// guest_. The source still has exactly two documents, enabling positional
// fallback for the broken detection while the valid filter is replaced.
from {yaml: r#"title: Broken mixed source target
logsource: {category: process_creation}
detection:
  selection: {Image|madeup: evil.exe}
  condition: selection
---
title: Updated mixed source filter
name: mixed-source-filter
logsource: {category: process_creation}
filter:
  rules: any
  selection: {User|startswith: guest_}
  condition: not selection
"#}
to_file env("FILE_ROOT") + "/sigma-reload-mixed.yaml.next" {
  write_all yaml
}
