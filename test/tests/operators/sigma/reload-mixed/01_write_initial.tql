// An id-less detection and its global filter share one two-document source.
from {yaml: r#"title: Mixed source target
logsource: {category: process_creation}
detection:
  selection: {Image|endswith: evil.exe}
  condition: selection
---
title: Mixed source filter
name: mixed-source-filter
logsource: {category: process_creation}
filter:
  rules: any
  selection: {User|startswith: adm_}
  condition: not selection
"#}
to_file env("FILE_ROOT") + "/sigma-reload-mixed.yaml" {
  write_all yaml
}
