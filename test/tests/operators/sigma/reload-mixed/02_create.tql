// Coalesce findings to limit backpressure from short-lived subscriptions.
api "/pipeline/create", {
  id: "00000000-0000-0000-0000-0000000017b0",
  definition: "every 25ms {\n  from {id: \"adm\", Image: \"C:\\\\evil.exe\", User: \"adm_alice\"}, {id: \"guest\", Image: \"C:\\\\evil.exe\", User: \"guest_alice\"}, {id: \"other\", Image: \"C:\\\\evil.exe\", User: \"nobody\"}\n}\nenumerate event_id\nsigma path=\"" + env("FILE_ROOT") + "/sigma-reload-mixed.yaml\", mapping=\"direct\", refresh_interval=50ms\nselect event_id=evidences[0].data.event_id, user=evidences[0].data.User, title=finding_info.title\nbatch 100\npublish \"sigma-reload-mixed-topic\"",
}
discard
