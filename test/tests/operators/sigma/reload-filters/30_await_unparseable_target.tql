// Wait for the source-level retention warning before changing the filters.
diagnostics live=true, retro=true
where pipeline_id == "00000000-0000-0000-0000-0000000017af" and message == "sigma operator retains last known good version of '" + env("FILE_ROOT") + "/sigma-reload-filters-target.yaml'"
head 1
select severity, message=message.replace(env("FILE_ROOT"), "<root>")
