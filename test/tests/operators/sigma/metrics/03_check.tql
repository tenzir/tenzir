// TODO(TNZ-1360): Run this directory on Nova once `api` and `metrics` work
// with `--nova`.
every 1s {
  metrics "sigma"
  where pipeline_id == "00000000-0000-0000-0000-000000000001"
  summarize \
    events=sum(events),
    rule_evaluations=sum(rule_evaluations),
    matches=sum(matches)
  where events == 2
}
head 1
