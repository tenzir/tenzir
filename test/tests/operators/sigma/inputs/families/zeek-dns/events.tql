// Projection must not match: the answers list lacks the rule's value.
{
  id: "wrong-answer",
  time: 2024-05-01T12:00:05Z,
  class_uid: 4003,
  activity_id: 6,
  metadata: {
    version: "1.9.0",
    log_name: "dns.log",
