from {
  source_id: "direct",
  query: "beacon.example.test",
  answers: ["alias.example.test", "answer.example.test"],
  qtype_name: "A",
  id: {resp_p: 53},
}
sigma path=f"{env("TENZIR_INPUTS")}/ocsf-zeek-dns.yaml",
      mapping="direct", format="plain"
select id=event.source_id

merge {
from {
  source_id: "automatic",
  query: "beacon.example.test",
  answers: ["alias.example.test", "answer.example.test"],
  qtype_name: "A",
  id: {resp_p: 53},
}
class_uid = 4003
activity_id = 6
metadata = {
  version: "1.9.0",
  log_name: "dns.log",
  product: {name: "Zeek"},
}
dst_endpoint = {port: id.resp_p}
query = {hostname: query, type: qtype_name}
answers = answers.map(answer => {rdata: answer})
drop qtype_name, id
sigma path=f"{env("TENZIR_INPUTS")}/ocsf-zeek-dns.yaml", format="plain"
select id=event.source_id
}
sort id
