from {
  class_uid: 1007,
  metadata: {
    version: "1.9.0",
  },
  process: {
    path: r"C:\Windows\System32\cmd.exe",
  },
}
sigma rules=r#"
title: Unsupported logsource with process field
logsource:
  category: clipboard_capture
  product: windows
detection:
  selection:
    Image|endswith: '\cmd.exe'
  condition: selection
"#, format="plain"

merge {
from {
  id: "literal",
  class_uid: 1007,
  metadata: {
    version: "1.9.0",
  },
  Image: r"C:\Windows\System32\cmd.exe",
}
sigma rules=r#"
title: Unsupported logsource with literal field
logsource:
  category: clipboard_capture
  product: windows
detection:
  selection:
    Image|endswith: '\cmd.exe'
  condition: selection
"#, format="plain"
select id=event.id
}
sort id
