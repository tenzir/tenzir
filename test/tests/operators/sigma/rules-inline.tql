// One inline string may hold a multi-document rule collection; no filesystem
// access happens at runtime.
from {id: "one", foo: "alpha"},
     {id: "two", bar: "bravo"}
sigma rules=r#"title: First
detection:
  selection:
    foo: alpha
  condition: selection
---
title: Second
detection:
  selection:
    bar: bravo
  condition: selection
"#
select id = evidences[0].data.id
