from {yaml: r#"title: Filter target
id: 11111111-1111-4111-8111-111111111111
logsource:
  category: process_creation
detection:
  selection:
    Image|endswith: '\\evil.exe'
  condition: selection
---
title: Administrator filter
name: administrator-filter
logsource:
  category: process_creation
filter:
  rules: [11111111-1111-4111-8111-111111111111]
  selection:
    User|startswith: adm_
  condition: not selection
"#}
to_file env("FILE_ROOT") + "/filter-removal.yaml" {
  write_all yaml
}
