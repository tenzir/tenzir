from {
  id: "mapped-to-mapped",
  class_uid: 1007,
  metadata: {
    version: "1.9.0",
  },
  process: {
    cmd_line: "cmd.exe",
    file: {
      internal_name: "cmd.exe",
    },
  },
}
sigma rules=r#"
title: Mapped field reference
logsource:
  category: process_creation
  product: windows
detection:
  selection:
    CommandLine|fieldref: OriginalFileName
  condition: selection
"#, format="plain"
select id=event.id

merge {
from {
  id: "mapped-to-literal",
  class_uid: 1007,
  metadata: {
    version: "1.9.0",
  },
  custom_image: r"C:\Windows\System32\cmd.exe",
  process: {
    path: r"C:\Windows\System32\cmd.exe",
  },
}
sigma rules=r#"
title: Mixed field reference
logsource:
  category: process_creation
  product: windows
detection:
  selection:
    Image|fieldref: custom_image
  condition: selection
"#, format="plain"
select id=event.id
}
merge {
from {
  id: "integrity-fieldref",
  class_uid: 1007,
  metadata: {
    version: "1.9.0",
  },
  OtherIntegrityLevel: 4,
  process: {
    integrity_id: 4,
  },
}
sigma rules=r#"
title: Projected enum field reference
logsource:
  category: process_creation
  product: windows
detection:
  selection:
    IntegrityLevel|fieldref: OtherIntegrityLevel
  condition: selection
"#, format="plain"
select id=event.id
}
sort id
