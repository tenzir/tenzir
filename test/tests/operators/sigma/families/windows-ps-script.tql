// Family fixture test for the `sigma/windows/ps_script` mapping. The events file
// carries TQL-typed OCSF samples including near-miss negatives; the rules
// directory holds representative stock-shaped Sigma rules.
from_file f"{env("TENZIR_INPUTS")}/families/windows-ps-script/events.tql" {
  read_tql
}
sigma path=f"{env("TENZIR_INPUTS")}/families/windows-ps-script/rules", format="plain"
select rule=rule.title, id=event.id
sort rule, id
