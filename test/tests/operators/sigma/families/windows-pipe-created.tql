// Family fixture test for the `sigma/windows/pipe_created` mapping. The events file
// carries TQL-typed OCSF samples including near-miss negatives; the rules
// directory holds representative stock-shaped Sigma rules.
from_file f"{env("TENZIR_INPUTS")}/families/windows-pipe-created/events.tql" {
  read_tql
}
sigma path=f"{env("TENZIR_INPUTS")}/families/windows-pipe-created/rules", format="plain"
select rule=rule.title, id=event.id
sort rule, id
