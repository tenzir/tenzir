// A batch that is clustered except for one group whose rows are split by
// another group: only the scattered group is gathered, the contiguous ones
// are sub-sliced in place.
from {g: "a", x: 1}, {g: "a", x: 2}, {g: "b", x: 3}, {g: "a", x: 4},
     {g: "c", x: 5}, {g: "c", x: 6}
summarize g, first=first(x), last=last(x), all=collect(x), total=sum(x)
