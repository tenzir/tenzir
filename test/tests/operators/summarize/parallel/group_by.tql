// parallelism: 6
// Each group's aggregation state must live in exactly one instance, so the
// result is identical to the single-instance case (modulo output ordering,
// which we pin with `sort`).
from {g: "a", x: 1},
     {g: "b", x: 2},
     {g: "a", x: 3},
     {g: "c", x: 4},
     {g: "b", x: 5},
     {g: "a", x: 6}
summarize g, total=sum(x), n=count()
sort g
