---
fixtures: [system_one]
timeout: 60
assertions:
  fixtures:
    system_one:
      count: 1
      states:
        - id: 1
          message: hello
          context:
            keep: 7
---

from {id: 1, message: "hello", context: {keep: 7, decision: "old"}, ai: {}}
ai_decide "Is this event dangerous?",
          into=context.decision,
          model="fixture-decider",
          endpoint=env("SYSTEM_ONE_FIXTURE_ENDPOINT")
select id, keep=context.keep, probability=context.decision.answer.probability,
       latency_is_duration=type_of(context.decision.latency).kind == "duration"
