---
fixtures: [system_one]
timeout: 60
---

from {id: 1, mode: "missing_answer"}, {id: 2, mode: "wrong_type"},
     {id: 3, mode: "out_of_range"}, {id: 4}
ai_decide "Is this event dangerous?",
          model="fixture-decider",
          endpoint=env("SYSTEM_ONE_FIXTURE_ENDPOINT")
select id, decision=ai.decide
drop decision.latency
