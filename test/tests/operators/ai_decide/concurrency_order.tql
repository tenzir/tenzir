---
fixtures: [system_one]
timeout: 60
assertions:
  fixtures:
    system_one:
      count: 4
      max_concurrent_requests: 2
---

// The fixture holds the first request until a second one is in flight, and
// then answers it last.
// Keep one schema so `batch` does not split the rendezvous from its peers.
from {id: 1, rendezvous: 2, delay_ms: 100, note: ""},
     {id: 2, rendezvous: 0, delay_ms: 0, note: ""},
     {id: 3, rendezvous: 0, delay_ms: 0, note: ""},
     {id: 4, rendezvous: 0, delay_ms: 0, note: "danger"}
// Requests run concurrently within a batch.
batch 4
ai_decide "Is this event dangerous?",
          concurrency=2,
          model="fixture-decider",
          endpoint=env("SYSTEM_ONE_FIXTURE_ENDPOINT")
select id, probability=ai.decide.answer.probability
