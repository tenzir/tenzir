---
fixtures: [system_one]
timeout: 60
assertions:
  fixtures:
    system_one:
      count: 1
      states:
        - id: 1
          message: danger
---

from {id: 1, message: "danger", ai: {prompt: {text: "an earlier answer"}}}
ai_decide "Is this event dangerous?",
          model="fixture-decider",
          endpoint=env("SYSTEM_ONE_FIXTURE_ENDPOINT")
select id, probability=ai.decide.answer.probability, prompt=ai.prompt.text
