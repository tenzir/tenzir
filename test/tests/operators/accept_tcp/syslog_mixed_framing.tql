---
fixtures:
  - tcp:
      mode: client
      concurrent: true
      payloads:
        - "52 <165>1 2026-11-09T12:00:00Z host app 123 - - counted"
        - "<165>1 2026-11-09T12:00:00Z host app 123 - - newline\n"
timeout: 30
---

accept_tcp env("TCP_ENDPOINT") {
  split_bytes 1
  read_syslog
}
head 2
select message
sort message
