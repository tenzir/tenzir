// A filter behind `ocsf_cast` reaches the reader as a comparison of the
// mapped input field, so the reader skips the corrupted second row group.
from_file f"{env("READ_PUSHDOWN_ROOT")}/corrupt-lookahead" {
  read_parquet
}
class_uid = 3002
category_uid = 3
type_uid = 300201
severity_id = 1
time = 2026-01-01
user = {name: "user"}
dst_endpoint = {ip: 192.0.2.1}
metadata = {version: "1.5.0", product: {name: "test"}, logged_time: now()}
src_endpoint.hostname = move text
activity_id = move id
this = ocsf_cast(this)
where activity_id == 1
select activity_id, src_endpoint
