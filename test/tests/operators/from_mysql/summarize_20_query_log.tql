// The aggregations of the earlier tests ran in MySQL, while
// `summarize_11_local.tql` read the rows.
from_mysql sql="SELECT CAST(argument AS CHAR) AS query FROM mysql.general_log WHERE command_type = 'Query' AND argument LIKE 'SELECT%FROM `agg`%' AND argument NOT LIKE '%general_log%' ORDER BY event_time",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user="root",
           password=env("MYSQL_ROOT_PASSWORD"),
           database=env("MYSQL_DATABASE")
