// The filter, projection, and limit go into the query. Text compares by bytes,
// as in TQL, not under MySQL's case-insensitive collation, which would match
// `Alice` and make it the first row.
from_mysql table="users",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
where name == "alice" or age > 30
select name, age
head 1
