// The filter, projection, and limit go into the query. MySQL compares text under
// the collation of its column, which ignores case, so `alice` matches `Alice`,
// the first row.
from_mysql table="users",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
where name == "alice" or age > 30
select name, age
head 1
