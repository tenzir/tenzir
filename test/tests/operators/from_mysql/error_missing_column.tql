---
error: true
---

// The query takes the filter before the operator knows the columns of the
// table, and MySQL rejects the column that the table lacks, so the query fails.
// `pushdown=false` keeps the filter in Tenzir.
from_mysql table="users",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
where missing == 1
