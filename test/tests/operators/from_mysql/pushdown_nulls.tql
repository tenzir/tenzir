// MySQL compares `NULL` with anything as unknown, so the row where
// `nullable_val` is null does not pass `!= "not null"`, unlike in TQL.
from_mysql table="types",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
where nullable_val != "not null"
select id, nullable_val
