// A summary without group keys yields one event for an empty input, also when
// MySQL computes it: `count()` is `0` and `min` is `null`.
from_mysql table="agg",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
where id > 100
summarize rows=count(), lo=min(n)
