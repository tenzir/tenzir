// A predicate that MySQL cannot evaluate keeps all rows but stays local, so
// the operators run locally, with the result of `summarize_15_transforms.tql`.
from_mysql table="agg",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
where id.string() != ""
select key=s, ident=id, value=n, junk=d
drop junk
where ident > 1 or value == null
last = ident
summarize key, rows=count(), hi.id=max(last), lo=min(value)
sort key
