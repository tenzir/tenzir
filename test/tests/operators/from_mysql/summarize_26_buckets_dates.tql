// A `DATE` buckets as the start of its day, with a time. A bucket of no time
// is `null`.
from_mysql table="times",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
bucket = floor(day, 2d)
summarize bucket, rows=count()
sort bucket
