// With `pushdown=false`, the filter runs in Tenzir with TQL semantics: text
// compares by its bytes, so `alice` matches no row, unlike in
// `pushdown_filter_select_head.tql`.
from_mysql table="users", pushdown=false,
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
where name == "alice"
select name
