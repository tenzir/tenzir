// MySQL filters, groups, and aggregates the rows: the `where` and the
// `summarize` go into the query. Text groups by its bytes, as in TQL. The
// result equals that of `summarize_11_local.tql`, which aggregates the same
// rows locally.
from_mysql table="agg",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
where id > 1 or n == null
summarize s, rows=count(), values=count(n), lo=min(n), hi.id=max(id)
sort s
