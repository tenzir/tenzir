// MySQL filters, groups, and aggregates the rows: the `where` and the
// `summarize` go into the query. Text groups under the collation of its column,
// so `a`, `A`, and `ä` form one group, unlike in `summarize_11_local.tql`, which
// aggregates the same rows in the pipeline.
// A sort by a computed key stays in Tenzir.
from_mysql table="agg",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
where id > 1 or n == null
summarize s, rows=count(), values=count(n), lo=min(n), hi.id=max(id)
sort s.string()
