// A predicate without a translation runs locally, and so does the limit.
from_mysql table="users",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
where age >= 25 and name.to_upper() != "ALICE"
head 1
select name
