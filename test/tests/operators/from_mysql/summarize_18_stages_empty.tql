// A filter on the result may drop the single group of an aggregation without
// group keys.
from_mysql table="hits",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
summarize n=count()
where n > 100
head 1
