// Creates the table of the summarize tests. Its text differs only in case or
// trailing spaces, which MySQL's default collation would put into one group.
from_mysql sql="CREATE TABLE agg (id INT, s VARCHAR(20), n BIGINT, d DOUBLE)",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
