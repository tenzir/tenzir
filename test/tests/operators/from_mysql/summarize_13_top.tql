// `top` counts the values in the query, which groups text under the collation
// of its column, and sorts the counts in the pipeline.
from_mysql table="agg",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
top s
sort -count, s.string()
