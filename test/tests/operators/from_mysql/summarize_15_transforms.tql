// MySQL computes the summary behind a rename, a `drop`, and an assignment
// that copies a field: the `where` and the `summarize` go into the query over
// the table's columns, and the outputs keep the new names. The result equals
// that of `summarize_16_transforms_local.tql`, which runs the same operators
// locally.
from_mysql table="agg",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
select key=s, ident=id, value=n, junk=d
drop junk
where ident > 1 or value == null
last = ident
summarize key, rows=count(), hi.id=max(last), lo=min(value)
sort key
