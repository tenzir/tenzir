// Live mode pushes the filter into every window, and the limit ends the read.
from_mysql table=env("MYSQL_LIVE_STREAM_TABLE"),
           live=true,
           tracking_column="id",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
where id > 0 and payload == "live-stream-token"
select payload
head 3
