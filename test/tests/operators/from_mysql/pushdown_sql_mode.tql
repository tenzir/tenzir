// A user-provided query stays as it is; the operator applies the filter and the
// limit itself.
from_mysql sql="SELECT * FROM users ORDER BY id DESC",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
where age < 35
head 1
select name
