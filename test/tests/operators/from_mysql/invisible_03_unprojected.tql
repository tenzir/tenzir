// Without a projection, the filter after the limit still reads the invisible
// column, which the result then leaves out, as `SELECT *` does.
from_mysql table="invisible",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
sort id
head 2
where h > 15
