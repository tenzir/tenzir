// MySQL sorts `NULL` first, which decides whether the group without a maximum
// makes the cut, and also sorts the result after the `head`.
from_mysql table="hits",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
summarize src, hi=max(sev)
sort hi
head 5
sort hi, src
