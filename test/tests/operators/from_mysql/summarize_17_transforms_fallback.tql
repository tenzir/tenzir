// MySQL does not group by a `DOUBLE` column, which the operator finds only
// once it reads the table's columns. It then aggregates its rows locally, with
// the rename before the summary. Without it, the summary would read fields
// that the rows do not have.
from_mysql table="agg",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
select key=d, ident=id
summarize key, rows=count(), hi=max(ident)
sort key
