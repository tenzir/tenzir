// Records queries in `mysql.general_log` for `summarize_20_query_log.tql`.
from_mysql sql="SET GLOBAL log_output = 'TABLE'",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user="root",
           password=env("MYSQL_ROOT_PASSWORD"),
           database=env("MYSQL_DATABASE")
