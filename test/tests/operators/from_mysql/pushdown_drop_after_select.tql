// A `drop` after a `select` knows the columns that it keeps, so the query
// selects them.
from_mysql table="users",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
select id, name, age
drop age
where id <= 2
