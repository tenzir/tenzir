// A filter after a sorted limit needs a derived table that keeps the sort key
// next to every column, which MySQL accepts only qualified with the name of
// the table.
from_mysql table="users",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
sort -age
head 2
where name != "Charlie"
select name, age
