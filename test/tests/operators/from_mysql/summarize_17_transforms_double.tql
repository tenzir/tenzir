// MySQL groups by a `DOUBLE` column behind a rename, and sorts the groups with
// `NULL` first.
from_mysql table="agg",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
select key=d, ident=id
summarize key, rows=count(), hi=max(ident)
sort key
