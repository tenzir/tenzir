// A predicate that MySQL cannot evaluate keeps all rows but stays local, so
// the operator aggregates locally, with the result of `summarize_10_pushed.tql`.
from_mysql table="agg",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
where id > 1 or n == null
where id.string() != ""
summarize s, rows=count(), values=count(n), lo=min(n), hi.id=max(id)
sort s
