// MySQL buckets times by multiples of the width since the epoch, also before
// it, as TQL does. The buckets arrive as text and decode as times.
from_mysql table="times",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
bucket = floor(ts, 7h)
summarize bucket, rows=count()
sort bucket
