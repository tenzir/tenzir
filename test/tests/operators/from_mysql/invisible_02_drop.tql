// The `drop` keeps every other column, so the query reads the table with `*`,
// and also selects the invisible column that the `select` above the limit
// reads.
from_mysql table="invisible",
           host=env("MYSQL_HOST"),
           port=int(env("MYSQL_PORT")),
           user=env("MYSQL_USER"),
           password=env("MYSQL_PASSWORD"),
           database=env("MYSQL_DATABASE")
head 2
select id, h
drop id
