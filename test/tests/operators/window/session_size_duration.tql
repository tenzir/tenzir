// The event that reaches a duration size belongs to the closing session. The
// next event starts a new session even though it remains within the gap.
from {ts: 0min.from_epoch()},
     {ts: 4min.from_epoch()},
     {ts: 8min.from_epoch()},
     {ts: 12min.from_epoch()}
window gap=5min, size=8min, on=ts {
  summarize n=count()
  start = $window.start.since_epoch()
}
sort start
