// Every event advances the cadence. When a boundary event does not match the
// trigger, the cadence remains due until the next matching event.
from {x: 1, fire: false},
     {x: 2, fire: false},
     {x: 3, fire: true},
     {x: 4, fire: true},
     {x: 5, fire: false},
     {x: 6, fire: true}
window size=4, every=2, trailing=true, trigger=fire {
  summarize n=count(), total=sum(x)
  this = {
    ...$window.event,
    n: n,
    total: total,
    begin: $window.begin,
    finish: $window.finish,
  }
}
