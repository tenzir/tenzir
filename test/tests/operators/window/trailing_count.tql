// A trailing count window runs once per event and includes the triggering event
// plus up to `size - 1` preceding events.
from {x: 1}, {x: 2}, {x: 3}, {x: 4}
window size=2, trailing=true {
  summarize n=count(), total=sum(x)
  this = {
    ...$window.event,
    n: n,
    total: total,
    begin: $window.begin,
    finish: $window.finish,
  }
}
