---
assertions:
  fixtures:
    quack:
      sql: SELECT * FROM new_schema.new_table ORDER BY id
      rows:
        - {id: 10, name: ten}
        - {id: 11, name: eleven}
---

from {id: 10, name: "ten"}, {id: 11, name: "eleven"}
to_duckdb env("QUACK_URI"), token=env("QUACK_TOKEN"),
  table="new_schema.new_table", mode="create", primary=id
