// A value in a previously null column can use the existing file writer.
from {
  kind: "a",
  payload_a: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  payload_b: null,
  ts: 2026-01-01T00:01:00Z,
}
repeat 129
enumerate seq
id = seq + 1000
if seq == 128 {
  payload_b = "widen"
}
drop seq
batch 128
to_iceberg "prunens.events", catalog=env("ICEBERG_REST_URI"), max_size=4096
