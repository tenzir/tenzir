// The schema name and the `internal` attribute must survive the
// writer and come back out of the reader.
from_file f"{env("TENZIR_INPUTS")}/feather/roundtrip/metadata.feather" {
  read_feather
}
where x > 0
input_name = @name
input_internal = @internal
write_parquet compression_type="zstd", compression_level=3
read_parquet
output_name = @name
output_internal = @internal
