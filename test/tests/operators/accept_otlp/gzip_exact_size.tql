---
fixtures:
  - http_request_chunked:
      requests:
        - path: /v1/logs
          headers:
            Content-Type: application/json
            Content-Encoding: gzip
          body_chunks_base64:
            - H4sIAAAAAAAC/6tWKkotzi8tSk71yU8vVrKKrlYqTs4vQPBy8tODUpPzi1Ig3KT8lEolK6CikqLMvPSwxJzSVCUrpbLEnMwUpdraWDBUGEIAAA==
            - fjMtoQABAAA=
          expected_status: 200
          stop_on_connection_drop: true
---

accept_otlp env("HTTP_REQUEST_ENDPOINT"), max_message_size=256
head 1
