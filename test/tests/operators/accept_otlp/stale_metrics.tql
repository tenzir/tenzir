---
fixtures:
  - http_request:
      requests:
        - path: /v1/metrics
          headers:
            Content-Type: application/json
          expected_status: 200
          expected_body: "{}"
          body: '{"resourceMetrics":[{"scopeMetrics":[{"metrics":[{"name":"stale.json.gauge","gauge":{"dataPoints":[{"timeUnixNano":"2000000000","flags":1}]}},{"name":"stale.json.sum","sum":{"aggregationTemporality":2,"dataPoints":[{"timeUnixNano":"2000000000","flags":1}]}},{"name":"stale.json.histogram","histogram":{"aggregationTemporality":1,"dataPoints":[{"timeUnixNano":"2000000000","count":"7","sum":9,"bucketCounts":["1"],"exemplars":[{}],"flags":1}]}},{"name":"stale.json.exponential","exponentialHistogram":{"aggregationTemporality":2,"dataPoints":[{"timeUnixNano":"2000000000","count":"7","sum":9,"zeroThreshold":"NaN","positive":{"bucketCounts":["1"]},"flags":1}]}},{"name":"stale.json.summary","summary":{"dataPoints":[{"timeUnixNano":"2000000000","count":"0","sum":9,"quantileValues":[{"quantile":"NaN","value":-1}],"flags":1}]}}]}]}]}'
        - path: /v1/metrics
          headers:
