accept_otlp env("HTTP_REQUEST_ENDPOINT")
head 8
select schema=@name, name=metric.name, flags,
  int_value=value?.int_value?, double_value=value?.double_value?,
  count=count?, sum=sum?, bucket_counts=bucket_counts?,
  quantile_values=quantile_values?
