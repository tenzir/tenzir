// Covers type mismatches, out-of-range values, overlong strings, and invalid
// structured data. Each unexpected type warns once per batch.
from {
  facility: 24,
  severity: -1,
  timestamp: "2023-01-01",
  hostname: 42,
  app_name: "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvw",
  process_id: "1",
  message_id: "m",
  structured_data: {
    ok: {flag: true, ratio: 1.5, addr: 10.0.0.1, nested: {x: 1}, xs: [1]},
    bad: "not a record",
  },
  message: 1,
},
{
  facility: "4",
  severity: 8,
  timestamp: 2023-01-01T00:00:00Z,
  hostname: 43,
  app_name: "app",
  process_id: "2",
  message_id: "m",
  structured_data: "invalid",
  message: "second",
}
to_stdout {
  write_syslog
}
