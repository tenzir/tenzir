// Times and intervals are seconds rounded to microseconds, the `#path` omits
// the `zeek.` prefix of the schema name, and `#close` ends the log.
from {
  ts: 2026-11-16T07:00:00.123456Z,
  uid: "C1",
  id: {orig_h: 10.0.0.5, orig_p: 51544, resp_h: 203.0.113.9, resp_p: 443},
  proto: "tcp",
  duration: 1.5s,
  negative: -250ms,
  before_epoch: 1969-12-31T23:59:59.5Z,
  rounds_up: 2026-11-16T07:00:00.9999996Z,
  epoch_scale: from_epoch(1794812400s + 123456600ns),
}
@name = "zeek.conn"
write_zeek_tsv
read_lines
line = line.replace_regex("^(#open|#close)\t\\d{4}(-\\d{2}){5}$", "\\1\t<time>")
write_lines
