---
fixtures: [microsoft_defender]
timeout: 60
---

// Every column type and null spelling of the Graph wire format, with
// OData annotations: booleans as SByte 0/1, dynamic as Object, decimals as
// SqlDecimal strings, timespans in ISO 8601, and nulls as {}, null, or "".
from_microsoft_defender "all-types",
  azure_auth={
    tenant_id: env("DEFENDER_TENANT"),
    client_id: env("DEFENDER_CLIENT"),
    client_secret: env("DEFENDER_SECRET"),
    authority: env("DEFENDER_AUTHORITY"),
  },
  _base_url=env("DEFENDER_URL"),
  tls=false
types = {
  s: type_kind(s),
  g: type_kind(g),
  d: type_kind(d),
  i: type_kind(i),
  l: type_kind(l),
  r: type_kind(r),
  b: type_kind(b),
  t: type_kind(t),
  ts: type_kind(ts),
}
