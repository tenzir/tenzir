---
fixtures:
  - microsoft_defender:
      rows: [0]
      project: ["DeviceName", "RemoteIP", "ReportId"]
timeout: 60
assertions:
  fixtures:
    microsoft_defender:
      appended: |-

        | where (['RemotePort'] == 443)
        | where (['ActionType'] == "ConnectionSuccess")
        | project ['DeviceName'], ['RemoteIP'], ['ReportId']
---

// The stages run in advanced hunting over a realistic response. The service
// returns row 0 with the selected columns.
from_microsoft_defender "device-network-events",
  azure_auth={
    tenant_id: env("DEFENDER_TENANT"),
    client_id: env("DEFENDER_CLIENT"),
    client_secret: env("DEFENDER_SECRET"),
    authority: env("DEFENDER_AUTHORITY"),
  },
  _base_url=env("DEFENDER_URL"),
  tls=false
where RemotePort == 443 and ActionType == "ConnectionSuccess"
select DeviceName, RemoteIP, ReportId
