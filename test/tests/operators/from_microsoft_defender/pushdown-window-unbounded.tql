---
fixtures:
  - microsoft_defender:
      rows: [2, 3, 4]
timeout: 60
assertions:
  fixtures:
    microsoft_defender:
      appended: |-

        | where (['Timestamp'] >= datetime(2026-01-02T00:00:00.0000000Z))
---

// Without bounds, the request carries no `Timespan`. The service returns
// rows 2 to 4.
from_microsoft_defender "pushdown",
  azure_auth={
    tenant_id: env("DEFENDER_TENANT"),
    client_id: env("DEFENDER_CLIENT"),
    client_secret: env("DEFENDER_SECRET"),
    authority: env("DEFENDER_AUTHORITY"),
  },
  _base_url=env("DEFENDER_URL"),
  tls=false
where Timestamp >= 2026-01-02
