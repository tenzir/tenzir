---
fixtures:
  - microsoft_defender:
      rows: [0]
      project: ["RemoteIP", "DeviceName"]
timeout: 60
assertions:
  fixtures:
    microsoft_defender:
      appended: |-

        | project ['RemoteIP'], ['DeviceName']
---

// Swapped fields keep their columns, which the layout renames. The service
// returns row 0.
from_microsoft_defender "pushdown",
  azure_auth={
    tenant_id: env("DEFENDER_TENANT"),
    client_id: env("DEFENDER_CLIENT"),
    client_secret: env("DEFENDER_SECRET"),
    authority: env("DEFENDER_AUTHORITY"),
  },
  _base_url=env("DEFENDER_URL"),
  tls=false
select DeviceName=RemoteIP, RemoteIP=DeviceName
