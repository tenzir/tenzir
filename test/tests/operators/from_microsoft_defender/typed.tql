---
fixtures: [microsoft_defender]
timeout: 60
---

from_microsoft_defender env("DEFENDER_QUERY"),
  azure_auth={
    tenant_id: env("DEFENDER_TENANT"),
    client_id: env("DEFENDER_CLIENT"),
    client_secret: env("DEFENDER_SECRET"),
    authority: env("DEFENDER_AUTHORITY"),
  },
  _base_url=env("DEFENDER_URL"),
  tls=false
Types = {
  Timestamp: type_kind(Timestamp),
  Count: type_kind(Count),
  Ratio: type_kind(Ratio),
  Enabled: type_kind(Enabled),
  Message: type_kind(Message),
  NullTime: type_kind(NullTime),
  NestedString: type_kind(Details.text),
}
