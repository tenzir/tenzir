---
fixtures:
  - microsoft_defender:
      rows: [2, 3, 6, 7, 11]
      project: [Id, RemoteUrl, RemoteIP]
timeout: 60
assertions:
  fixtures:
    microsoft_defender:
      appended: |-

        | take 100000
        | where ((gettype(column_ifexists('RemoteUrl', dynamic(null))) !in ("string") or tostring(column_ifexists('RemoteUrl', dynamic(null))) == "evil.example" or tostring(column_ifexists('RemoteUrl', dynamic(null))) matches regex @'^[ \t\r\n]*"') or (isempty(parse_ipv6(tostring(column_ifexists('RemoteIP', dynamic(null))))) or (ipv6_compare(tostring(column_ifexists('RemoteIP', dynamic(null))), "10.20.0.0") >= 0 and ipv6_compare(tostring(column_ifexists('RemoteIP', dynamic(null))), "10.20.255.255") <= 0)))
        | project ['Id'] = column_ifexists('Id', dynamic(null)), ['RemoteUrl'] = column_ifexists('RemoteUrl', dynamic(null)), ['RemoteIP'] = column_ifexists('RemoteIP', dynamic(null))
---

// The fixture checks the exact candidate query; the full predicate remains local.
from_microsoft_defender "observables",
  azure_auth={
    tenant_id: env("DEFENDER_TENANT"),
    client_id: env("DEFENDER_CLIENT"),
    client_secret: env("DEFENDER_SECRET"),
    authority: env("DEFENDER_AUTHORITY"),
  },
  _base_url=env("DEFENDER_URL"),
  tls=false
where RemoteUrl == "evil.example" or RemoteIP.ip() in 10.20.0.0/16
select Id
