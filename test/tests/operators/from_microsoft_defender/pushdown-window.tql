---
fixtures: [microsoft_defender]
timeout: 60
assertions:
  fixtures:
    microsoft_defender:
      appended: |-

        | take 100000
        | where (gettype(column_ifexists('Timestamp', dynamic(null))) != "datetime" or todatetime(column_ifexists('Timestamp', dynamic(null))) < datetime(1900-01-01) or todatetime(column_ifexists('Timestamp', dynamic(null))) >= datetime(2262-01-01) or todatetime(column_ifexists('Timestamp', dynamic(null))) >= datetime(2026-01-01T11:59:59.999999Z))
---

// A time predicate on the output does not narrow the window: the query
// may have aggregated, renamed, or computed `Timestamp`.
from_microsoft_defender "pushdown-bounded",
  azure_auth={
    tenant_id: env("DEFENDER_TENANT"),
    client_id: env("DEFENDER_CLIENT"),
    client_secret: env("DEFENDER_SECRET"),
    authority: env("DEFENDER_AUTHORITY"),
  },
  _base_url=env("DEFENDER_URL"),
  tls=false,
  start=2026-01-01,
  end=2026-01-02
where Timestamp >= 2026-01-01T12:00:00
