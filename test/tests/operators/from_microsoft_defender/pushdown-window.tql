---
fixtures:
  - microsoft_defender:
      rows: [1, 2, 3, 4]
timeout: 60
assertions:
  fixtures:
    microsoft_defender:
      appended: |-

        | where (['Timestamp'] >= datetime(2026-01-01T12:00:00.0000000Z))
---

// A filter on the time of the query's output runs in advanced hunting, and
// the request window stays as given. The service returns rows 1 to 4.
from_microsoft_defender "pushdown-bounded",
  azure_auth={
    tenant_id: env("DEFENDER_TENANT"),
    client_id: env("DEFENDER_CLIENT"),
    client_secret: env("DEFENDER_SECRET"),
    authority: env("DEFENDER_AUTHORITY"),
  },
  _base_url=env("DEFENDER_URL"),
  tls=false,
  start=2026-01-01,
  end=2026-01-02
where Timestamp >= 2026-01-01T12:00:00
