---
fixtures:
  - microsoft_defender:
      synthesize: 1000
timeout: 60
assertions:
  fixtures:
    microsoft_defender:
      appended: ""
---

// Advanced hunting returns at most 100,000 rows of a query without
// reporting a truncation, so a result of that size warns. The test lowers the
// cap to 1,000 rows to keep its data small.
from_microsoft_defender "custom",
  azure_auth={
    tenant_id: env("DEFENDER_TENANT"),
    client_id: env("DEFENDER_CLIENT"),
    client_secret: env("DEFENDER_SECRET"),
    authority: env("DEFENDER_AUTHORITY"),
  },
  _base_url=env("DEFENDER_URL"),
  _max_result_rows=1000,
  tls=false
discard
