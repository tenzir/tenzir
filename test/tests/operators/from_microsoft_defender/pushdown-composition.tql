---
fixtures:
  - microsoft_defender:
      rows: [0]
      project: ["DeviceName", "Id"]
timeout: 60
assertions:
  fixtures:
    microsoft_defender:
      appended: |-

        | where (['DeviceName'] == "host-a")
        | where (['RemotePort'] >= 443)
        | project ['DeviceName'], ['Id']
---

// The filter and the selection run in advanced hunting, after the user's
// query. The service returns row 0 with the selected columns.
from_microsoft_defender "pushdown",
  azure_auth={
    tenant_id: env("DEFENDER_TENANT"),
    client_id: env("DEFENDER_CLIENT"),
    client_secret: env("DEFENDER_SECRET"),
    authority: env("DEFENDER_AUTHORITY"),
  },
  _base_url=env("DEFENDER_URL"),
  tls=false
where DeviceName == "host-a" and RemotePort >= 443
select DeviceName, Id
