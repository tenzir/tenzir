---
fixtures:
  - microsoft_defender:
      rows: [0]
      project: ["Timestamp", "Id", "DeviceName", "RemoteIP", "RemotePort", "Allowed"]
timeout: 60
assertions:
  fixtures:
    microsoft_defender:
      appended: |-

        | project-away ['Extra'], ['ReportId']
---

// A drop runs in advanced hunting. The service returns row 0 without the
// dropped columns.
from_microsoft_defender "pushdown",
  azure_auth={
    tenant_id: env("DEFENDER_TENANT"),
    client_id: env("DEFENDER_CLIENT"),
    client_secret: env("DEFENDER_SECRET"),
    authority: env("DEFENDER_AUTHORITY"),
  },
  _base_url=env("DEFENDER_URL"),
  tls=false
drop Extra, ReportId
