---
fixtures: [microsoft_defender]
timeout: 60
assertions:
  fixtures:
    microsoft_defender:
      appended: |-

        print b = 2
---

// Every tabular statement returns a table, and Graph returns only the first
// one, so the operator appends no stages and the filter runs in Tenzir.
from_microsoft_defender "multi-statement;\nprint b = 2",
  azure_auth={
    tenant_id: env("DEFENDER_TENANT"),
    client_id: env("DEFENDER_CLIENT"),
    client_secret: env("DEFENDER_SECRET"),
    authority: env("DEFENDER_AUTHORITY"),
  },
  _base_url=env("DEFENDER_URL"),
  tls=false
where a == 2
