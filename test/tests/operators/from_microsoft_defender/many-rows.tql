---
fixtures: [microsoft_defender]
timeout: 60
assertions:
  fixtures:
    microsoft_defender:
      appended: "\n| project ['Count'] = column_ifexists('Count', dynamic(null))"
---

from_microsoft_defender "many-rows",
  azure_auth={
    tenant_id: env("DEFENDER_TENANT"),
    client_id: env("DEFENDER_CLIENT"),
    client_secret: env("DEFENDER_SECRET"),
    authority: env("DEFENDER_AUTHORITY"),
  },
  _base_url=env("DEFENDER_URL"),
  tls=false

summarize Count=count(), Min=min(Count), Max=max(Count)
