---
fixtures: [microsoft_defender]
timeout: 60
---

// The same response without OData annotations, as Graph sends it for the
// connector's `odata.metadata=none`.
from_microsoft_defender "metadata-none",
  azure_auth={
    tenant_id: env("DEFENDER_TENANT"),
    client_id: env("DEFENDER_CLIENT"),
    client_secret: env("DEFENDER_SECRET"),
    authority: env("DEFENDER_AUTHORITY"),
  },
  _base_url=env("DEFENDER_URL"),
  tls=false
types = {
  s: type_kind(s),
  g: type_kind(g),
  d: type_kind(d),
  i: type_kind(i),
  l: type_kind(l),
  r: type_kind(r),
  b: type_kind(b),
  t: type_kind(t),
  ts: type_kind(ts),
}
