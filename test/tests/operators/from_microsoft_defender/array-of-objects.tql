---
fixtures: [microsoft_defender]
timeout: 60
---

// Graph sends objects inside dynamic arrays as JSON text, which stays text,
// since an array of JSON strings looks the same.
from_microsoft_defender "array-of-objects",
  azure_auth={
    tenant_id: env("DEFENDER_TENANT"),
    client_id: env("DEFENDER_CLIENT"),
    client_secret: env("DEFENDER_SECRET"),
    authority: env("DEFENDER_AUTHORITY"),
  },
  _base_url=env("DEFENDER_URL"),
  tls=false
