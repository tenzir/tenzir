---
fixtures:
  - microsoft_defender:
      project: [Id, Addr]
timeout: 60
assertions:
  fixtures:
    microsoft_defender:
      appended: |-

        | project ['Id'] = column_ifexists('Id', dynamic(null)), ['Addr'] = column_ifexists('Addr', dynamic(null))
---

// The native subnet stays local: aliased bounds could otherwise exclude row 12.
from_microsoft_defender "observable-adversarial",
  azure_auth={
    tenant_id: env("DEFENDER_TENANT"),
    client_id: env("DEFENDER_CLIENT"),
    client_secret: env("DEFENDER_SECRET"),
    authority: env("DEFENDER_AUTHORITY"),
  },
  _base_url=env("DEFENDER_URL"),
  tls=false
where Addr.ip() in ::/80
select Id
