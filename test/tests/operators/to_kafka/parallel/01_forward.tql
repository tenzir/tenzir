// parallelism: 4
// Each instance produces with its own Kafka producer; together they forward
// every message of the source topic exactly once.
from_kafka env("KAFKA_TOPIC"),
           exit=true,
           options={
             "bootstrap.servers": env("KAFKA_BOOTSTRAP_SERVERS"),
             "auto.offset.reset": "earliest",
             "group.id": "tenzir-test-to-kafka-parallel-forward"
           }
to_kafka "to_kafka_parallel_forwarded",
         message=this.message,
         options={
           "bootstrap.servers": env("KAFKA_BOOTSTRAP_SERVERS")
         }
