// One Kafka message can contain multiple JSON records.
from_kafka env("KAFKA_TOPIC"),
           count=1,
           offset="beginning",
           options={
             "bootstrap.servers": env("KAFKA_BOOTSTRAP_SERVERS"),
             "group.id": "tenzir-test-to-kafka-nested-forward"
           }
to_kafka "to_kafka_nested_forwarded",
         message="{\"nested\":{\"values\":[1,true,null]},\"large\":18446744073709551616}\n{\"other\":2}",
         options={
           "bootstrap.servers": env("KAFKA_BOOTSTRAP_SERVERS")
         }
