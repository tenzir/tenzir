// Enabling librdkafka debug logging must not turn its log lines into
// diagnostics, and both clients must shut down cleanly while they still log.
from_kafka env("KAFKA_TOPIC"),
           count=1,
           offset="beginning",
           options={
             "bootstrap.servers": env("KAFKA_BOOTSTRAP_SERVERS"),
             "group.id": "tenzir-test-to-kafka-forward-debug",
             "debug": "generic"
           }
to_kafka "to_kafka_forwarded_debug",
         message=this.message,
         options={
           "bootstrap.servers": env("KAFKA_BOOTSTRAP_SERVERS"),
           "debug": "generic"
         }
