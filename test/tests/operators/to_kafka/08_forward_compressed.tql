// Produce a compressible message with the default options. librdkafka sends a
// batch uncompressed when compression does not shrink it, so the message must
// be large enough to benefit from compression.
from_kafka env("KAFKA_TOPIC"),
           count=1,
           offset="beginning",
           options={
             "bootstrap.servers": env("KAFKA_BOOTSTRAP_SERVERS"),
             "group.id": "tenzir-test-to-kafka-compressed-forward"
           }
to_kafka "to_kafka_compressed",
         message=this.message.repeat(100),
         options={
           "bootstrap.servers": env("KAFKA_BOOTSTRAP_SERVERS")
         }
