---
fixtures: [hydrolix]
assertions:
  fixtures:
    hydrolix:
      requests: 2
      events:
        test.patient:
          - {id: 1}
---
// A `Retry-After` beyond any duration waits no longer than the retry window.
from {id: 1}
to_hydrolix env("HYDROLIX_URL"),
  token="test-token",
  table="test.patient",
  _retry_timeout=1s
