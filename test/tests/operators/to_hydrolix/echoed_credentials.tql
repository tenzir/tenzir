---
fixtures:
  - node
  - hydrolix:
      table_token: table-secret
error: true
---
// Hydrolix may repeat the credentials of a request in an error response. The
// diagnostic shows the response without them.
from {id: 1}
to_hydrolix env("HYDROLIX_URL") + "/?credential=" + secret("hydrolix-url-credential"),
  token="test-token",
  table="test.echo",
  table_token="table-secret",
  headers={"X-Secret": secret("hydrolix-header"), "X-Hdx-Project": "demo"}
