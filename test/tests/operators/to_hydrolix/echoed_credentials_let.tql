---
fixtures:
  - node
  - hydrolix:
      table_token: table-secret
error: true
---
// Credentials bound by `let` are censored like inline secrets.
let $credential = secret("hydrolix-url-credential")
let $headers = {"X-Secret": secret("hydrolix-header"), "X-Hdx-Project": "demo"}
from {id: 1}
to_hydrolix env("HYDROLIX_URL") + "/?credential=" + $credential,
  token="test-token",
  table="test.echo",
  table_token="table-secret",
  headers=$headers
