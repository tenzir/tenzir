---
fixtures:
  - node
  - hydrolix:
      table_token: table-secret
---
// Hydrolix may repeat the credentials of a request in the reasons for
// rejecting events. The warning shows the reasons without them.
from {id: 1}
to_hydrolix env("HYDROLIX_URL") + "/?credential=" + secret("hydrolix-url-credential"),
  token="test-token",
  table="test.echo_partial",
  table_token="table-secret",
  headers={"X-Secret": secret("hydrolix-header"), "X-Hdx-Project": "demo"}
