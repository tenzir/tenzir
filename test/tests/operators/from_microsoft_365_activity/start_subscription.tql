---
fixtures: [microsoft_365_activity]
timeout: 60
skip:
  on: fixture-unavailable
---

from_microsoft_365_activity auth={
    tenant_id: env("MS_ACTIVITY_FIXTURE_TENANT_ID"),
    client_id: env("MS_ACTIVITY_FIXTURE_CLIENT_ID"),
    client_secret: env("MS_ACTIVITY_FIXTURE_CLIENT_SECRET"),
    authority: env("MS_ACTIVITY_FIXTURE_AUTHORITY"),
  },
  content_types=["Audit.Exchange", "Audit.SharePoint"],
  start_time=now() - 2h,
  end_time=now() - 1h,
  start_missing_subscriptions=true,
  publisher_identifier=env("MS_ACTIVITY_FIXTURE_PUBLISHER_ID"),
  _base_url=env("MS_ACTIVITY_FIXTURE_BASE_URL"),
  _subscription_start_interval=1ms,
  tls=false
