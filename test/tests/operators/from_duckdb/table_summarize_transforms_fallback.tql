// DuckDB groups by a `DOUBLE` column and computes the summary behind the
// `select` and the assignment, with the result of
// `table_summarize_transforms_fallback_local.tql`. DuckDB reads the field of
// the null struct `meta` as `NULL`, so nothing warns about it.
from_duckdb env("DUCKDB_SEED"), table="events"
select key=score, id, port=meta.port
first_id = id
summarize key, n=count(), first=min(first_id), port=max(port)
sort key
