// The optimizer moves `name != "alpha"` before the assignment with the
// nondeterministic fallback, where the query takes it with DuckDB's semantics:
// the row where `name` is null does not pass. `ts > 2024-01-02` stays behind
// the assignment.
from_duckdb env("DUCKDB_SEED"), table="events"
ts = ts else now()
where name != "alpha" and ts > 2024-01-02
select id, name
