// A `set` that reads a binding of the subpipeline keeps the summary in the
// pipeline until `every` instantiates the subpipeline, because an unresolved
// binding could fail. Once it does, `from_duckdb` takes over the stages that
// DuckDB spells, and the summary groups by the `DOUBLE` column either way.
every 1h {
  let $tag = "seen"
  from_duckdb env("DUCKDB_SEED"), table="events"
  select key=score, id
  tag = $tag
  summarize key, n=count(), first=min(id)
}
head 3
sort key
