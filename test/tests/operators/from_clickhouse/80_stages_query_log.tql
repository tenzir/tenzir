// The stages after the summaries of the earlier tests ran in ClickHouse, with
// its semantics, up to the first stage that it cannot spell.
from_clickhouse sql="SELECT query FROM system.query_log WHERE type = 'QueryFinish' AND query_kind = 'Select' AND has(tables, 'default.fc_stages') AND (query LIKE '%count()%' OR query LIKE '%maxOrNull%') ORDER BY event_time_microseconds",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
