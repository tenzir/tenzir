// A predicate on a map field runs locally, so the limit does too: the query
// reads the whole table. Rows without the key lack the field, which `?`
// tolerates.
from_clickhouse table="fc_maps",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
where catchall.class_uid? == "3002"
head 1
select id, catchall
