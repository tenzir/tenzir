// The source filters the groups, sorts them with a tie breaker, and keeps the
// first ones, all in its query.
from_clickhouse table="fc_stages",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
where sev >= 1
summarize src, events=count()
where events >= 2
sort -events, src
head 4
