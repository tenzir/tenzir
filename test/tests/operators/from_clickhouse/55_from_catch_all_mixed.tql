// The reconstructed events that the following tests filter. The string
// `"true"` regains its boolean type, the string `"7"` stays a string, and the
// empty record is gone, just like the field with a `null` value.
from_clickhouse table="fc_catch_all_mixed",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
sort id
