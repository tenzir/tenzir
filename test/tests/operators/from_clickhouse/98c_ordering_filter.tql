// The filter runs before the sort and the limit in the query, so the query
// finds two matching events beyond the first two ordered rows.
from_clickhouse table="fc_ordering",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
where message.to_upper() == "KEEP"
sort -time
head 2
select id, time
