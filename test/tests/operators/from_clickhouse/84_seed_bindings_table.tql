// A table whose columns exercise how the operator binds fields.
from_clickhouse sql="CREATE OR REPLACE TABLE fc_bindings (id UInt64, `n.x` Int64, t Tuple(x Int64), Name String, name String, j JSON, p Point, al String ALIAS concat(name, '!')) ENGINE = MergeTree ORDER BY id",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false

