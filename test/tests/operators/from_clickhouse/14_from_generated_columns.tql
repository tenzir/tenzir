from_clickhouse sql="SELECT * FROM fc_generated_columns SETTINGS asterisk_include_alias_columns = 1, asterisk_include_materialized_columns = 1",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
| select id, base, alias_col, materialized_col
