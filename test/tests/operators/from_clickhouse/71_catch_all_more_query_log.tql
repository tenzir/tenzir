// The filters of the queries against the catch-all tables of
// `65_catch_all_typed_json.tql`, which ran none, `68_catch_all_numbers.tql`,
// which pushes none, `69_catch_all_mixed_lists.tql`, whose query ClickHouse
// rejected before it started, and `69b_catch_all_suffix.tql`.
from_clickhouse sql="SELECT toString(type) AS type, replaceRegexpOne(query, '^.* WHERE ', '') AS filter FROM system.query_log WHERE type != 'QueryStart' AND query NOT LIKE '%system.query_log%' AND (has(tables, 'default.fc_catch_all_typed') OR has(tables, 'default.fc_catch_all_numbers') OR query LIKE 'SELECT * FROM fc_catch_all_mixed WHERE (`event`.`n` IN %' OR (has(tables, 'default.fc_catch_all_mixed') AND query LIKE '%endsWith%')) AND query LIKE '% WHERE %' ORDER BY event_time_microseconds",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
