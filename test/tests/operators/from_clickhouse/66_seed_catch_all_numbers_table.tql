// A catch-all table for numbers at the edges of `double`.
from_clickhouse sql="CREATE OR REPLACE TABLE fc_catch_all_numbers (id UInt32, event JSON COMMENT 'tenzir:catch_all') ENGINE = MergeTree ORDER BY id",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
