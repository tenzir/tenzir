// ClickHouse computes the summary behind a rename, a `drop`, and an
// assignment that copies a field: the `where` and the `summarize` go into
// the query over the table's columns, and the outputs keep the new names. The
// result equals that of `48_summarize_transforms_local.tql`, which runs the
// same operators locally.
from_clickhouse table="fc_pushdown",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
select key=y, ident=id, level=meta.level, value=x, junk=f
drop junk
where ident < 100
first = ident
summarize key, events=count(), hi=max(level), lo=min(value), low_id=min(first)
sort key
