// A filter with `?` stays in Tenzir, and so do the sort and the limit after
// it, which then count the events that the filter keeps.
from_clickhouse table="fc_catch_all",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
where metadata.product?.name?.to_upper() == "DEMO"
sort -time
head 1
select time, class_uid, metadata.product.name
