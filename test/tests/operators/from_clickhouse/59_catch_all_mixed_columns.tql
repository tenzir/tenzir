// The dotted column holds `src.port`, the catch-all column its sibling
// `src.host`, and the `JSON` column `extra` the field `extra.k`.
from_clickhouse table="fc_catch_all_mixed",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
where src.port == 443 and src.host.starts_with("h") and extra.k == "v"
select id
