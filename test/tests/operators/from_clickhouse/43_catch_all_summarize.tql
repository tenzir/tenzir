---
error: true
---

// A field of a catch-all table may live in any of its columns, so a summary
// fails before any query reads data. `46_catch_all_query_log.tql` checks that
// no aggregate query ran.
from_clickhouse table="fc_catch_all",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
summarize class_uid, n=count(), last=max(time)
sort class_uid
