---
error: true
---

// A field below a `JSON` column with typed paths does not bind, so the read
// fails before any query reads data.
from_clickhouse table="fc_catch_all_typed",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
where id <= 2
where typed.obj.k == "value"
