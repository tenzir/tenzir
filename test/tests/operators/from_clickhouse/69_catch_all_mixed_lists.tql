// A list with mixed types narrows the query, while TQL decides the types
// locally. Test substring and suffix separately so they cannot mask a lost row.
from_clickhouse table="fc_catch_all_mixed",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
where n in [5, "7"]
select id
sort id
