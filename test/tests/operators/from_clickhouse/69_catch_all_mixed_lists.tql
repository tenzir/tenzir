---
error: true
---

// ClickHouse rejects `IN` on a field below a `JSON` column, whose type is
// dynamic, which fails the pipeline.
from_clickhouse table="fc_catch_all_mixed",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
where n in [5, 7]
