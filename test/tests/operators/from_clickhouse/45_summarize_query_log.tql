// The summaries of the earlier tests ran in ClickHouse, while
// `39_summarize_local.tql` read the rows that the filter before the predicate
// that ClickHouse cannot spell keeps.
from_clickhouse sql="SELECT query FROM system.query_log WHERE type = 'QueryFinish' AND query_kind = 'Select' AND has(tables, 'default.fc_pushdown') AND (query LIKE '%count()%' OR query LIKE '%`x` > 0) OR (`n` IS NULL%') ORDER BY event_time_microseconds",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
