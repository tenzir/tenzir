// A catch-all table whose fields have different types in different events.
from_clickhouse sql="CREATE OR REPLACE TABLE fc_catch_all_mixed (id UInt32, `src.port` UInt16, extra JSON, event JSON COMMENT 'tenzir:catch_all') ENGINE = MergeTree ORDER BY id",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
