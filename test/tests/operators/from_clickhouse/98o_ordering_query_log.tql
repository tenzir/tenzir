// The queries of the ordering tests, in the order of the tests that ran them:
// the sorts, limits, and filters that ClickHouse computes, and the plain reads
// of the tests that keep them in Tenzir.
from_clickhouse sql="SELECT toString(type) AS type, query FROM system.query_log WHERE type != 'QueryStart' AND query_kind = 'Select' AND (has(tables, 'default.fc_ordering') OR query LIKE '% FROM fc_ordering %' OR query LIKE '% FROM fc_ordering') AND query NOT LIKE '%system.query_log%' ORDER BY event_time_microseconds",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
