// ClickHouse counts conditionally and distinctly, sums, and averages, with the
// result of the same operators in the pipeline.
from_clickhouse table="fc_pushdown",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
summarize y, big=count_if(x, v => v > 0), kinds=count_distinct(x), total=sum(x), avg=mean(x)
sort y
