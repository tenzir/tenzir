// The filters of the queries against catch-all tables, in the order of the
// tests that ran them. `60_catch_all_mixed_local.tql` pushes no filter.
from_clickhouse sql="SELECT replaceRegexpOne(query, '^.* WHERE ', '') AS filter FROM system.query_log WHERE type = 'QueryFinish' AND query_kind = 'Select' AND (has(tables, 'default.fc_catch_all') OR has(tables, 'default.fc_catch_all_mixed')) AND query LIKE '% WHERE %' AND query NOT LIKE '%system.query_log%' ORDER BY event_time_microseconds",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
