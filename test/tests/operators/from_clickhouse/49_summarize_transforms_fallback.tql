// ClickHouse groups by a `Float64` column behind a rename, with its own
// semantics.
from_clickhouse table="fc_pushdown",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
select key=f, ident=id
where ident < 100
summarize key, events=count(), hi=max(ident)
sort key
