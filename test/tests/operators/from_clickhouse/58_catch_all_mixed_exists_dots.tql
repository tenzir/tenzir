// A field access with `?` stays in Tenzir, with the operators after it. A
// record exists, and the literal key `a.b` differs from the nested field `a.b`.
from_clickhouse table="fc_catch_all_mixed",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
where obj? != null or this["a.b"]? == "dot"
select id
sort id
