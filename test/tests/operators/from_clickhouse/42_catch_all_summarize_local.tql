// A field access with `?` stays in Tenzir, and so does the summary after it,
// which runs on the reconstructed events.
from_clickhouse table="fc_catch_all",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
where this["metadata"]?.product?.name? == "Demo"
summarize metadata.product.name, n=count()
sort metadata.product.name
