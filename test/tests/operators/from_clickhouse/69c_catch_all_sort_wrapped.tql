---
error: true
---

// A sort by a field of the catch-all column whose order a later stage needs
// fails before any query reads data.
from_clickhouse table="fc_catch_all_mixed",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
sort src.host
head 1
sort id
