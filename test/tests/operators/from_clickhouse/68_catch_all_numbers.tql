// An integer above `2^53` rounds onto the literal, so the pushed comparison
// includes it, and the local one drops row 4 (likewise rows 8/9 at -2^53).
// The smallest subnormal number needs precise parsing of its text.
// The string, list, and adjacent floating-point value stay apart
// from numbers locally.
from_clickhouse table="fc_catch_all_numbers",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
where v > 9007199254740992 or v < -9007199254740992 or (v > 0.0 and v < 0.000000001) or v == 0.1
select id
sort id
