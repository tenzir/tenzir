// The aggregation of `47_summarize_transforms.tql` ran in ClickHouse over the
// table's columns, while `48_summarize_transforms_local.tql` and
// `49_summarize_transforms_fallback.tql` read the rows.
from_clickhouse sql="SELECT query FROM system.query_log WHERE type = 'QueryFinish' AND query_kind = 'Select' AND has(tables, 'default.fc_pushdown') AND query LIKE '%`id` < 100%' ORDER BY event_time_microseconds",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
