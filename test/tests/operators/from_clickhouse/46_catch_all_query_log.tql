// The summary of `43_catch_all_summarize.tql` failed before any query read
// data, while `42_catch_all_summarize_local.tql` summarized in Tenzir.
from_clickhouse sql="SELECT count() AS aggregate_queries FROM system.query_log WHERE type != 'QueryStart' AND has(tables, 'default.fc_catch_all') AND query LIKE '%count(%'",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
