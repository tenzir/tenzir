// No aggregate query ran against the catch-all table of
// `42_catch_all_summarize_local.tql` and `43_catch_all_summarize.tql`.
from_clickhouse sql="SELECT count() AS aggregate_queries FROM system.query_log WHERE type = 'QueryFinish' AND has(tables, 'default.fc_catch_all') AND query LIKE '%__tenzir_aggregate_%'",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
