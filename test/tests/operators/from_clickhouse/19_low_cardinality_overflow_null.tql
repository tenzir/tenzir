from_clickhouse sql="SELECT CAST(toDate32('2263-01-01'), 'LowCardinality(Date32)') AS too_late_lc, toUInt64(7) AS ok SETTINGS allow_suspicious_low_cardinality_types = 1, low_cardinality_allow_in_native_format = 0",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
