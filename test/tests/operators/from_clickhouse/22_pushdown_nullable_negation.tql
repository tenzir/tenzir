// ClickHouse computes `n = 1` as `NULL` for a `NULL`, and so its negation, so
// `not (n == 1)` drops the null rows, unlike in TQL (see
// `30g_pushdown_false.tql`).
from_clickhouse table="fc_pushdown",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
where not (n == 1)
select id, n
