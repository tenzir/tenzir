// Predicates on plain and dotted columns go into the query. Those on fields of
// the catch-all column narrow the query and also apply to the reconstructed
// events, as does the projection. `62_catch_all_query_log.tql` checks the
// query.
from_clickhouse table="fc_catch_all",
                host=env("CLICKHOUSE_HOST"),
                port=int(env("CLICKHOUSE_PORT")),
                password=env("CLICKHOUSE_PASSWORD"),
                tls=false
where class_uid == 4001
where src_endpoint.port == 443 and metadata.product.name == "Demo"
where this["a.b"] == 1 and event? == null
select time, src_endpoint, a
