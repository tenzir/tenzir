// An arm without output still receives every event that `match` routes to it,
// although the filter behind `match` moves in front of it.
from {id: 1, k: "a", b: 0},
     {id: 2, k: "a", b: 42},
     {id: 3, k: "b", b: 42},
     {id: 4, k: null, b: 0}
match k {
  "a" => {
    sort id
    to_stdout {
      write_ndjson
    }
  }
  _ => {
    y = b
  }
}
where y == 42
discard
