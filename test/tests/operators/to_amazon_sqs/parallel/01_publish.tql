// parallelism: 4
// Each instance opens its own SQS client; together they publish every event
// exactly once. Order across instances is not guaranteed.
from {id: 11}, {id: 12}, {id: 13}, {id: 14}, {id: 15}, {id: 16}, {id: 17}, {id: 18}
to_amazon_sqs env("LOCALSTACK_SQS_QUEUE_SAVE"), aws_iam={
  access_key_id: "test",
  secret_access_key: "test",
  region: "us-east-1"
}
