// Packets without lengths get the size of their data. A packet with only an
// original length is truncated.
from {
  linktype: uint(1),
  timestamp: 2020-01-02T03:04:05.123456789Z,
  data: b"\x00\x01\x02",
}, {
  linktype: uint(1),
  timestamp: 2020-01-02T03:04:06.123456789Z,
  original_packet_length: uint(1500),
  data: b"\x00\x01",
}
@name = "pcap.packet"
write_pcap
read_pcap
