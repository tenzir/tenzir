---
fixtures:
  - http_connect_proxy:
      default_port: true
      target_san: ["DNS:other.example"]
error: true
timeout: 60
---

// The certificate is issued by a trusted CA, but for a different host.
from {value: 42}
to_http env("HTTP_PROXY_FIXTURE_URL"), max_retry_count=0,
  tls={cacert: env("HTTP_PROXY_FIXTURE_CAFILE")} {
  write_ndjson
}
