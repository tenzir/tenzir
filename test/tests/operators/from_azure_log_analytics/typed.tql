---
fixtures:
  - azure_log_analytics:
      case: typed
timeout: 60
assertions:
  fixtures:
    azure_log_analytics:
      queries: 1
      tokens: 1
---

from_azure_log_analytics env("AZLOG_QUERY"),
  workspace_id=env("AZLOG_WORKSPACE"),
  azure_auth={
    tenant_id: "fixture-tenant",
    client_id: "fixture-client",
    client_secret: "fixture-secret",
    authority: env("AZLOG_AUTHORITY"),
  },
  _base_url=env("AZLOG_URL"),
  tls=false
Types = {
  TimeGenerated: type_kind(TimeGenerated),
  Count: type_kind(Count),
  Small: type_kind(Small),
  Ratio: type_kind(Ratio),
  Enabled: type_kind(Enabled),
  Message: type_kind(Message),
  Elapsed: type_kind(Elapsed),
  Amount: type_kind(Amount),
  NullTime: type_kind(NullTime),
  NestedString: type_kind(Details.text),
}
