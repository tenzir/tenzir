---
fixtures:
  - azure_log_analytics:
      case: pushdown
      rows: [0, 3]
timeout: 60
assertions:
  fixtures:
    azure_log_analytics:
      queries: 1
      tokens: 1
      appended: |-

        | where (gettype(column_ifexists('Flag', dynamic(null))) !in ("bool") or tobool(column_ifexists('Flag', dynamic(null))) == true)
---

// The service returns rows 0 and 3.
from_azure_log_analytics env("AZLOG_QUERY"),
  workspace_id=env("AZLOG_WORKSPACE"),
  azure_auth={
    tenant_id: "fixture-tenant",
    client_id: "fixture-client",
    client_secret: "fixture-secret",
    authority: env("AZLOG_AUTHORITY"),
  },
  _base_url=env("AZLOG_URL"),
  tls=false
where Flag
