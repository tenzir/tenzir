---
fixtures:
  - azure_log_analytics:
      case: "pushdown"
      rows: [0, 3, 4]
timeout: 60
assertions:
  fixtures:
    azure_log_analytics:
      queries: 1
      tokens: 1
      appended: " // ends in a comment\n| where (['Port'] >= 443)"
---

// Stages start on a new line, after a trailing comment.
from_azure_log_analytics env("AZLOG_QUERY") + " // ends in a comment",
  workspace_id=env("AZLOG_WORKSPACE"),
  azure_auth={
    tenant_id: "fixture-tenant",
    client_id: "fixture-client",
    client_secret: "fixture-secret",
    authority: env("AZLOG_AUTHORITY"),
  },
  _base_url=env("AZLOG_URL"),
  tls=false
where Port >= 443
