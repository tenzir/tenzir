---
fixtures:
  - azure_log_analytics:
      case: "pushdown"
      rows: [0, 3, 4]
      project: ["Name"]
timeout: 60
assertions:
  fixtures:
    azure_log_analytics:
      queries: 1
      tokens: 1
      appended: |-

        | where (['Port'] >= 443)
        | project ['Name']
---

// The filter and the selection run in Log Analytics. The service returns
// rows 0, 3, and 4 with the selected column.
from_azure_log_analytics env("AZLOG_QUERY"),
  workspace_id=env("AZLOG_WORKSPACE"),
  azure_auth={
    tenant_id: "fixture-tenant",
    client_id: "fixture-client",
    client_secret: "fixture-secret",
    authority: env("AZLOG_AUTHORITY"),
  },
  _base_url=env("AZLOG_URL"),
  tls=false
where Port >= 443
select Name
