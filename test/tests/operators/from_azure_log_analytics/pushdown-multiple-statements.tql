---
fixtures:
  - azure_log_analytics:
      case: "multiple"
timeout: 60
assertions:
  fixtures:
    azure_log_analytics:
      queries: 1
      tokens: 1
      appended: ";\nprint Value = \"second\""
---

// Every tabular statement returns a table, and appended stages would apply
// to the last one only, so the operator appends no stages and the filter
// runs in Tenzir on the rows of every table.
from_azure_log_analytics env("AZLOG_QUERY") + ";\nprint Value = \"second\"",
  workspace_id=env("AZLOG_WORKSPACE"),
  azure_auth={
    tenant_id: "fixture-tenant",
    client_id: "fixture-client",
    client_secret: "fixture-secret",
    authority: env("AZLOG_AUTHORITY"),
  },
  _base_url=env("AZLOG_URL"),
  tls=false
where Value == "second"
