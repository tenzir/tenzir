---
fixtures:
  - azure_log_analytics:
      case: observables
      rows: [3, 4, 8, 11]
      project: [Id, ProcessCommandLine]
timeout: 60
assertions:
  fixtures:
    azure_log_analytics:
      appended: |-

        | where (gettype(column_ifexists('ProcessCommandLine', dynamic(null))) !in ("string") or tostring(column_ifexists('ProcessCommandLine', dynamic(null))) contains "powershell" or tostring(column_ifexists('ProcessCommandLine', dynamic(null))) matches regex @'[^\x00-\x7F]' or tostring(column_ifexists('ProcessCommandLine', dynamic(null))) matches regex @'^[ \t\r\n]*[\[{]' or tostring(column_ifexists('ProcessCommandLine', dynamic(null))) matches regex @'^[ \t\r\n]*"') and (gettype(column_ifexists('ProcessCommandLine', dynamic(null))) !in ("string") or tostring(column_ifexists('ProcessCommandLine', dynamic(null))) contains "-enc" or tostring(column_ifexists('ProcessCommandLine', dynamic(null))) matches regex @'[^\x00-\x7F]' or tostring(column_ifexists('ProcessCommandLine', dynamic(null))) matches regex @'^[ \t\r\n]*[\[{]' or tostring(column_ifexists('ProcessCommandLine', dynamic(null))) matches regex @'^[ \t\r\n]*"')
        | project ['Id'] = column_ifexists('Id', dynamic(null)), ['ProcessCommandLine'] = column_ifexists('ProcessCommandLine', dynamic(null))
---

// The fixture checks the exact candidate query; the full predicate remains local.
from_azure_log_analytics env("AZLOG_QUERY"),
  workspace_id=env("AZLOG_WORKSPACE"),
  azure_auth={
    tenant_id: "fixture-tenant",
    client_id: "fixture-client",
    client_secret: "fixture-secret",
    authority: env("AZLOG_AUTHORITY"),
  },
  _base_url=env("AZLOG_URL"),
  tls=false
where ProcessCommandLine.search("powershell", ignore_case=true) and ProcessCommandLine.search("-enc", ignore_case=true)
select Id
