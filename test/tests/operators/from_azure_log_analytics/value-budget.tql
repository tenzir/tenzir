---
fixtures:
  - azure_log_analytics:
      case: value-budget
timeout: 60
assertions:
  fixtures:
    azure_log_analytics:
      queries: 1
      tokens: 1
      appended: "\n| project ['Value'] = column_ifexists('Value', dynamic(null))"
---

// A dynamic value of 2 Mi nodes decodes: the decoded value budget scales with
// the response size limit.
from_azure_log_analytics env("AZLOG_QUERY"),
  workspace_id=env("AZLOG_WORKSPACE"),
  azure_auth={
    tenant_id: "fixture-tenant",
    client_id: "fixture-client",
    client_secret: "fixture-secret",
    authority: env("AZLOG_AUTHORITY"),
  },
  _base_url=env("AZLOG_URL"),
  tls=false,
  pushdown=false
select nodes=Value.length()
