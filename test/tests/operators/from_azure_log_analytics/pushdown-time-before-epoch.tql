---
fixtures:
  - azure_log_analytics:
      case: timestamps
      bounded: true
      query: "  Events\n| project Id, EventTime = TimeGenerated, DeviceName, RemotePort, RemoteUrl, TextTime, Dyn  "
      rows: [8,9,10]
      project: ["Id","EventTime"]
timeout: 60
assertions:
  fixtures:
    azure_log_analytics:
      appended: |-

        | where (gettype(column_ifexists('EventTime', dynamic(null))) != "datetime" or todatetime(column_ifexists('EventTime', dynamic(null))) < datetime(1900-01-01) or todatetime(column_ifexists('EventTime', dynamic(null))) >= datetime(2262-01-01) or todatetime(column_ifexists('EventTime', dynamic(null))) <= datetime(1970-01-01T00:00:00.000001Z))
        | project ['Id'] = column_ifexists('Id', dynamic(null)), ['EventTime'] = column_ifexists('EventTime', dynamic(null))
---

// The exact filter runs after the conservative prefilter and before head.
from_azure_log_analytics env("AZLOG_QUERY"),
  workspace_id=env("AZLOG_WORKSPACE"),
  azure_auth={
    tenant_id: "fixture-tenant",
    client_id: "fixture-client",
    client_secret: "fixture-secret",
    authority: env("AZLOG_AUTHORITY"),
  },
  _base_url=env("AZLOG_URL"),
  tls=false,
  start=2026-01-01,
  end=2026-01-02
where EventTime < 1969-12-31T23:59:59.9999999Z
select Id
