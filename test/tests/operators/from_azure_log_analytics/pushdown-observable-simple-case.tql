---
fixtures:
  - azure_log_analytics:
      case: observable-adversarial
      rows: [2, 3, 4, 5, 6, 7]
      project: [Id, Value]
timeout: 60
assertions:
  fixtures:
    azure_log_analytics:
      appended: |-

        | where (gettype(column_ifexists('Value', dynamic(null))) !in ("string") or tostring(column_ifexists('Value', dynamic(null))) =~ "i" or tostring(column_ifexists('Value', dynamic(null))) matches regex @'[^\x00-\x7F]' or tostring(column_ifexists('Value', dynamic(null))) matches regex @'^[ \t\r\n]*"')
        | project ['Id'] = column_ifexists('Id', dynamic(null)), ['Value'] = column_ifexists('Value', dynamic(null))
---

// The fixture checks the exact candidate query; the full predicate remains local.
from_azure_log_analytics env("AZLOG_QUERY"),
  workspace_id=env("AZLOG_WORKSPACE"),
  azure_auth={
    tenant_id: "fixture-tenant",
    client_id: "fixture-client",
    client_secret: "fixture-secret",
    authority: env("AZLOG_AUTHORITY"),
  },
  _base_url=env("AZLOG_URL"),
  tls=false
where Value.to_lower() == "i"
select Id
