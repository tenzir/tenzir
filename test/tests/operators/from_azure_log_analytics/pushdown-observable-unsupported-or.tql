---
fixtures:
  - azure_log_analytics:
      case: observables
      project: [Id, AccountName, ProcessCommandLine]
timeout: 60
assertions:
  fixtures:
    azure_log_analytics:
      appended: |-

        | project ['Id'] = column_ifexists('Id', dynamic(null)), ['AccountName'] = column_ifexists('AccountName', dynamic(null)), ['ProcessCommandLine'] = column_ifexists('ProcessCommandLine', dynamic(null))
---

// The fixture checks the exact candidate query; the full predicate remains local.
from_azure_log_analytics env("AZLOG_QUERY"),
  workspace_id=env("AZLOG_WORKSPACE"),
  azure_auth={
    tenant_id: "fixture-tenant",
    client_id: "fixture-client",
    client_secret: "fixture-secret",
    authority: env("AZLOG_AUTHORITY"),
  },
  _base_url=env("AZLOG_URL"),
  tls=false
where AccountName.to_lower() == "alice" or ProcessCommandLine.match_regex("^backup")
select Id
