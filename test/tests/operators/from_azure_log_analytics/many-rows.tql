---
fixtures:
  - azure_log_analytics:
      case: many-rows
timeout: 60
assertions:
  fixtures:
    azure_log_analytics:
      queries: 1
      tokens: 1
      appended: ""
---

// With `pushdown=false`, the summary runs in Tenzir over every decoded row.
from_azure_log_analytics env("AZLOG_QUERY"),
  workspace_id=env("AZLOG_WORKSPACE"),
  azure_auth={
    tenant_id: "fixture-tenant",
    client_id: "fixture-client",
    client_secret: "fixture-secret",
    authority: env("AZLOG_AUTHORITY"),
  },
  _base_url=env("AZLOG_URL"),
  tls=false,
  pushdown=false
summarize Count=count(), Min=min(Value), Max=max(Value)
