---
fixtures:
  - azure_log_analytics:
      case: pushdown
timeout: 60
assertions:
  fixtures:
    azure_log_analytics:
      queries: 1
      tokens: 1
      appended: " // comment\r| render table"
---

// Kusto ends a comment at CR, too, so `render` is code here and the query
// stays unchanged.
from_azure_log_analytics env("AZLOG_QUERY") + " // comment\r| render table",
  workspace_id=env("AZLOG_WORKSPACE"),
  azure_auth={
    tenant_id: "fixture-tenant",
    client_id: "fixture-client",
    client_secret: "fixture-secret",
    authority: env("AZLOG_AUTHORITY"),
  },
  _base_url=env("AZLOG_URL"),
  tls=false
where Port >= 443
head 1
