---
fixtures:
  - azure_log_analytics:
      case: "pushdown"
      rows: [0]
      project: ["Id", "Name", "Addr", "Port", "Flag"]
timeout: 60
assertions:
  fixtures:
    azure_log_analytics:
      queries: 1
      tokens: 1
      appended: |-

        | project-away ['Ident'], ['Amount'], ['Dyn']
---

// A drop runs in Log Analytics. The service returns row 0 without the
// dropped columns.
from_azure_log_analytics env("AZLOG_QUERY"),
  workspace_id=env("AZLOG_WORKSPACE"),
  azure_auth={
    tenant_id: "fixture-tenant",
    client_id: "fixture-client",
    client_secret: "fixture-secret",
    authority: env("AZLOG_AUTHORITY"),
  },
  _base_url=env("AZLOG_URL"),
  tls=false
drop Ident, Amount, Dyn
