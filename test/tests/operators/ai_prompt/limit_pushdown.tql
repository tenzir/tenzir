---
fixtures:
  - openai_responses
  - read_pushdown:
      format: parquet
timeout: 60
assertions:
  fixtures:
    openai_responses:
      inputs: ['{"id":0}', '{"id":1}']
---

// The limit passes `ai_prompt`, so the reader never decodes the corrupted
// second row group, and only two requests go out.
from_file f"{env("READ_PUSHDOWN_ROOT")}/corrupt-lookahead" {
  read_parquet
}
ai_prompt model="fixture-model",
           endpoint=env("OPENAI_RESPONSES_FIXTURE_ENDPOINT"),
           data={id: id}
select id, text=ai.prompt.text
head 2
