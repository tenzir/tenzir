---
fixtures: [openai_responses]
timeout: 60
assertions:
  fixtures:
    openai_responses:
      inputs: ['{"id":1,"mode":"missing_metadata"}', '{"id":2,"mode":"partial_usage"}']
---

from {id: 1, mode: "missing_metadata"}, {id: 2, mode: "partial_usage"}
ai_prompt model="fixture-model",
           endpoint=env("OPENAI_RESPONSES_FIXTURE_ENDPOINT"),
           concurrency=2
select id, model=ai.prompt.model, usage=ai.prompt.usage
