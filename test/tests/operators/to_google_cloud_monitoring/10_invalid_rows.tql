from {metric: "tenzir/bad name", value: 1},
     {metric: "", value: 1},
     {metric: "tenzir/valid", value: "one"},
     {metric: "tenzir/valid", value: null},
     {metric: "tenzir/valid", value: 1, type: "guage"},
     {metric: "tenzir/valid", value: 1, labels: {"A-B": "x", a_b: "y"}},
     {metric: "tenzir/valid", value: 1, labels: "not-a-record"},
     {metric: "tenzir/valid", value: 1, timestamp: 2025-12-30T00:00:00Z},
     {metric: "tenzir/valid", value: 1, timestamp: 2026-01-01T00:10:00Z},
     {metric: "tenzir/valid", value: 1.0e999},
     {metric: "tenzir/valid", value: 1, labels: {"Service.Name": "yes", "0": "z", "a-b": "w"}}
to_google_cloud_monitoring project="test-project",
  service_credentials=env("GOOGLE_CLOUD_MONITORING_CREDENTIALS"),
  resource_type="generic_node",
  resource_labels={location: "global", namespace: "tenzir", node_id: "n1"},
  _api_url=env("GOOGLE_CLOUD_MONITORING_URL"),
  _now=2026-01-01T00:01:00Z
