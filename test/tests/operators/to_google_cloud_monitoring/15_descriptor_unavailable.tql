// A failed descriptor lookup skips the events of that metric for a while
// instead of asking Cloud Monitoring again for every event.
from {metric: "tenzir/broken/gauge", value: 1, timestamp: 2026-01-01T00:00:00Z},
     {metric: "tenzir/broken/gauge", value: 2, timestamp: 2026-01-01T00:00:10Z},
     {metric: "tenzir/working", value: 3, timestamp: 2026-01-01T00:00:10Z}
to_google_cloud_monitoring project="test-project",
  service_credentials=env("GOOGLE_CLOUD_MONITORING_CREDENTIALS"),
  resource_type="generic_node",
  resource_labels={location: "global", namespace: "tenzir", node_id: "n1"},
  max_retry_count=0,
  _api_url=env("GOOGLE_CLOUD_MONITORING_URL"),
  _now=2026-01-01T00:01:00Z
