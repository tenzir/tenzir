// An invalid unit makes the operator create the descriptor without description
// and unit. A failed creation skips the events of that metric instead of
// writing them against an unconfirmed descriptor.
from {metric: "tenzir/bad_unit", value: 1, help: "Bad unit", unit: "invalid-unit"},
     {metric: "tenzir/quota/gauge", value: 2},
     {metric: "tenzir/quota/gauge", value: 3, labels: {other: "series"}}
timestamp = 2026-01-01T00:00:00Z
to_google_cloud_monitoring project="test-project",
  service_credentials=env("GOOGLE_CLOUD_MONITORING_CREDENTIALS"),
  resource_type="generic_node",
  resource_labels={location: "global", namespace: "tenzir", node_id: "n1"},
  max_retry_count=0,
  _api_url=env("GOOGLE_CLOUD_MONITORING_URL"),
  _now=2026-01-01T00:01:00Z
