---
fixtures: [node]
---

// Secrets can be used within expressions, but assigning them to a field stores
// `"***"` instead, including when they are nested in records or lists.
from {key: "a", value: "The quick brown fox jumps over the lazy dog", n: 1},
     {key: "b", value: "x", n: 2}
top = secret("censor-key")
nested = {inner: secret("censor-key"), other: 1}
list = [secret("censor-key"), "plain"]
mixed = secret("censor-key") if n == 1 else "plain"
dynamic[key] = secret("censor-key")
digest = hmac(value, secret("censor-key"))
