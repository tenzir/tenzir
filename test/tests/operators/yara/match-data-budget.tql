from_stdin {
  yara rules=r#"
rule large_matches {
  strings:
    $a = ""
  condition:
    #a > 6000
}
"#, max_matches_per_pattern=999999
}
select matches_complete=evidences[0].data.matches_complete,
       match_count=evidences[0].data.matches.length(),
       first_has_data=evidences[0].data.matches[0].data != null,
       last_has_data=evidences[0].data.matches[-1].data != null
