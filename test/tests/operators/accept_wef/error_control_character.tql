---
error: true
fixtures:
  - wef:
      steps: []
---

// XML does not allow most control characters, so clients could not parse a
// subscription with this name.
accept_wef "127.0.0.1:0",
  tls={
    certfile: env("WEF_CERTFILE"),
    keyfile: env("WEF_KEYFILE"),
    client_ca: env("WEF_CAFILE"),
    require_client_cert: true,
  },
  subscriptions=[{
    id: "x",
    name: "bell\x07",
    query: "<QueryList><Query Id='0'><Select Path='Security'>*</Select></Query></QueryList>",
  }]
