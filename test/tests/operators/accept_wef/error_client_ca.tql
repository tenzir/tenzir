---
error: true
fixtures:
  - wef:
      steps: []
---

// The issuer thumbprint comes from the CA certificates in `client_ca`.
accept_wef "127.0.0.1:0",
  tls={
    certfile: env("WEF_CERTFILE"),
    keyfile: env("WEF_KEYFILE"),
    client_ca: env("WEF_KEYFILE"),
    require_client_cert: true,
  },
  subscriptions=[{id: "x", query: "<QueryList><Query Id='0'><Select Path='Security'>*</Select></Query></QueryList>"}]
