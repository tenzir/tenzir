---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/strings/services/search/v2/jobs/export
      body: search=search%20index%3D%22main%22%20action%3D%2A%0A%7C%20fields%20%2A&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// The operator takes over stages up to the first one that SPL cannot spell.
// The stages after it stay in Tenzir, also those that SPL could spell.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/strings",
  index="main", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false
where action != null
where src_ip.string().length_bytes() > 9
head 2
