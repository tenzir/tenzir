---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/strings/services/search/v2/jobs/export
      body: search=search%20index%3Dmain%0A%7C%20where%20%28match%28%27user%27%2C%20%22%5E%5Bab%5D%22%29%20OR%20%28%27n%27%20%3D%3D%207%29%29%0A%7C%20fields%20%2A&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// Calls with an SPL spelling, such as regular expressions, run in a `where`
// stage.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/strings",
  search="search index=main", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false
where user.match_regex("^[ab]") or n == 7
