---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/aggregate-ok/services/search/v2/jobs/export
      body: search=search%20index%3Dmain%0A%7C%20search%20n%3E6%0A%7C%20where%20%28isnull%28user%29%20OR%20mvcount%28user%29%3E1%20OR%20if%28user%3D%3D%22bob%22%2C%20false%28%29%2C%20true%28%29%29%29%0A%7C%20fields%20user%2C%20action%2C%20n&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// Pushed filters, also the `where` stage of a negation, only preselect
// candidates, so the summary of the events that pass them runs in Tenzir.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/aggregate-ok",
  search="search index=main", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false
where user != "bob" and n > 6
summarize user, events=count(), actions=count(action), lo=min(n), hi=max(n)
