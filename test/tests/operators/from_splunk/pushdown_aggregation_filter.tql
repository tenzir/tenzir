---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/aggregate-ok/services/search/v2/jobs/export
      body: search=search%20index%3Dmain%0A%7C%20where%20%28%27user%27%20%21%3D%20%22bob%22%29%0A%7C%20where%20in%28%27action%27%2C%20%22login%22%2C%20%22logout%22%29%0A%7C%20where%20%28%28%27flag%27%20%3D%3D%20%22true%22%29%20OR%20isnull%28%27n%27%29%29%0A%7C%20stats%20count%20as%20tenzir_column_0%2C%20count%28action%29%20as%20tenzir_column_1%2C%20min%28n%29%20as%20tenzir_column_2%2C%20max%28n%29%20as%20tenzir_column_3%20by%20user%0A%7C%20appendpipe%20%5Bstats%20count%20as%20tenzir_groups_0%5D&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// Filters before the summary become `where` stages after a user's search,
// which compare exactly, as Splunk does.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/aggregate-ok",
  search="search index=main", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false
where user != "bob" and action in ["login", "logout"]
where flag == true or n == null
summarize user, events=count(), actions=count(action), lo=min(n), hi=max(n)
