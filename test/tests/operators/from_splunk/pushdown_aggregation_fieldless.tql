---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/aggregate-ok/services/search/v2/jobs/export
      body: search=%7C%20makeresults%20%7C%20fields%20-%20_time%0A%7C%20fields%20user%2C%20action%2C%20n&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// Splunk returns no results for a search whose results have no fields, which
// `stats` would still count. The summary of a search with `fields -` therefore
// stays in Tenzir.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/aggregate-ok",
  search="| makeresults | fields - _time", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false
summarize user, events=count(), actions=count(action), lo=min(n), hi=max(n)
sort user.string()
