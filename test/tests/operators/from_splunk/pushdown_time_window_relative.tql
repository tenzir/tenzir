---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/strings/services/search/v2/jobs/export
      body: search=search%20index%3D%22main%22%20_time%3C%3D1735689720%0A%7C%20fields%20user%2C%20_time&earliest_time=-15m&latest_time=1735689780&output_mode=json&preview=false
---

// A relative bound resolves on the server, so the operator cannot tell whether
// narrowed bounds would cross, and keeps both as they are. The comparison in
// the search still holds.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/strings",
  index="main", earliest="-15m", latest="1735689780",
  headers={Authorization: "Splunk test-token"}, tls=false
where _time <= 2025-01-01T00:02:00Z
select user, _time
