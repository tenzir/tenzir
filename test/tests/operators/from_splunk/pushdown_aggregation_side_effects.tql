---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/aggregate-ok/services/search/v2/jobs/export
      body: search=search%20index%3Dmain%20%7C%20outputlookup%20users.csv%0A%7C%20stats%20count%20as%20tenzir_column_0%2C%20count%28action%29%20as%20tenzir_column_1%2C%20min%28n%29%20as%20tenzir_column_2%2C%20max%28n%29%20as%20tenzir_column_3%20by%20user%0A%7C%20appendpipe%20%5Bstats%20count%20as%20tenzir_groups_0%5D&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// `stats` reads every result of a search with side effects, so it goes into
// the search, but a `head` stage could cut `outputlookup` short and stays in
// Tenzir.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/aggregate-ok",
  search="search index=main | outputlookup users.csv", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false
summarize user, events=count(), actions=count(action), lo=min(n), hi=max(n)
head 1
