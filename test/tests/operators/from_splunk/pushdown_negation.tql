---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/strings/services/search/v2/jobs/export
      body: search=search%20index%3Dmain%0A%7C%20where%20%28isnull%28user%29%20OR%20mvcount%28user%29%3E1%20OR%20if%28user%3D%3D%22alice%22%2C%20false%28%29%2C%20true%28%29%29%29%20AND%20%28isnull%28n%29%20OR%20mvcount%28n%29%3E1%20OR%20if%28n%3D%3D50%2C%20false%28%29%2C%20true%28%29%29%29%0A%7C%20fields%20n%2C%20user&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// Negations keep events without the field, as TQL does.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/strings",
  search="index=main", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false
where user != "alice" and n != 50
select user, n
