---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/strings/services/search/v2/jobs/export
      body: search=search%20index%3Dmain%0A%7C%20where%20%28%27user%27%20%21%3D%20%22alice%22%29%0A%7C%20where%20%28%27n%27%20%21%3D%2050%29%0A%7C%20fields%20user%2C%20n&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// Negations become `where` stages, which drop results without the field, as
// Splunk does.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/strings",
  search="index=main", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false
where user != "alice" and n != 50
select user, n
