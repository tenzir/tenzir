---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/strings/services/search/v2/jobs/export
      body: search=search%20index%3Dmain%0A%7C%20search%20_time%3E%3D1735689630%20_time%3C%3D1735689720%0A%7C%20fields%20_time%2C%20user&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// `_time` bounds round outwards to whole seconds.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/strings",
  search="search index=main", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false
where _time >= 2025-01-01T00:00:30.5Z and _time < 2025-01-01T00:02:00Z
select user, _time
