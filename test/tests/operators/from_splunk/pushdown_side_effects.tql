---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/strings/services/search/v2/jobs/export
      body: search=search%20index%3Dmain%20%7C%20outputlookup%20users.csv%0A%7C%20fields%20user&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// A `head` stage could cut `outputlookup` short, so the limit stays local.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/strings",
  search="search index=main | outputlookup users.csv", earliest="-15m",
  latest="-5m", headers={Authorization: "Splunk test-token"}, tls=false
head 1
select user
