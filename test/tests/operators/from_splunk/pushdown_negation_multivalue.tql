---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/strings/services/search/v2/jobs/export
      body: search=search%20index%3Dmain%0A%7C%20fields%20tags%2C%20user&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// Optional fields have no spelling in SPL, so these filters stay in Tenzir,
// where a list differs from every string.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/strings",
  search="index=main", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false
where tags? != "a" and not (tags? in ["c"])
select user, tags=tags?
