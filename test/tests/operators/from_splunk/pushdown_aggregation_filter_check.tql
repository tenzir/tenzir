    - method: POST
      path: /splunk/aggregate-flagged/services/search/v2/jobs/export
      body_pattern: search=search%20index%3Dmain%0A%7C%20where%20%28mvcount%28%27n%27%29%3D%3D1%20AND%20%28%28match%28%27n%27%2C%20%22%5E\-%3F%5B0\-9%5D%7B1%2C15%7D%24%22%29%20AND%20tonumber%28%27n%27%29%3E6%29%20OR%20%28NOT%20match%28%27n%27%2C%20%22%5E\-%3F%5B0\-9%5D%7B1%2C15%7D%24%22%29%20AND%20match%28%27n%27%2C%20%22%5B0\-9%5D%7C%5BiI%5D%5BnN%5D%5BfF%5D%7C%5BnN%5D%5BaA%5D%5BnN%5D%22%29%29%29%29%0A%7C%20eval%20tenzir_filter_check%3Dif%28%28mvcount%28%27n%27%29%3D%3D1%20AND%20match%28%27n%27%2C%20%22%5E\-%3F%5B0\-9%5D%7B1%2C15%7D%24%22%29%20AND%20tonumber%28%27n%27%29%3E6%29%2C%200%2C%201%29%0A%7C%20eval%20tenzir_aggregate_0%3Dcase%28isnull%28%27user%27%29%2C%20%22n%22%2C%20mvcount%28%27user%27%29%21%3D1%2C%20%22m%22%2C%20match%28%27user%27%2C%20%22%5Cx00%22%29%2C%20%22z%22%2C%20true%28%29%2C%20%22v%22%20\.%20%27user%27%29%0A%7C%20stats%20count%20as%20tenzir_count%2C%20max%28tenzir_filter_check%29%20as%20tenzir_filter_check%20by%20tenzir_aggregate_0%0A%7C%20appendpipe%20%5Bstats%20count%20as%20tenzir_groups%5D\&earliest_time=\-15m\&latest_time=\-5m\&now=[0-9]+\&output_mode=json\&preview=false
    - method: POST
      path: /splunk/aggregate-flagged/services/search/v2/jobs/export
      body_pattern: search=search%20index%3Dmain%0A%7C%20where%20%28mvcount%28%27n%27%29%3D%3D1%20AND%20%28%28match%28%27n%27%2C%20%22%5E\-%3F%5B0\-9%5D%7B1%2C15%7D%24%22%29%20AND%20tonumber%28%27n%27%29%3E6%29%20OR%20%28NOT%20match%28%27n%27%2C%20%22%5E\-%3F%5B0\-9%5D%7B1%2C15%7D%24%22%29%20AND%20match%28%27n%27%2C%20%22%5B0\-9%5D%7C%5BiI%5D%5BnN%5D%5BfF%5D%7C%5BnN%5D%5BaA%5D%5BnN%5D%22%29%29%29%29%0A%7C%20fields%20user%2C%20n\&earliest_time=\-15m\&latest_time=\-5m\&now=[0-9]+\&output_mode=json\&preview=false
---

// Splunk compares only integers as Tenzir does. The `where` stage also keeps
// the events that pass only if Splunk compared another value that may be a
// number, such as `7.5`, as Tenzir does, and the check flags them. A flagged
// group makes the operator send the search again with the same `where` stage
// instead of the summary, and summarize the events in Tenzir. A `search n>6`
// prefilter would drop values such as `1e999`, which Tenzir reads as infinity.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/aggregate-flagged",
  search="search index=main", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false
where n > 6
summarize user, events=count()
sort user
