---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/strings/services/search/v2/jobs/export
      body: search=search%20index%3Dmain%0A%7C%20search%20n%3E6%20user%3D%22A%2A%22%0A%7C%20fields%20n%2C%20user&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// The filter and the projection become trailing stages. The fixture ignores
// the search, so the output shows that the operator still filters locally.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/strings",
  search="search index=main", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false
where n > 6 and user.starts_with("A")
select user, n
