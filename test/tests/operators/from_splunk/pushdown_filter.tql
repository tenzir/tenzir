---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/strings/services/search/v2/jobs/export
      body: search=search%20index%3Dmain%0A%7C%20where%20%28%27n%27%20%3E%206%29%0A%7C%20where%20%28substr%28%27user%27%2C%201%2C%20len%28%22A%22%29%29%3D%3D%22A%22%29%0A%7C%20fields%20user%2C%20n&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// Filters after a user's search become `where` stages, and the selection a
// `fields` stage. The fixture ignores the search, so the output shows every
// result, with the selected fields.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/strings",
  search="search index=main", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false
where n > 6 and user.starts_with("A")
select user, n
