---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/strings/services/search/v2/jobs/export
      body: search=search%20index%3Dmain%0A%7C%20fields%20%2A&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// Predicates without an SPL spelling stay local. `fields *` makes Splunk
// return every field, also those that only local predicates read.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/strings",
  search="search index=main", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false
where user.match_regex("^[ab]") or n == 7
