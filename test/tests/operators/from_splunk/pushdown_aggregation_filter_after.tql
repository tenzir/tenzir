---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/aggregate-ok/services/search/v2/jobs/export
      body: search=search%20index%3D%22main%22%0A%7C%20stats%20count%20as%20tenzir_column_0%2C%20count%28action%29%20as%20tenzir_column_1%2C%20min%28n%29%20as%20tenzir_column_2%2C%20max%28n%29%20as%20tenzir_column_3%20by%20user%0A%7C%20where%20%28%27tenzir_column_0%27%20%3E%201%29%0A%7C%20sort%205%20-tenzir_column_0%0A%7C%20head%205%0A%7C%20appendpipe%20%5Bstats%20count%20as%20tenzir_groups_0%5D&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// Filters, sorts, and limits after the summary read its columns. The row that
// counts the groups follows the whole search.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/aggregate-ok",
  index="main", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false
summarize user, events=count(), actions=count(action), lo=min(n), hi=max(n)
where events > 1
sort -events
head 5
