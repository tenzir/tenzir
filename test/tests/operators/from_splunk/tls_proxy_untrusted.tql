---
fixtures:
  - http_connect_proxy:
      default_port: true
      proxy_tls: true
      proxy_auth: false
error: true
timeout: 60
---

// Without proxy credentials, the client pools CONNECT tunnels through the
// HTTPS proxy, whose certificate the client does not trust.
from_splunk env("HTTP_PROXY_FIXTURE_URL"),
  search="fixture",
  earliest="-15m",
  latest="-5m",
  headers={Authorization: "Splunk test-token"},
  tls={cacert: env("HTTP_PROXY_FIXTURE_CAFILE")},
  max_retry_count=0
