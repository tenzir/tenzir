---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/strings/services/search/v2/jobs/export
      body: search=search%20index%3D%22main%22%0A%7C%20fields%20user%2C%20n&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// A selection keeps the fields with `fields`. Renames, duplicates, and nested
// outputs only change how the results become events.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/strings",
  index="main", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false
select name=user, n, copy=user, nested.n=n
