// A limit keeps the summary in Tenzir, which counts the empty objects that
// Splunk returns for results whose fields `eval` set to `null()`. `?` only
// silences warnings about missing fields.
from_splunk env("SPLUNK_MGMT_URL"),
  search=r#"| makeresults count=2 | eval x=1 | eval x=null(), _time=null()"#,
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true}
head 1000000000
summarize events=count(), present=count(x?)
