// Filters, sorts, and limits after a summary run in Splunk on its columns.
from_splunk env("SPLUNK_MGMT_URL"),
  index="main",
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true}
where source == "tenzir-docs-auth"
summarize user, events=count(), first=min(_time)
where events > 1 or user == "bob"
sort -events, user
head 1
