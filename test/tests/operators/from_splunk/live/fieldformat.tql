// The results show the values that `fieldformat` formats, which a `search`
// stage does not see, so the filter stays in Tenzir.
from_splunk env("SPLUNK_MGMT_URL"),
  search=r#"| makeresults | eval k=7 | fieldformat k=k*2"#,
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true}
where k > 10
select k
