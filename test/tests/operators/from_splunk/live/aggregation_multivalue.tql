// Splunk would put a result with several values into the group of each value,
// where Tenzir groups by the list. The operator then summarizes the results of
// the search in Tenzir.
from_splunk env("SPLUNK_MGMT_URL"),
  search=r#"| makeresults count=4 | streamstats count as i | eval k=if(i==1, mvappend("a", "b"), "a")"#,
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true}
summarize k, events=count(), present=count(k)
sort events
