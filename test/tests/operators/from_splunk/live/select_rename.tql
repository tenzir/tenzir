// Renames, duplicates, and nested outputs of a selection only change how the
// results become events.
from_splunk env("SPLUNK_MGMT_URL"),
  index="main",
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true}
where source == "tenzir-docs-auth"
sort _time
select who=user, copy=user, net.src=src_ip
