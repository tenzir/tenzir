// A search as typed in Splunk Web, without a `fields` command, returns all
// extracted fields, such as `user` and `outcome`, not only the defaults.
from_splunk env("SPLUNK_MGMT_URL"),
  search=r#"index=main source="tenzir-docs-auth""#,
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true}
head 1
this = {fields: this.keys().sort()}
