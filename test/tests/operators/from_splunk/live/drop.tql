// A drop removes fields with `fields -`.
from_splunk env("SPLUNK_MGMT_URL"),
  index="main",
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true}
where source == "tenzir-docs-auth" and user == "bob"
drop _raw, _bkt, _cd, _indextime, _serial, _si, _sourcetype, punct, splunk_server, linecount, index
