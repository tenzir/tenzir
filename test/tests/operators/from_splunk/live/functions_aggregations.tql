// Splunk computes the deviation and the variance.
from_splunk env("SPLUNK_MGMT_URL"),
  index="main",
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true}
length = user.length_chars()
summarize deviation=stddev(length), variance=variance(length)
