// With `index`, Splunk computes the summary in `stats` stages after the search
// for the index.
from_splunk env("SPLUNK_MGMT_URL"),
  index="main",
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true}
summarize source, user, events=count(), outcomes=count(outcome)
sort source, user
