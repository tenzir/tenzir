// With `pushdown=false`, Tenzir computes the stages of `aggregation` from the
// results of the search, with the semantics of TQL. `?` only silences warnings
// about missing fields.
from_splunk env("SPLUNK_MGMT_URL"),
  index="main",
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true},
  pushdown=false
summarize source=source?, user=user?, events=count(), outcomes=count(outcome?)
sort source, user
