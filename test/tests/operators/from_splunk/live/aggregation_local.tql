// A limit keeps the summary in Tenzir, which computes the same events from the
// results of the search as Splunk. `?` only silences warnings about missing
// fields.
from_splunk env("SPLUNK_MGMT_URL"),
  index="main",
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true}
head 1000000000
summarize source=source?, user=user?, events=count(), outcomes=count(outcome?)
sort source, user
