// Splunk computes the value that the summary groups by with `eval`, with the
// result of the same operators in the pipeline.
from_splunk env("SPLUNK_MGMT_URL"),
  index="main",
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true}
kind = action.to_upper()
summarize kind, events=count()
sort kind
