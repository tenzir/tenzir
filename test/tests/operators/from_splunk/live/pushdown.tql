// With `index`, Tenzir writes the search and adds the prefilters to it.
// Without a `select`, every result still carries all of its fields.
from_splunk env("SPLUNK_MGMT_URL"),
  index="main",
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true}
where source == "tenzir-docs-auth" and action == "login"
where outcome.starts_with("fail")
select _time, user, action, src_ip, outcome
