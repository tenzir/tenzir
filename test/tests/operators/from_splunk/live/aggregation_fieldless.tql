// `stats` runs in Splunk, which counts results without fields that its export
// endpoint would not return.
from_splunk env("SPLUNK_MGMT_URL"),
  search=r#"| makeresults count=2 | fields - _time"#,
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true}
summarize events=count()
