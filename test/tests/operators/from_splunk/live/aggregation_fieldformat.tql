// The results show the values that `fieldformat` formats, which `stats` does
// not see, so the summary stays in Tenzir.
from_splunk env("SPLUNK_MGMT_URL"),
  search=r#"| makeresults count=2 | eval k="alice", n=7 | fieldformat k=upper(k) | fieldformat n=n*2"#,
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true}
summarize k, events=count(), lo=min(n), hi=max(n)
