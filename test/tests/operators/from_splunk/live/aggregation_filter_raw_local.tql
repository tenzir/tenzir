// With `pushdown=false`, Tenzir computes the stages of `aggregation_filter_raw`
// from the results of the search, with the semantics of TQL. `?` only silences
// warnings about missing fields.
from_splunk env("SPLUNK_MGMT_URL"),
  search=r#"| makeresults count=6 | streamstats count as i | eval s=case(i==1, "5", i==2, "005", i==3, "true", i==4, "True", i==5, "5.0"), k=if(i%2==0, "even", "odd")"#,
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true},
  raw=true,
  pushdown=false
where s? in ["5", "true"] or s? == null
summarize k, events=count()
sort k
