// The results show the values that `fieldformat` formats, which the `where`
// stage of a negation does not see, so the negation stays in Tenzir.
from_splunk env("SPLUNK_MGMT_URL"),
  search=r#"| makeresults | eval k="a" | fieldformat k=upper(k)"#,
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true}
where k != "a"
select k
