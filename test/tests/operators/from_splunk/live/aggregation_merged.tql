// Splunk groups `5`, `005`, and `5.0` apart, which type inference then decodes
// as equal or similar numbers.
from_splunk env("SPLUNK_MGMT_URL"),
  search=r#"| makeresults count=6 | streamstats count as i | eval k=case(i<=2, "5", i==3, "005", i==4, "5.0", i==5, "five")"#,
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true}
summarize k, events=count()
sort k
