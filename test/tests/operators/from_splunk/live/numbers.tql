// Splunk returns numbers as strings. The operator infers them, and numeric
// comparisons run in Splunk as well.
from_splunk env("SPLUNK_MGMT_URL"),
  search=r#"search index=main source="tenzir-docs-auth" | eval length=len(user), success=if(outcome="success", "true", "false")"#,
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true}
where length > 3 and success
select _time, user, length, success
sort _time
