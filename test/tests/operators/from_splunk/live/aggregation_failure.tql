---
error: true
---

// A search that fails in `eval` returns no results and no error. The missing
// row that counts the groups makes the operator fail.
from_splunk env("SPLUNK_MGMT_URL"),
  search=r#"| makeresults count=2 | eval x=tonumber("a", 99)"#,
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true}
summarize x, events=count()
