// With `pushdown=false`, Tenzir computes the stages of `aggregation_empty` from
// the results of the search, with the semantics of TQL. `?` only silences
// warnings about missing fields.
from_splunk env("SPLUNK_MGMT_URL"),
  search=r#"| makeresults count=3 | where i > 5"#,
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true},
  pushdown=false
summarize events=count(), present=count(k?), lo=min(n?)
