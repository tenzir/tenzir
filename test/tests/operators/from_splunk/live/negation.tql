// Equality and networks extend the base search, and negations become `where`
// stages, which drop results without the field.
from_splunk env("SPLUNK_MGMT_URL"),
  index="main",
  earliest="1735689599",
  latest="1735689780",
  headers={
    Authorization: env("SPLUNK_AUTHORIZATION"),
  },
  tls={skip_peer_verification: true}
where source == "tenzir-docs-auth" and user != "alice"
where src_ip in 198.51.100.0/24 and outcome != "success"
select _time, user, src_ip, outcome
