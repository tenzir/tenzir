---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/strings/services/search/v2/jobs/export
      body: search=search%20index%3Dmain%20%7C%20fieldformat%20n%3Dn%2A2%0A%7C%20fields%20n%2C%20user&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// After `fieldformat`, the results show the formatted values, but a `search`
// stage would compare the original ones. The filter therefore stays local,
// while the projection still applies.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/strings",
  search="search index=main | fieldformat n=n*2", earliest="-15m",
  latest="-5m", headers={Authorization: "Splunk test-token"}, tls=false
where n > 6
select user, n
