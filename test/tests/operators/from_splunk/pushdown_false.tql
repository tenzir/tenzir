---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/strings/services/search/v2/jobs/export
      body: search=search%20index%3D%22main%22%0A%7C%20fields%20n%2C%20user&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// With `pushdown=false`, the stages run in Tenzir with TQL's semantics, and the
// search only keeps the fields that they need.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/strings",
  index="main", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false, pushdown=false
where user == "alice"
select user, n
head 1
