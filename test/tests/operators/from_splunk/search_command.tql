---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/strings/services/search/v2/jobs/export
      body: search=search%20index%3Dmain%20sourcetype%3Dlinux_secure%0A%7C%20fields%20user&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// A search copied from Splunk Web gets the `search` command.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/strings",
  search="index=main sourcetype=linux_secure", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false
select user
