---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/strings/services/search/v2/jobs/export
      body: search=search%20index%3Dmain%0A%7C%20fields%20user%0A%7C%20head%202&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// Without a filter, the limit becomes a `head` stage.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/strings",
  search="search index=main", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false
head 2
select user
