---
fixtures:
- http_server:
    expected:
    - method: POST
      path: /splunk/strings/services/search/v2/jobs/export
      body: search=search%20index%3D%22main%22%0A%7C%20fields%20-%20flag%2C%20src_ip%0A%7C%20fields%20%2A&earliest_time=-15m&latest_time=-5m&output_mode=json&preview=false
---

// A drop removes fields with `fields -`.
from_splunk env("HTTP_FIXTURE_URL") + "/splunk/strings",
  index="main", earliest="-15m", latest="-5m",
  headers={Authorization: "Splunk test-token"}, tls=false
drop flag, this["src_ip"]
