---
fixtures: [node, loki_push_mock]
timeout: 60
assertions:
  fixtures:
    loki_push_mock:
      requests:
        secrets.tql:
          - path: /custom/push
            content_type: application/x-protobuf
            content_encoding: null
            tenant: null
            headers:
              Authorization: Bearer super-secret-loki-token
            streams:
              - labels: '{app="auth"}'
                entries:
                  - timestamp_ns: 1778839200000000000
                    line: authenticated push
---

from {
  labels: {app: "auth"},
  line: "authenticated push",
  timestamp: 2026-05-15T10:00:00Z,
}
to_loki env("LOKI_BASE_URL") + secret("loki-path"),
        headers={
          Authorization: "Bearer " + secret("loki-token"),
        },
        flush_interval=10s,
        max_batch_size=100,
        parallel=1
