---
fixtures: [node, loki_push_mock]
error: true
timeout: 60
assertions:
  fixtures:
    loki_push_mock:
      requests:
        secrets_echoed_error.tql:
          - path: /bad-request/loki/api/v1/push
            status: 400
---

from {
  labels: {app: "auth"},
  line: "triggers echoed 400",
  timestamp: 2026-05-15T10:00:00Z,
}
to_loki env("LOKI_BAD_REQUEST_URL"),
        headers={
          Authorization: "Bearer " + secret("loki-token"),
        },
        max_retry_count=0
