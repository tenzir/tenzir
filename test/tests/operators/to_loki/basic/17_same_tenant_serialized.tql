from {
  org: "tenant-a",
  labels: {app: "ordered"},
  line: "batch-1",
  timestamp: 2026-05-15T10:00:00Z,
}, {
  org: "tenant-a",
  labels: {app: "ordered"},
  line: "batch-2",
  timestamp: 2026-05-15T10:00:01Z,
}
