---
error: true
---

from {
  labels: {app: "reject"},
  line: "too old",
  timestamp: 2026-05-15T10:00:00Z,
}
to_loki env("LOKI_BAD_REQUEST_URL"),
        headers={
          Authorization: "Bearer canary-secret-token",
          "X-Scope-OrgID": "canary-tenant",
        },
        max_retry_count=3,
        retry_delay=0s,
        flush_interval=10s,
        max_batch_size=100,
        parallel=1
