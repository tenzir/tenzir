// JSON messages keep the same event name as the standalone JSON reader.
from_kafka env("KAFKA_TOPIC"),
           _json=true,
           count=1,
           offset="beginning",
           options={
             "bootstrap.servers": env("KAFKA_BOOTSTRAP_SERVERS"),
             "group.id": "tenzir-test-from-kafka-json-schema-name"
           }
select schema=@name
