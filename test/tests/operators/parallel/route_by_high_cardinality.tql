// Build 25 distinct keys and replay them, so that no two adjacent rows share a
// key and the hash exchange cannot fall back to routing contiguous runs. Every
// row of a group must still reach the same worker, or the counts below would be
// split across workers.
from {x: 1}
repeat 25
enumerate n
key = "key-" + n.string()
repeat 4
parallel 4, route_by=key {
  summarize key, count=count()
}
sort key
head 5
