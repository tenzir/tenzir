// Test ocsf_derive with null-vs-empty DNS answer flag_ids/flags lists.
// Different outer list validity is an inconsistent layout for the affected pair.

from {
  metadata: {
    version: "1.5.0",
  },
  class_uid: 4003,  // DNS Activity
  activity_id: 2,   // Response
  answers: [
    {
      rdata: "192.168.1.1",
      flag_ids: null,
      flags: [],
      ttl: 300,
    },
    {
      rdata: "192.168.1.2",
      flag_ids: [],
      flags: null,
      ttl: 600,
    },
    {
      rdata: "192.168.1.3",
      flag_ids: [1],
      flags: [null],
      ttl: 900,
    },
  ],
}
ocsf_derive
