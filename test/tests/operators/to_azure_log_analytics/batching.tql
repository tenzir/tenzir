---
fixtures:
  - azure_log_analytics:
      case: ingestion
assertions:
  fixtures:
    azure_log_analytics:
      queries: 0
      tokens: 1
      ingestions: 3
      large_event_ids: [1, 2, 3]
---
from {id: 1}, {id: 2}, {id: 3}
message = "x".repeat(600000)
to_azure_log_analytics tenant_id="fixture-tenant",
  client_id="fixture-client", client_secret="fixture-secret",
  dce=env("AZLOG_URL"), dcr="fixture-rule", stream="fixture-stream",
  _token_url=env("AZLOG_URL") + "/fixture-tenant/oauth2/v2.0/token",
  parallel=2
