// `TOP` takes a `bigint`, so a limit beyond it stays with the operator instead
// of failing the query.
from_microsoft_sql table="users",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_USER"),
                   password=env("MSSQL_PASSWORD"),
                   database=env("MSSQL_DATABASE")
where age > 0
head 18446744073709551615
select name
