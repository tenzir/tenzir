// SQL Server computes the functions of strings, numbers, and times, as group
// keys of the summary.
from_microsoft_sql table="fns",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_ADMIN_USER"),
                   password=env("MSSQL_ADMIN_PASSWORD"),
                   database=env("MSSQL_DATABASE")
ceil = f.ceil()
floor = f.floor()
round = f.round()
sqrt = f.abs().sqrt()
exp = f.exp()
log = f.abs().log()
log10 = log(f.abs(), 10)
year = ts.year()
month = ts.month()
day = ts.day()
hour = ts.hour()
minute = ts.minute()
second = ts.second()
bytes = s.length_bytes()
capitalize = s.capitalize()
trim_start = s.trim_start()
trim_end = s.trim_end()
replace = s.replace("l", "L")
empty = s.is_empty()
head = s.slice(end=3)
tail = s.slice(begin=3)
middle = s.slice(begin=1, end=4)
md5 = s.hash_md5()
sha1 = s.hash_sha1()
sha256 = s.hash_sha256()
summarize id, ceil, floor, round, sqrt, exp, log, log10, year, month, day, hour, minute, second, bytes, capitalize, trim_start, trim_end, replace, empty, head, tail, middle, md5, sha1, sha256
sort id
