// Character counts and affixes keep the full length of a bounded text column
// and its trailing spaces.
from_microsoft_sql table="bounded",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_USER"),
                   password=env("MSSQL_PASSWORD"),
                   database=env("MSSQL_DATABASE")
where n.length_chars() == 4000 or (n.starts_with(n) and n.length_chars() == 2)
select id
