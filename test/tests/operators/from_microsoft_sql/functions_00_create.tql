// Creates the table of the function tests.
from_microsoft_sql sql="CREATE TABLE fns (id INT, f FLOAT, s NVARCHAR(20), ts DATETIME2(7), b BIT)",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_ADMIN_USER"),
                   password=env("MSSQL_ADMIN_PASSWORD"),
                   database=env("MSSQL_DATABASE")
