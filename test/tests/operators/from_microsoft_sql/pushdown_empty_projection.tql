// Downstream needs no column of the table, but it still needs every row.
from_microsoft_sql table="users",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_USER"),
                   password=env("MSSQL_PASSWORD"),
                   database=env("MSSQL_DATABASE")
where age > 20
select missing?
