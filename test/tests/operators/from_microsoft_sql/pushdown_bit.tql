// A `bit` column is a predicate of its own.
from_microsoft_sql table="users",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_USER"),
                   password=env("MSSQL_PASSWORD"),
                   database=env("MSSQL_DATABASE")
where not is_active or age < 26
select name, is_active
