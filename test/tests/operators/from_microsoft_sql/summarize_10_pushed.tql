// SQL Server filters, groups, and aggregates the rows: the `where` and the
// `summarize` go into the query. Text groups under the collation of its column,
// so `a`, `A`, and `a ` form one group, unlike in `summarize_11_local.tql`,
// which aggregates the same rows in the pipeline.
// A sort by a computed key stays in Tenzir.
from_microsoft_sql table="agg",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_USER"),
                   password=env("MSSQL_PASSWORD"),
                   database=env("MSSQL_DATABASE")
where id > 1 or n == null
summarize s, rows=count(), values=count(n), lo=min(n), hi.ts=max(ts)
sort s.string()
