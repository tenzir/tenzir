// SQL Server buckets times by multiples of a day since the epoch, in UTC, as
// the same operators do in the pipeline. Its sort puts `null` first.
from_microsoft_sql table="agg",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_USER"),
                   password=env("MSSQL_PASSWORD"),
                   database=env("MSSQL_DATABASE")
day = floor(ts, 1d)
summarize day, rows=count()
sort day
