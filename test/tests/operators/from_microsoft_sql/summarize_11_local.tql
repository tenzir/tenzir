// A predicate that SQL Server cannot spell keeps the summary in the pipeline,
// which groups text by its bytes, unlike `summarize_10_pushed.tql`.
from_microsoft_sql table="agg",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_USER"),
                   password=env("MSSQL_PASSWORD"),
                   database=env("MSSQL_DATABASE")
where id > 1 or n == null
where id.string() != ""
summarize s, rows=count(), values=count(n), lo=min(n), hi.ts=max(ts)
sort s
