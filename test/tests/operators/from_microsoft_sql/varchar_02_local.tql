// With `pushdown=false`, Tenzir computes the functions of the decoded
// `varchar` text, like SQL Server in `varchar_01_pushed.tql`.
from_microsoft_sql table="varchars", pushdown=false,
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_USER"),
                   password=env("MSSQL_PASSWORD"),
                   database=env("MSSQL_DATABASE")
upper = s.to_upper()
length = m.length_chars()
summarize s, upper, m, length, j, u
