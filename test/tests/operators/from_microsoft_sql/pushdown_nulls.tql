// SQL Server compares `NULL` with anything as unknown, so the row where `email`
// is null does not pass `!=`, unlike in TQL.
from_microsoft_sql table="users",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_USER"),
                   password=env("MSSQL_PASSWORD"),
                   database=env("MSSQL_DATABASE")
where email != "alice@example.com"
select name, email
