// The source sorts with its own placement of `null`, which decides whether the
// group without a maximum makes the cut. The `sort` after the `head` orders the
// result in Tenzir.
from_microsoft_sql table="hits",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_USER"),
                   password=env("MSSQL_PASSWORD"),
                   database=env("MSSQL_DATABASE")
summarize src, hi=max(sev)
sort hi
head 5
sort hi, src
