// A user-provided query stays as it is; the operator applies the filter and the
// limit itself.
from_microsoft_sql sql="SELECT * FROM users ORDER BY id DESC",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_USER"),
                   password=env("MSSQL_PASSWORD"),
                   database=env("MSSQL_DATABASE")
where age < 35
head 1
select name
