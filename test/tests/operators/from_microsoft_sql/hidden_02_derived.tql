// The filter after the limit reads a hidden column through a derived table,
// which keeps a column hidden that it selects as it is.
from_microsoft_sql table="hidden",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_USER"),
                   password=env("MSSQL_PASSWORD"),
                   database=env("MSSQL_DATABASE")
sort id
head 3
where valid_from > 2000-01-01
select id
