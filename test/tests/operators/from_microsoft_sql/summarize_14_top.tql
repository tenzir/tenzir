// `top` counts the values in the query, which groups text under the collation
// of its column, and sorts the counts in the pipeline.
from_microsoft_sql table="agg",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_USER"),
                   password=env("MSSQL_PASSWORD"),
                   database=env("MSSQL_DATABASE")
top s
sort -count, s.string()
