// `top` counts the values in the query, and sorts the counts locally.
from_microsoft_sql table="agg",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_USER"),
                   password=env("MSSQL_PASSWORD"),
                   database=env("MSSQL_DATABASE")
top s
sort -count, s
