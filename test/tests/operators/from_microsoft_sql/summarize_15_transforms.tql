// SQL Server computes the summary behind a rename, a `drop`, and an
// assignment that copies a field: the `where` and the `summarize` go into
// the query over the table's columns, and the outputs keep the new names. The
// result equals that of `summarize_16_transforms_local.tql`, which runs the
// same operators locally.
from_microsoft_sql table="agg",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_USER"),
                   password=env("MSSQL_PASSWORD"),
                   database=env("MSSQL_DATABASE")
select key=s, ident=id, value=n, when=ts, junk=f
drop junk
where ident > 1 or value == null
stamp = when
summarize key, rows=count(), latest.ts=max(stamp), lo=min(value)
sort key
