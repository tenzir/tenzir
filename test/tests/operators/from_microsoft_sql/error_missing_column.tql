---
error: true
---

// The query takes the filter before the operator knows the columns of the
// table, and SQL Server rejects the column that the table lacks, so the query
// fails. `pushdown=false` keeps the filter in Tenzir.
from_microsoft_sql table="dbo.users",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_USER"),
                   password=env("MSSQL_PASSWORD"),
                   database=env("MSSQL_DATABASE")
where missing == 1
