// Creates a table with a bounded text column.
from_microsoft_sql sql="CREATE TABLE bounded (id INT, n NVARCHAR(4000)); INSERT INTO bounded VALUES (1, REPLICATE(N'x', 4000)), (2, N'x ')",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_ADMIN_USER"),
                   password=env("MSSQL_ADMIN_PASSWORD"),
                   database=env("MSSQL_DATABASE")
