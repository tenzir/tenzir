// With `pushdown=false`, the filter runs in Tenzir with TQL semantics: text
// compares by its bytes, so `alice` matches no row, unlike in
// `pushdown_filter_select_head.tql`.
from_microsoft_sql table="dbo.users", pushdown=false,
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_USER"),
                   password=env("MSSQL_PASSWORD"),
                   database=env("MSSQL_DATABASE")
where name == "alice"
select name
