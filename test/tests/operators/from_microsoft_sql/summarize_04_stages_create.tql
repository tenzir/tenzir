// Creates the table of the tests of the stages after a summary.
from_microsoft_sql sql="CREATE TABLE hits (src NVARCHAR(20), sev BIGINT)",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_ADMIN_USER"),
                   password=env("MSSQL_ADMIN_PASSWORD"),
                   database=env("MSSQL_DATABASE")
