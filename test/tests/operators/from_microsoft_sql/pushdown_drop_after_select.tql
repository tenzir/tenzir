// A `drop` after a `select` knows the columns that it keeps, so the query
// selects them.
from_microsoft_sql table="dbo.users",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_USER"),
                   password=env("MSSQL_PASSWORD"),
                   database=env("MSSQL_DATABASE")
select id, name, age
drop age
where id <= 2
