// Sort keys that differ only in case may name the same column, which SQL
// Server rejects twice, so the sort stays in Tenzir.
from_microsoft_sql table="dbo.users",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_USER"),
                   password=env("MSSQL_PASSWORD"),
                   database=env("MSSQL_DATABASE")
sort -age, AGE
head 2
select name
