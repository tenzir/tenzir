// Creates a temporal table, whose period columns `SELECT *` leaves out.
from_microsoft_sql sql="CREATE TABLE hidden (id INT PRIMARY KEY, valid_from DATETIME2 GENERATED ALWAYS AS ROW START HIDDEN NOT NULL, valid_to DATETIME2 GENERATED ALWAYS AS ROW END HIDDEN NOT NULL, PERIOD FOR SYSTEM_TIME (valid_from, valid_to))",
                   host=env("MSSQL_HOST"),
                   port=int(env("MSSQL_PORT")),
                   user=env("MSSQL_ADMIN_USER"),
                   password=env("MSSQL_ADMIN_PASSWORD"),
                   database=env("MSSQL_DATABASE")
