// Lists and records compare deeply by value, and ints compare equal to uints
// and floats of the same value.
from {
  lists: [1, [2, {x: 3}]] == [1, [2, {x: 3}]],
  lists_differ: [1, 2] != [1, 3],
  records: {a: 1, b: [2]} == {a: 1, b: [2]},
  records_differ: {a: 1} == {a: 2},
  mixed_numbers: {a: 1} == {a: 1.0},
}
