# shellcheck shell=bash

# The explicit full-stack shell already includes this project's environment.
if [[ ${TENZIR_FULL_STACK_ROOT:-} != "$(cd .. && pwd -P)" ]]; then
  source_env scripts/direnv-inputs.sh
  if [[ -n ${TENZIR_DIRENV_CUSTOM:-} ]]; then
    source_env "$TENZIR_DIRENV_CUSTOM"
  else
    use flake .
  fi
fi

# Personal, gitignored overrides.
if [[ -f .envrc.local ]]; then
  source_env .envrc.local
fi

source_env scripts/direnv-build.sh
