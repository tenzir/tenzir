# shellcheck shell=bash

# The explicit full-stack shell already includes this project's environment.
if [[ ${TENZIR_FULL_STACK_ROOT:-} != "$(cd .. && pwd -P)" ]]; then
  watch_file shell.nix
  watch_file nix/overlay.nix
  watch_file nix/dependencies.nix
  watch_file nix/test-dependencies.nix
  watch_file nix/python-dependencies.nix
  watch_file nix/overrides/*
  watch_file nix/caf/
  use flake .
fi

# Personal, gitignored overrides.
if [[ -f .envrc.local ]]; then
  source_env .envrc.local
fi
