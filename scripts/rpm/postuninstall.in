# Whether this package ships `tenzir-node.service`, which only packages before
# v7 do.
node_service=@TENZIR_INSTALL_NODE@

if [ $1 -ge 1 ]; then
  # Package upgrade, not uninstall
  if [ "$node_service" = ON ]; then
    if [ -x "/usr/lib/systemd/systemd-update-helper" ]; then
      /usr/lib/systemd/systemd-update-helper mark-restart-system-units tenzir-node.service || :
    else
      systemctl try-restart tenzir-node.service >/dev/null 2>&1 || :
    fi
  fi
elif [ $1 -eq 0 ]; then
  # uninstall
  rm -f /etc/profile.d/tenzir.sh
fi
