Adds a public AzureOptions::ConfigureCredential() so callers can inject an
arbitrary Azure::Core::Credentials::TokenCredential. Upstream only exposes
nine fixed Configure* methods, none of which cover a caller-supplied client
assertion (Entra workload identity federation with a per-operator assertion
source). Patch is applied with the working directory at `cpp/`.

diff --git a/src/arrow/filesystem/azurefs.h b/src/arrow/filesystem/azurefs.h
--- a/src/arrow/filesystem/azurefs.h
+++ b/src/arrow/filesystem/azurefs.h
@@ -118,6 +118,7 @@
     kCLI,
     kWorkloadIdentity,
     kEnvironment,
+    kTokenCredential,
   } credential_kind_ = CredentialKind::kDefault;
 
   std::shared_ptr<Azure::Storage::StorageSharedKeyCredential>
@@ -200,6 +201,14 @@
   Status ConfigureWorkloadIdentityCredential();
   Status ConfigureEnvironmentCredential();
 
+  /// \brief Use a caller-provided Azure SDK token credential.
+  ///
+  /// This allows authentication schemes that the fixed Configure* methods above
+  /// do not cover, e.g. Azure::Identity::ClientAssertionCredential for
+  /// workload identity federation with a caller-supplied assertion source.
+  Status ConfigureCredential(
+      std::shared_ptr<Azure::Core::Credentials::TokenCredential> credential);
+
   bool Equals(const AzureOptions& other) const;
 
   std::string AccountBlobUrl(const std::string& account_name) const;
diff --git a/src/arrow/filesystem/azurefs.cc b/src/arrow/filesystem/azurefs.cc
--- a/src/arrow/filesystem/azurefs.cc
+++ b/src/arrow/filesystem/azurefs.cc
@@ -278,6 +278,10 @@
     case CredentialKind::kEnvironment:
       return token_credential_->GetCredentialName() ==
              other.token_credential_->GetCredentialName();
+    case CredentialKind::kTokenCredential:
+      // Two caller-provided credentials are only interchangeable if they are
+      // the very same object; the name is not a sufficient identity.
+      return token_credential_ == other.token_credential_;
   }
   DCHECK(false);
   return false;
@@ -411,6 +415,17 @@
   return Status::OK();
 }
 
+Status AzureOptions::ConfigureCredential(
+    std::shared_ptr<Azure::Core::Credentials::TokenCredential> credential) {
+  if (!credential) {
+    return Status::Invalid("AzureOptions::ConfigureCredential requires a credential");
+  }
+  ClearCredentials();
+  credential_kind_ = CredentialKind::kTokenCredential;
+  token_credential_ = std::move(credential);
+  return Status::OK();
+}
