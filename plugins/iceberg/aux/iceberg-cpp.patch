+
+Result<std::string> ArrowFileSystemFileIO::ResolveInputPath(
+    const std::string& file_location) {
+  ICEBERG_ASSIGN_OR_RAISE(auto literal, ResolvePath(file_location));
+  const auto pos = file_location.find("://");
+  if (pos == std::string::npos || literal.find('%') == std::string::npos) {
+    return literal;
+  }
+
+  // A writer that percent-decodes locations, as this function's predecessor
+  // did, stores a file whose location contains an escape under the decoded
+  // name. Compute that name.
+  std::string legacy;
+  if (auto path = arrow_fs_->PathFromUri(file_location); path.ok()) {
+    legacy = std::move(path).ValueOrDie();
+  } else {
+    std::string bucket_key = file_location.substr(pos + 3);
+    bucket_key = bucket_key.substr(0, bucket_key.find_first_of("?#"));
+    legacy = ::arrow::util::UriUnescape(bucket_key);
+  }
+  if (legacy == literal) {
+    return literal;
+  }
+
+  // Use the decoded name only on positive evidence: the filesystem reports
+  // that the literal name does not exist and that the decoded name is a file.
+  // Any failure to find that out, such as a permission or network error, keeps
+  // the literal name, so that opening it reports the actual error.
+  auto literal_info = arrow_fs_->GetFileInfo(literal);
+  if (!literal_info.ok() ||
+      literal_info.ValueUnsafe().type() != ::arrow::fs::FileType::NotFound) {
+    return literal;
+  }
+  auto legacy_info = arrow_fs_->GetFileInfo(legacy);
+  if (!legacy_info.ok() ||
+      legacy_info.ValueUnsafe().type() != ::arrow::fs::FileType::File) {
+    return literal;
+  }
+  return legacy;
 }
 
