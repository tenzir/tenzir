@@ -131,4 +131,15 @@ bool IsSuccessful(int32_t status_code) {
 /// \brief Builds a default ErrorResponse when the response body cannot be parsed.
 ErrorResponse BuildDefaultErrorResponse(const cpr::Response& response) {
+  if (response.status_code == 0) {
+    // No HTTP response arrived; carry the transport error so that handlers
+    // can distinguish "the request may have been applied" from an HTTP-level
+    // failure via the zero status code.
+    return {
+        .code = 0,
+        .type = std::string(kRestExceptionType),
+        .message = !response.error.message.empty() ? response.error.message
+                                                   : "connection failed",
+    };
+  }
   return {
       .code = static_cast<uint32_t>(response.status_code),
@@ -191,7 +202,14 @@ Result<HttpResponse> HttpClient::Post(
       AuthenticateRequest(session, HttpMethod::kPost, path,
                           MergeHeaders(default_headers_, headers), body));
-  cpr::Response response =
-      cpr::Post(cpr::Url{authenticated.url}, cpr::Body{authenticated.body},
-                ToCprHeader(authenticated), *connection_pool_);
+  // Deliberately no shared connection pool: when a reused keep-alive
+  // connection dies before a response arrives, libcurl transparently
+  // re-sends the request on a fresh connection. For a non-idempotent
+  // catalog mutation that re-send turns a lost response into a spurious
+  // conflict -- the first transmission may have been applied -- which
+  // callers then resolve destructively. On a fresh connection a lost
+  // response surfaces as a transport error instead.
+  cpr::Response response = cpr::Post(cpr::Url{authenticated.url},
+                                     cpr::Body{authenticated.body},
+                                     ToCprHeader(authenticated));
 
   ICEBERG_RETURN_UNEXPECTED(HandleFailureResponse(response, error_handler));
@@ -255,6 +273,8 @@ Result<HttpResponse> HttpClient::Delete(
       AuthenticateRequest(session, HttpMethod::kDelete, std::move(url),
                           MergeHeaders(default_headers_, headers)));
-  cpr::Response response = cpr::Delete(cpr::Url{authenticated.url},
-                                       ToCprHeader(authenticated), *connection_pool_);
+  // No shared connection pool; see Post for why mutations must not risk
+  // libcurl's transparent re-send on a dead reused connection.
+  cpr::Response response =
+      cpr::Delete(cpr::Url{authenticated.url}, ToCprHeader(authenticated));
 
   ICEBERG_RETURN_UNEXPECTED(HandleFailureResponse(response, error_handler));
