diff --git a/src/iceberg/catalog/rest/error_handlers.cc b/src/iceberg/catalog/rest/error_handlers.cc
index 78696a4..54b7e15 100644
--- a/src/iceberg/catalog/rest/error_handlers.cc
+++ b/src/iceberg/catalog/rest/error_handlers.cc
@@ -183,4 +183,10 @@ const std::shared_ptr<TableCommitErrorHandler>& TableCommitErrorHandler::Instanc
 Status TableCommitErrorHandler::Accept(const ErrorResponse& error) const {
   switch (error.code) {
+    case 0:
+      // No HTTP status line arrived: the connection failed or was closed
+      // before the server replied. The commit may have been applied, so the
+      // outcome is unknown; any other error kind makes the transaction clean
+      // up metadata files that a committed snapshot may reference.
+      return CommitStateUnknown("No response from server: {}", error.message);
     case 404:
       return NoSuchTable(error.message);
